# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET=ChangeMe

# Clés JWT jetables générées par tests/bootstrap.php (jamais committées).
JWT_SECRET_KEY=%kernel.project_dir%/var/jwt-test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/jwt-test/public.pem
JWT_PASSPHRASE=test-passphrase
MAILER_DSN=null://null
# Restriction de surface (PublicApiHostRestrictionSubscriber) active
# uniquement sur cet hôte fictif (P0 #4) : les autres tests (hôte localhost)
# ne sont pas concernés.
PUBLIC_API_HOSTS=api.test.invalid
