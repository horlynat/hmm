{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
	<twig:PageHeader title="Notifications" subtitle="Canaux activés par niveau d'importance des envois du back-office." icon="ti-bell" />

	<div class="text-xs opacity-90 bg-brand-light/30 p-3 rounded-lg flex items-center gap-2 text-(--brand-dark) border border-brand-light mb-6">
		<span class="ti ti-info-circle text-base shrink-0" aria-hidden="true"></span>
		<span>Canal push via <a href="https://ntfy.sh" target="_blank" rel="noopener noreferrer" class="underline font-bold">ntfy</a> — abonnez-vous au topic défini par <code class="font-mono">NTFY_DSN</code> (fichier .env) pour recevoir les alertes.</span>
	</div>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Préférences de notification par niveau</caption>
			<thead>
				<tr>
					<th scope="col">Niveau d'importance</th>
					<th scope="col" class="text-center">E-mail</th>
					<th scope="col" class="text-center">Push</th>
					<th scope="col" class="w-72 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for priority, preference in preferences %}
					<tr>
						<td class="font-medium text-(--brand-dark)">{{ preference.priority.label }}</td>
						<td class="text-center">
							{% if preference.emailEnabled %}<twig:Badge variant="success">Activé</twig:Badge>{% else %}<twig:Badge variant="neutral">Désactivé</twig:Badge>{% endif %}
						</td>
						<td class="text-center">
							{% if preference.pushEnabled %}<twig:Badge variant="success">Activé</twig:Badge>{% else %}<twig:Badge variant="neutral">Désactivé</twig:Badge>{% endif %}
						</td>
						<td>
							<div class="flex items-center justify-end gap-2">
								<form method="post" action="{{ path('admin_notification_toggle', {'priority': priority, 'channel': 'email'}) }}">
									<input type="hidden" name="_token" value="{{ csrf_token('admin_notification_toggle_' ~ priority ~ '_email') }}">
									<button type="submit" class="btn btn-secondary btn-sm">{{ preference.emailEnabled ? 'Désactiver e-mail' : 'Activer e-mail' }}</button>
								</form>
								<form method="post" action="{{ path('admin_notification_toggle', {'priority': priority, 'channel': 'push'}) }}">
									<input type="hidden" name="_token" value="{{ csrf_token('admin_notification_toggle_' ~ priority ~ '_push') }}">
									<button type="submit" class="btn btn-secondary btn-sm">{{ preference.pushEnabled ? 'Désactiver push' : 'Activer push' }}</button>
								</form>
							</div>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
