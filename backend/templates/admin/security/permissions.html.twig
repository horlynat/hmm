{# templates/admin/security/permissions.html.twig
   Édition du catalogue RBAC dynamique — cf. AdminSecurityPermissionController
   et le docblock de PermissionDefinition pour le périmètre exact. #}
{% extends 'base.html.twig' %}

{% block title %}Permissions dynamiques{% endblock %}

{% block body %}
	<div class="mb-6">
		<a href="{{ path('admin_security_role_index') }}" class="btn btn-secondary gap-2 px-3 py-2 text-sm w-fit">
			<span class="ti ti-arrow-left text-base" aria-hidden="true"></span>
			<span>Retour à la hiérarchie des rôles</span>
		</a>
	</div>

	<twig:PageHeader title="Permissions dynamiques" subtitle="Rôle minimum requis pour chaque action — modifiable ici sans déploiement de code." icon="ti-adjustments-alt" />

	<div class="panel mb-6 border-l-4 border-(--color-brand-primary)">
		<div class="panel-body flex items-start gap-3">
			<span class="ti ti-info-circle text-xl text-(--color-brand-primary) mt-0.5" aria-hidden="true"></span>
			<div class="text-sm opacity-80">
				<p class="mb-2">Ce catalogue couvre uniquement les permissions "métier" (Articles, Contacts, Formations, Devis, Compétences, Support, Témoignages, Dashboard, Finance) — des seuils de rôle purs, sans autre règle mêlée.</p>
				<p>Volontairement <strong>absentes</strong> : les permissions Sécurité/Paramètres (elles gouvernent le back-office lui-même) et celles de Project/Utilisateur (mêlées à des garde-fous critiques : auto-suppression, protection Super Admin, verrou d'état de projet). Ces permissions-là restent fixées dans le code, pour ne jamais pouvoir être affaiblies depuis cette interface.</p>
			</div>
		</div>
	</div>

	{% for group, definitions in grouped %}
		<div class="panel mb-6">
			<div class="panel-header"><h3 class="panel-title">{{ group }}</h3></div>
			<div class="table-wrap border-0">
				<table class="table">
					<caption class="sr-only">Permissions — {{ group }}</caption>
					<thead>
						<tr>
							<th scope="col">Permission</th>
							<th scope="col">Rôle minimum</th>
							<th scope="col" class="w-48 text-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for definition in definitions %}
							<tr>
								<td>
									<p class="font-medium text-(--color-brand-dark)">{{ definition.label }}</p>
									<p class="font-mono text-xs opacity-50">{{ definition.code }}</p>
								</td>
								<td>
									<form method="post" action="{{ path('admin_security_permission_update', {id: definition.id}) }}" class="flex items-center gap-2" onsubmit="return confirm('Changer le rôle minimum de « {{ definition.label }} » ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('admin_security_permission_update_' ~ definition.id) }}">
										<select name="role" class="input input-sm">
											{% for role in roles %}
												<option value="{{ role.code }}" {{ role.code == definition.currentRole.code ? 'selected' : '' }}>{{ role.label }}</option>
											{% endfor %}
										</select>
										<button type="submit" class="btn btn-secondary btn-sm">Appliquer</button>
										{% if definition.isOverridden %}<twig:Badge variant="warning">Modifiée</twig:Badge>{% endif %}
									</form>
								</td>
								<td class="text-right">
									{% if definition.isOverridden %}
										<form method="post" action="{{ path('admin_security_permission_reset', {id: definition.id}) }}" onsubmit="return confirm('Réinitialiser « {{ definition.label }} » à {{ definition.defaultRole.label }} (valeur d\'origine) ?');">
											<input type="hidden" name="_token" value="{{ csrf_token('admin_security_permission_reset_' ~ definition.id) }}">
											<button type="submit" class="btn btn-ghost btn-sm gap-1" title="Revenir à {{ definition.defaultRole.label }}">
												<span class="ti ti-restore text-sm" aria-hidden="true"></span> Réinitialiser
											</button>
										</form>
									{% else %}
										<span class="text-xs opacity-40">Valeur d'origine</span>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	{% else %}
		<twig:EmptyState text="Catalogue vide — lancer `php bin/console app:permissions:seed` pour l'initialiser." icon="ti-adjustments-alt" />
	{% endfor %}
{% endblock %}
