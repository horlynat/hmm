{% extends 'base.html.twig' %}

{% block title %}Logs de connexion{% endblock %}

{% macro sortLink(label, column, sort, direction, tab, search, from, to) %}
	{% set nextDirection = (sort == column and direction == 'asc') ? 'desc' : 'asc' %}
	<a href="{{ path('admin_security_log_index', {tab: tab, sort: column, direction: nextDirection, search: search, from: from, to: to}) }}" class="inline-flex items-center gap-1 hover:text-(--brand-primary)">
		{{ label }}
		{% if sort == column %}
			<span class="ti {{ direction == 'asc' ? 'ti-chevron-up' : 'ti-chevron-down' }} text-xs" aria-hidden="true"></span>
		{% endif %}
	</a>
{% endmacro %}
{% import _self as logs_macros %}

{% block body %}
	<twig:PageHeader title="Logs de connexion" subtitle="Historique des connexions réussies et des tentatives échouées." icon="ti-file-text">
		<a href="{{ path('admin_security_log_export', {tab: tab, search: search, from: from, to: to}) }}" class="btn btn-secondary gap-2">
			<span class="ti ti-download" aria-hidden="true"></span> Exporter (CSV)
		</a>
		{% if is_granted(constant('App\\Security\\Voter\\SecurityVoter::MANAGE_LOGS')) %}
			{% set purgeableTotal = purgeableLoginsCount + purgeableFailedCount %}
			<form method="post" action="{{ path('admin_security_log_purge') }}" onsubmit="return confirm('Purger {{ purgeableLoginsCount }} connexion(s) réussie(s) (> {{ loginRetentionDays }}j) et {{ purgeableFailedCount }} tentative(s) échouée(s) (> {{ failedRetentionDays }}j) ? Action irréversible.');">
				<input type="hidden" name="_token" value="{{ csrf_token('admin_security_log_purge') }}">
				<button type="submit" class="btn btn-secondary gap-2" {{ purgeableTotal == 0 ? 'disabled' : '' }} title="{{ purgeableTotal > 0 ? ('Purger ' ~ purgeableTotal ~ ' log(s) au-delà de la durée de rétention') : 'Rien à purger' }}">
					<span class="ti ti-eraser" aria-hidden="true"></span> Purger les anciens
					{% if purgeableTotal > 0 %}<span class="badge bg-warning text-white">{{ purgeableTotal }}</span>{% endif %}
				</button>
			</form>
		{% endif %}
	</twig:PageHeader>

	<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
		<div class="stat-tile">
			<div class="stat-tile__icon"><span class="ti ti-login" aria-hidden="true"></span></div>
			<div>
				<div class="stat-tile__value">{{ successCount24h }}</div>
				<div class="stat-tile__label">Connexions réussies (24h)</div>
			</div>
		</div>
		<div class="stat-tile">
			<div class="stat-tile__icon"><span class="ti ti-shield-x" aria-hidden="true"></span></div>
			<div>
				<div class="stat-tile__value {{ failedCount24h > 0 ? 'text-warning' : '' }}">{{ failedCount24h }}</div>
				<div class="stat-tile__label">Tentatives échouées (24h)</div>
			</div>
		</div>
		<div class="stat-tile">
			<div class="stat-tile__icon"><span class="ti ti-users" aria-hidden="true"></span></div>
			<div>
				<div class="stat-tile__value">{{ distinctUsers24h }}</div>
				<div class="stat-tile__label">Comptes distincts (24h)</div>
			</div>
		</div>
		<div class="stat-tile">
			<div class="stat-tile__icon"><span class="ti ti-alert-triangle" aria-hidden="true"></span></div>
			<div>
				<div class="stat-tile__value {{ suspiciousIpsCount > 0 ? 'text-danger' : '' }}">{{ suspiciousIpsCount }}</div>
				<div class="stat-tile__label">IPs suspectes ({{ suspiciousWindowHours }}h)</div>
			</div>
		</div>
	</div>

	<div class="flex items-center gap-2 mb-4">
		<a href="{{ path('admin_security_log_index', {tab: 'success', search: search, from: from, to: to}) }}" class="btn btn-sm {{ tab == 'success' ? 'btn-primary' : 'btn-secondary' }}">Connexions réussies</a>
		<a href="{{ path('admin_security_log_index', {tab: 'failed', search: search, from: from, to: to}) }}" class="btn btn-sm {{ tab == 'failed' ? 'btn-primary' : 'btn-secondary' }}">Tentatives échouées</a>
		{% if suspiciousIpsCount > 0 %}
			<a href="{{ path('admin_security_policy_index') }}" class="text-xs font-semibold text-danger hover:underline ml-2">
				Voir le rapport IPs suspectes →
			</a>
		{% endif %}
	</div>

	<form method="get" role="search" class="mb-4 flex flex-wrap items-end gap-2">
		<input type="hidden" name="tab" value="{{ tab }}">
		<div>
			<label for="log-search" class="sr-only">Rechercher par email ou IP</label>
			<input id="log-search" type="search" name="search" value="{{ search }}" placeholder="Rechercher par email ou IP…" class="input w-full max-w-xs">
		</div>
		<div>
			<label for="log-from" class="label block text-xs">Du</label>
			<input id="log-from" type="date" name="from" value="{{ from }}" class="input">
		</div>
		<div>
			<label for="log-to" class="label block text-xs">Au</label>
			<input id="log-to" type="date" name="to" value="{{ to }}" class="input">
		</div>
		<button type="submit" class="btn btn-secondary gap-2"><span class="ti ti-filter" aria-hidden="true"></span> Filtrer</button>
		{% if search or from or to %}
			<a href="{{ path('admin_security_log_index', {tab: tab}) }}" class="btn btn-ghost text-sm">Réinitialiser</a>
		{% endif %}
	</form>

	<div class="table-wrap">
		<table class="table">
			{% if tab == 'success' %}
				<caption class="sr-only">Connexions réussies</caption>
				<thead>
					<tr>
						<th scope="col">{{ logs_macros.sortLink('Compte', 'user', sort, direction, tab, search, from, to) }}</th>
						<th scope="col">{{ logs_macros.sortLink('IP', 'ip', sort, direction, tab, search, from, to) }}</th>
						<th scope="col">Appareil</th>
						<th scope="col">Localisation</th>
						<th scope="col">{{ logs_macros.sortLink('Date', 'loginAt', sort, direction, tab, search, from, to) }}</th>
						<th scope="col" class="w-40 text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for row in entries %}
						{% set entry = row.entry %}
						<tr>
							<td class="font-medium text-(--brand-dark)">
								{{ entry.user.fullName ?? entry.user.email }}
								{% if row.isSuspicious %}<span class="ti ti-alert-triangle text-danger ml-1" aria-hidden="true" title="IP suspecte : plusieurs échecs récents"></span>{% endif %}
							</td>
							<td class="font-mono text-xs">{{ entry.ip ?? '—' }}</td>
							<td class="text-sm opacity-70 truncate max-w-xs" title="{{ entry.device ?? '' }}">{{ row.device.label }}</td>
							<td class="text-sm opacity-70 whitespace-nowrap">{{ row.location ?? '—' }}</td>
							<td class="text-sm opacity-70 whitespace-nowrap">{{ entry.loginAt|date('d/m/Y H:i') }}</td>
							<td class="text-right">
								<div class="flex items-center justify-end gap-1">
									<a href="{{ path('admin_security_log_show_success', {id: entry.id}) }}" class="btn btn-ghost btn-icon" aria-label="Voir le détail" title="Voir le détail">
										<span class="ti ti-eye text-lg" aria-hidden="true"></span>
									</a>
									<a href="{{ path('admin_security_session_index', {search: entry.user.email}) }}" class="btn btn-ghost btn-icon" aria-label="Voir les sessions de {{ entry.user.email }}" title="Voir ses sessions">
										<span class="ti ti-devices text-lg" aria-hidden="true"></span>
									</a>
									{% include 'admin/security/_partials/_block_ip_button.html.twig' with {ip: entry.ip, isBlocked: row.isBlocked, autoReason: 'Depuis le journal des connexions.'} %}
								</div>
							</td>
						</tr>
					{% else %}
						<tr><td colspan="6"><twig:EmptyState text="Aucune connexion trouvée." icon="ti-login" /></td></tr>
					{% endfor %}
				</tbody>
			{% else %}
				<caption class="sr-only">Tentatives de connexion échouées</caption>
				<thead>
					<tr>
						<th scope="col">{{ logs_macros.sortLink('Email tenté', 'email', sort, direction, tab, search, from, to) }}</th>
						<th scope="col">Motif</th>
						<th scope="col">{{ logs_macros.sortLink('IP', 'ip', sort, direction, tab, search, from, to) }}</th>
						<th scope="col">Appareil</th>
						<th scope="col">{{ logs_macros.sortLink('Date', 'createdAt', sort, direction, tab, search, from, to) }}</th>
						<th scope="col" class="w-40 text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for row in entries %}
						{% set entry = row.entry %}
						<tr>
							<td class="font-medium text-(--brand-dark)">{{ entry.email }}</td>
							<td><twig:Badge variant="danger">{{ entry.reasonLabel }}</twig:Badge></td>
							<td class="font-mono text-xs">
								{{ entry.ip ?? '—' }}
								{% if row.isSuspicious %}<span class="ti ti-alert-triangle text-danger ml-1" aria-hidden="true" title="IP suspecte : plusieurs échecs récents"></span>{% endif %}
							</td>
							<td class="text-sm opacity-70 truncate max-w-xs" title="{{ entry.userAgent ?? '' }}">{{ row.device.label }}</td>
							<td class="text-sm opacity-70 whitespace-nowrap">{{ entry.createdAt|date('d/m/Y H:i') }}</td>
							<td class="text-right">
								<div class="flex items-center justify-end gap-1">
									<a href="{{ path('admin_security_log_show_failed', {id: entry.id}) }}" class="btn btn-ghost btn-icon" aria-label="Voir le détail" title="Voir le détail">
										<span class="ti ti-eye text-lg" aria-hidden="true"></span>
									</a>
									{% include 'admin/security/_partials/_block_ip_button.html.twig' with {ip: entry.ip, isBlocked: row.isBlocked, autoReason: entry.reasonLabel ~ ' — depuis le journal des connexions.'} %}
								</div>
							</td>
						</tr>
					{% else %}
						<tr><td colspan="6"><twig:EmptyState text="Aucune tentative échouée trouvée." icon="ti-shield-check" /></td></tr>
					{% endfor %}
				</tbody>
			{% endif %}
		</table>
	</div>

	{% if totalPages > 1 %}
		<div class="flex justify-center mt-6">
			<twig:Pagination :currentPage="page" :totalPages="totalPages" route="admin_security_log_index" :params="{tab: tab, search: search, from: from, to: to, sort: sort, direction: direction}" />
		</div>
	{% endif %}
{% endblock %}
