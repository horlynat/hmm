{# Partagé par logs.html.twig (deux onglets) — action rapide "Bloquer cette IP"
   sans quitter la page. La mutation elle-même reste dans
   AdminSecurityPolicyController::blockIp() (source unique du blocage, cf.
   son docblock) ; ce partial ne fait que poser le formulaire.
   Attend : `ip` (peut être null — IP jamais enregistrée, rien à bloquer),
   `isBlocked` (bool), `autoReason` (motif pré-rempli). #}
{% if ip is null %}
	<span class="text-xs opacity-40">—</span>
{% elseif isBlocked %}
	<twig:Badge variant="neutral">Bloquée</twig:Badge>
{% elseif is_granted(constant('App\\Security\\Voter\\SecurityVoter::MANAGE_IP_BLOCKS')) %}
	<form method="post" action="{{ path('admin_security_policy_block_ip') }}" onsubmit="return confirm('Bloquer {{ ip }} ? Plus aucune tentative de connexion ne sera acceptée depuis cette IP.');">
		<input type="hidden" name="_token" value="{{ csrf_token('admin_security_policy_block_ip') }}">
		<input type="hidden" name="ip" value="{{ ip }}">
		<input type="hidden" name="reason" value="{{ autoReason ?? 'Blocage rapide.' }}">
		<button type="submit" class="btn btn-ghost btn-icon text-danger" aria-label="Bloquer l'IP {{ ip }}" title="Bloquer cette IP">
			<span class="ti ti-ban text-lg" aria-hidden="true"></span>
		</button>
	</form>
{% endif %}
