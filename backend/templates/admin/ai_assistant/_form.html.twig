{# templates/admin/ai_assistant/_form.html.twig #}
<twig:LocaleToggle />

{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

<div class="card max-w-3xl space-y-5">
	<twig:FieldPair :fr="form.chipLabel" :en="form.chipLabelEn" />

	<twig:FieldPair :fr="form.keywords" :en="form.keywordsEn" :isTextarea="true" />

	<twig:FieldPair :fr="form.answer" :en="form.answerEn" :isTextarea="true" />

	<div class="max-w-[160px]">
		{{ form_label(form.sortOrder, null, {'label_attr': {'class': 'block text-sm font-bold mb-2 text-brand-dark'}}) }}
		{{ form_widget(form.sortOrder, {'attr': {'class': 'input w-full'}}) }}
		{{ form_errors(form.sortOrder, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
	</div>

	<div class="flex justify-end pt-4">
		<button type="submit" class="btn btn-primary gap-2">
			<span class="ti ti-device-floppy text-sm" aria-hidden="true"></span>
			<span>{{ button_label|default('Enregistrer') }}</span>
		</button>
	</div>
</div>

{{ form_end(form) }}
