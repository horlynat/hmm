{% extends 'base.html.twig' %}

{% block title %}Assistant IA — Réglages{% endblock %}

{% block body %}
	<twig:PageHeader title="Assistant IA — Réglages" subtitle="Message d'accueil et réponse par défaut du widget." icon="ti-message-chatbot">
		<a href="{{ path('admin_ai_assistant_index') }}" class="btn btn-secondary gap-2">
			<span class="ti ti-list" aria-hidden="true"></span>
			<span>Entrées de FAQ</span>
		</a>
	</twig:PageHeader>

	<twig:LocaleToggle />

	{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

	<div class="panel">
		<div class="panel-body space-y-4">
			<twig:FieldPair :fr="form.greeting" :en="form.greetingEn" :isTextarea="true" />
			<twig:FieldPair :fr="form.fallback" :en="form.fallbackEn" :isTextarea="true" />
		</div>
	</div>

	<div class="panel">
		<div class="panel-body">
			<label class="flex items-center gap-2">
				{{ form_widget(form.aiAssistantEnabled) }}
				<span>{{ form_label(form.aiAssistantEnabled, null, {label_attr: {class: ''}}) }}</span>
			</label>
			<p class="text-xs opacity-60 mt-1">{{ form.aiAssistantEnabled.vars.help }}</p>
			{{ form_errors(form.aiAssistantEnabled) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-body flex items-center justify-between gap-4">
			{% if settings.updatedAt %}
				<p class="text-xs opacity-60">
					Dernière mise à jour le {{ settings.updatedAt|date('d/m/Y à H:i') }}
					{% if settings.updatedBy %}par {{ settings.updatedBy.fullName ?? settings.updatedBy.email }}{% endif %}
				</p>
			{% else %}
				<span></span>
			{% endif %}
			<button type="submit" class="btn btn-primary gap-2">
				<span class="ti ti-device-floppy" aria-hidden="true"></span>
				<span>Enregistrer</span>
			</button>
		</div>
	</div>

	{{ form_end(form) }}
{% endblock %}
