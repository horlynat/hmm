{% extends 'base.html.twig' %}

{% block title %}Candidatures freelance{% endblock %}

{% block body %}
	<div class="page-header">
		<div class="min-w-0">
			<h1 class="page-title flex items-center gap-2">
				<span class="ti ti-user-check text-(--brand-primary)" aria-hidden="true"></span>
				Candidatures freelance
			</h1>
			<p class="page-subtitle">Comptes créés via le formulaire public — en attente de revue avant promotion.</p>
		</div>
		<a href="{{ path('admin_collaborator_index') }}" class="btn btn-secondary gap-2">
			<span class="ti ti-users-group" aria-hidden="true"></span>
			<span>Voir les collaborateurs</span>
		</a>
	</div>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Candidatures freelance en attente</caption>
			<thead>
				<tr>
					<th scope="col" class="w-16">Id</th>
					<th scope="col">Compte</th>
					<th scope="col">Spécialités</th>
					<th scope="col">Disponibilité</th>
					<th scope="col">Portfolio</th>
					<th scope="col" class="w-32 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for candidate in candidates %}
					<tr>
						<td class="font-mono text-xs opacity-50">{{ candidate.id }}</td>
						<td>
							<div class="flex items-center gap-3">
								<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white" style="background: var(--color-brand-primary)" aria-hidden="true">
									{{ (candidate.fullName ?? candidate.email)|slice(0, 2)|upper }}
								</span>
								<div class="min-w-0">
									<div class="font-bold text-(--brand-dark) truncate">{{ candidate.fullName ?? 'Non spécifié' }}</div>
									<div class="text-xs opacity-60 truncate">{{ candidate.email }}{% if candidate.phone %} — {{ candidate.phone }}{% endif %}</div>
								</div>
							</div>
						</td>
						<td>
							{% if candidate.specialties %}
								<div class="flex flex-wrap gap-1">
									{% for specialty in candidate.specialties %}<twig:Badge variant="neutral">{{ specialty }}</twig:Badge>{% endfor %}
								</div>
							{% else %}
								<span class="text-xs opacity-40">—</span>
							{% endif %}
						</td>
						<td class="text-sm opacity-70">{{ candidate.availability ?? '—' }}</td>
						<td>
							{% if candidate.portfolioUrl %}
								<a href="{{ candidate.portfolioUrl }}" target="_blank" rel="noopener noreferrer" class="text-(--brand-primary) text-sm hover:underline inline-flex items-center gap-1">
									<span class="ti ti-external-link" aria-hidden="true"></span> Voir
								</a>
							{% else %}
								<span class="text-xs opacity-40">—</span>
							{% endif %}
						</td>
						<td>
							<div class="flex items-center justify-end gap-1">
								<a href="{{ path('admin_collaborator_read', {'id': candidate.id}) }}" class="btn btn-ghost btn-icon relative" aria-label="Voir la candidature de {{ candidate.fullName ?? candidate.email }}{{ unreadCounts[candidate.id] is defined ? ' (nouvelle réponse)' : '' }}">
									<span class="ti ti-eye text-lg" aria-hidden="true"></span>
									{% if unreadCounts[candidate.id] is defined %}
										<span class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-danger text-[10px] font-bold text-white" aria-hidden="true">{{ unreadCounts[candidate.id] }}</span>
									{% endif %}
								</a>
								<a href="{{ path('admin_collaborator_update', {'id': candidate.id}) }}" class="btn btn-ghost btn-icon text-success" aria-label="Promouvoir {{ candidate.fullName ?? candidate.email }}" title="Promouvoir en collaborateur">
									<span class="ti ti-user-check text-lg" aria-hidden="true"></span>
								</a>
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="6"><twig:EmptyState text="Aucune candidature en attente." icon="ti-user-check" /></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
