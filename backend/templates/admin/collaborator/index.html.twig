{% extends 'base.html.twig' %}

{% block title %}Gestion des collaborateurs{% endblock %}

{% block body %}
	<div class="page-header">
		<div class="min-w-0">
			<h1 class="page-title flex items-center gap-2">
				<span class="ti ti-users-group text-(--color-brand-primary)" aria-hidden="true"></span>
				Collaborateurs
				{% if candidatesCount > 0 %}
					<a href="{{ path('admin_collaborator_candidates') }}" class="badge badge-info hover:opacity-80" title="Candidatures freelance en attente">{{ candidatesCount }} candidature{{ candidatesCount > 1 ? 's' : '' }}</a>
				{% endif %}
			</h1>
			<p class="page-subtitle">Pros et freelances associés à vos projets.</p>
		</div>
		<div class="flex items-center gap-2 shrink-0">
			<a href="{{ path('admin_collaborator_candidates') }}" class="btn btn-secondary gap-2">
				<span class="ti ti-user-check" aria-hidden="true"></span>
				<span>Candidatures</span>
			</a>
			<a href="{{ path('admin_collaborator_create') }}" class="btn btn-primary gap-2">
				<span class="ti ti-plus" aria-hidden="true"></span>
				<span>Ajouter</span>
			</a>
		</div>
	</div>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Liste des collaborateurs</caption>
			<thead>
				<tr>
					<th scope="col" class="w-16">Id</th>
					<th scope="col">Compte</th>
					<th scope="col">Statut</th>
					<th scope="col">Projets</th>
					<th scope="col" class="w-40 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for collaborator in collaborators %}
					<tr>
						<td class="font-mono text-xs opacity-50">{{ collaborator.id }}</td>
						<td>
							<div class="flex items-center gap-3">
								<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white" style="background: var(--color-brand-primary)" aria-hidden="true">
									{{ (collaborator.fullName ?? collaborator.email)|slice(0, 2)|upper }}
								</span>
								<div class="min-w-0">
									<div class="font-bold text-(--color-brand-dark) truncate">{{ collaborator.fullName ?? 'Non spécifié' }}</div>
									<div class="text-xs opacity-60 truncate">{{ collaborator.email }}</div>
								</div>
							</div>
						</td>
						<td>
							{% if collaborator.isActive %}
								<twig:Badge variant="success">Actif</twig:Badge>
							{% else %}
								<twig:Badge variant="danger">Désactivé</twig:Badge>
							{% endif %}
						</td>
						<td>
							{% set pc = collaborator.collaboratingProjects|length %}
							{% if pc > 0 %}
								<twig:Badge variant="info">{{ pc }} projet{{ pc > 1 ? 's' : '' }}</twig:Badge>
							{% else %}
								<span class="text-xs opacity-40">Aucun</span>
							{% endif %}
						</td>
						<td>
							<div class="flex items-center justify-end gap-1">
								<a href="{{ path('admin_collaborator_read', {'id': collaborator.id}) }}" class="btn btn-ghost btn-icon" aria-label="Voir {{ collaborator.fullName ?? collaborator.email }}">
									<span class="ti ti-eye text-lg" aria-hidden="true"></span>
								</a>
								<a href="{{ path('admin_collaborator_update', {'id': collaborator.id}) }}" class="btn btn-ghost btn-icon text-amber-600" aria-label="Modifier {{ collaborator.fullName ?? collaborator.email }}">
									<span class="ti ti-edit text-lg" aria-hidden="true"></span>
								</a>
								<twig:DeleteModal :id="collaborator.id" :action="path('admin_collaborator_delete', {id: collaborator.id})" :token="csrf_token('admin_collaborator_delete_' ~ collaborator.id)" :label="collaborator.fullName ?? collaborator.email" entity="ce collaborateur" />
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="5"><twig:EmptyState text="Aucun collaborateur trouvé." icon="ti-users-group" /></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
