{% extends 'base.html.twig' %}

{% block title %}Demandes de devis{% endblock %}

{% block body %}
	<twig:PageHeader title="Demandes de devis" subtitle="Devis, support et partenariats reçus des clients." icon="ti-file-invoice" />

	<form method="get" role="search" class="panel panel-body mb-6 flex flex-col sm:flex-row gap-3 sm:items-end">
		<div class="flex-1">
			<label for="f-search" class="field-label">Recherche</label>
			<input id="f-search" type="search" name="search" value="{{ filters.search }}" placeholder="Nom, email, message…" class="input w-full">
		</div>
		<div>
			<label for="f-status" class="field-label">Statut</label>
			<select id="f-status" name="status" class="input input-select">
				<option value="">Tous</option>
				{% for status in statuses %}
					<option value="{{ status.value }}" {% if filters.status == status.value %}selected{% endif %}>{{ status.getLabel() }}</option>
				{% endfor %}
			</select>
		</div>
		<button type="submit" class="btn btn-primary gap-2"><span class="ti ti-filter" aria-hidden="true"></span> Filtrer</button>
	</form>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Demandes de devis reçues</caption>
			<thead>
				<tr>
					<th scope="col" class="w-16">Id</th>
					<th scope="col">Statut</th>
					<th scope="col">Demandeur</th>
					<th scope="col">Catégorie</th>
					<th scope="col">Contact</th>
					<th scope="col" class="w-24 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for quoteRequest in requests %}
					<tr>
						<td class="font-mono text-xs opacity-50">{{ quoteRequest.id }}</td>
						<td><span class="badge {{ quoteRequest.status.badgeClass }}">{{ quoteRequest.status.label }}</span></td>
						<td>
							<div>{{ quoteRequest.name }}</div>
							<div class="text-xs opacity-60">{{ quoteRequest.email }}</div>
						</td>
						<td>
							<div class="text-sm font-semibold">{{ quoteRequest.category|default('—') }}</div>
							<div class="text-xs opacity-60">{{ quoteRequest.categoryDetail }}</div>
						</td>
						<td class="text-sm opacity-70">
							<div>{{ quoteRequest.channel|default('—') }}</div>
							{% if quoteRequest.phone %}<div class="text-xs opacity-60">{{ quoteRequest.phone }}</div>{% endif %}
						</td>
						<td>
							<div class="flex items-center justify-end gap-1">
								<a href="{{ path('admin_request_read', {'id': quoteRequest.id}) }}" class="btn btn-ghost btn-icon" aria-label="Voir la demande de {{ quoteRequest.name }}">
									<span class="ti ti-eye text-lg" aria-hidden="true"></span>
								</a>
								<twig:DeleteModal :id="quoteRequest.id" :action="path('admin_request_delete', {id: quoteRequest.id})" :token="csrf_token('admin_request_delete_' ~ quoteRequest.id)" :label="quoteRequest.name" entity="cette demande" />
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="6"><twig:EmptyState text="Aucune demande pour le moment." icon="ti-file-invoice" /></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
