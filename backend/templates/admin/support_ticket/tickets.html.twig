{% extends 'base.html.twig' %}

{% block title %}Tickets support{% endblock %}

{% block body %}
	<div class="page-header">
		<div class="min-w-0">
			<h1 class="page-title flex items-center gap-2">
				<span class="ti ti-lifebuoy text-(--color-brand-primary)" aria-hidden="true"></span>
				Tickets support
				{% if openCount > 0 %}<twig:Badge variant="info">{{ openCount }} ouvert{{ openCount > 1 ? 's' : '' }}</twig:Badge>{% endif %}
			</h1>
			<p class="page-subtitle">Demandes de support envoyées via le site.</p>
		</div>
	</div>

	<form method="get" role="search" class="panel panel-body mb-6 flex flex-col sm:flex-row gap-3 sm:items-end">
		<div class="flex-1">
			<label for="f-search" class="field-label">Recherche</label>
			<input id="f-search" type="search" name="search" value="{{ filters.search }}" placeholder="Nom, email, sujet…" class="input w-full">
		</div>
		<div>
			<label for="f-status" class="field-label">Statut</label>
			<select id="f-status" name="status" class="input input-select">
				<option value="">Tous</option>
				{% for status in statuses %}
					<option value="{{ status.value }}" {% if filters.status == status.value %}selected{% endif %}>{{ status.getLabel() }}</option>
				{% endfor %}
			</select>
		</div>
		<button type="submit" class="btn btn-primary gap-2"><span class="ti ti-filter" aria-hidden="true"></span> Filtrer</button>
	</form>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Tickets de support reçus</caption>
			<thead>
				<tr>
					<th scope="col" class="w-16">Id</th>
					<th scope="col">Statut</th>
					<th scope="col">Expéditeur</th>
					<th scope="col">Sujet</th>
					<th scope="col">Reçu le</th>
					<th scope="col" class="w-24 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for ticket in tickets %}
					<tr class="{% if ticket.status.value == 'open' %}font-semibold{% endif %}">
						<td class="font-mono text-xs opacity-50">{{ ticket.id }}</td>
						<td><span class="badge {{ ticket.status.getBadgeClass() }}">{{ ticket.status.getLabel() }}</span></td>
						<td>
							<div>{{ ticket.name }}</div>
							<div class="text-xs opacity-60">{{ ticket.email }}</div>
						</td>
						<td class="max-w-xs truncate">{{ ticket.subject }}</td>
						<td class="text-sm opacity-70 whitespace-nowrap">{{ ticket.createdAt|date('d/m/Y H:i') }}</td>
						<td>
							<div class="flex items-center justify-end gap-1">
								<a href="{{ path('admin_support_ticket_read', {'id': ticket.id}) }}" class="btn btn-ghost btn-icon" aria-label="Voir le ticket de {{ ticket.name }}">
									<span class="ti ti-eye text-lg" aria-hidden="true"></span>
								</a>
								<twig:DeleteModal :id="ticket.id" :action="path('admin_support_ticket_delete', {id: ticket.id})" :token="csrf_token('admin_support_ticket_delete_' ~ ticket.id)" :label="ticket.subject" entity="ce ticket" />
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="6"><twig:EmptyState text="Aucun ticket pour le moment." icon="ti-lifebuoy" /></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
