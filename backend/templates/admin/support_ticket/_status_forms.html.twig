{# templates/admin/support_ticket/_status_forms.html.twig #}
<div class="flex flex-col gap-3">
	{% if ticket.status.value == 'open' or ticket.status.value == 'in_progress' %}
		<form method="post" action="{{ path('admin_support_ticket_resolve', {'id': ticket.id}) }}" class="w-full">
			<input type="hidden" name="_token" value="{{ csrf_token('support_status_' ~ ticket.id) }}">
			<button type="submit" class="btn w-full text-sm gap-2 bg-green-500 text-white border-0">
				<span class="ti ti-circle-check text-sm" aria-hidden="true"></span>
				<span>Marquer résolu</span>
			</button>
		</form>
	{% else %}
		<p class="text-xs opacity-50 text-center">Ticket résolu — une réponse du client le rouvrira automatiquement.</p>
	{% endif %}
</div>
