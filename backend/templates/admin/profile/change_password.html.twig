{# templates/admin/profile/change_password.html.twig #}
{% extends 'base.html.twig' %}

{% set routePrefix = 'admin_profile_' %}

{% block title %}Changer le mot de passe{% endblock %}

{% block body %}
	<twig:PageHeader title="Changer le mot de passe" icon="ti-lock-cog" />

	<div class="max-w-md">
		<div class="panel">
			<div class="panel-body">
				{{ form_start(form, {'attr': {'class': 'space-y-4', 'novalidate': 'novalidate'}}) }}

				{% if form_errors(form) %}
					<div class="field-error mb-2">{{ form_errors(form) }}</div>
				{% endif %}

				<div class="field">
					{{ form_label(form.plainPassword, null, {'label_attr': {'class': 'field-label'}}) }}
					{{ form_widget(form.plainPassword, {'attr': {'class': 'input w-full'}}) }}
					{{ form_errors(form.plainPassword, {'attr': {'class': 'field-error'}}) }}
				</div>

				<div class="field">
					{{ form_label(form.confirmPassword, null, {'label_attr': {'class': 'field-label'}}) }}
					{{ form_widget(form.confirmPassword, {'attr': {'class': 'input w-full'}}) }}
					{{ form_errors(form.confirmPassword, {'attr': {'class': 'field-error'}}) }}
				</div>

				<div class="flex justify-end gap-3 pt-2">
					<a href="{{ path(routePrefix ~ 'read', {'id': user.id}) }}" class="btn btn-secondary">Annuler</a>
					<button type="submit" class="btn btn-primary gap-2">
						<span class="ti ti-lock-cog" aria-hidden="true"></span>
						Changer le mot de passe
					</button>
				</div>

				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
