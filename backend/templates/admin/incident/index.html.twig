{% extends 'base.html.twig' %}

{% block title %}Journal d'incidents{% endblock %}

{% block body %}
	{% set n = incidents|length %}
	<twig:PageHeader title="Journal d'incidents" :subtitle="n ~ ' incident' ~ (n > 1 ? 's' : '') ~ ' enregistré' ~ (n > 1 ? 's' : '') ~ ' — historique et récurrences.'" icon="ti-alert-triangle">
		<a href="{{ path('admin_incident_export', filters) }}" class="btn btn-secondary gap-2">
			<span class="ti ti-download" aria-hidden="true"></span> Exporter (CSV)
		</a>
		<a href="{{ path('admin_incident_create') }}" class="btn btn-primary gap-2">
			<span class="ti ti-plus" aria-hidden="true"></span>
			<span>Déclarer un incident</span>
		</a>
	</twig:PageHeader>

	<div class="grid grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
		<div class="stat-tile">
			<div class="stat-tile__icon"><span class="ti ti-list" aria-hidden="true"></span></div>
			<div>
				<div class="stat-tile__value">{{ n }}</div>
				<div class="stat-tile__label">Incidents au total</div>
			</div>
		</div>
		<div class="stat-tile">
			<div class="stat-tile__icon"><span class="ti ti-flame" aria-hidden="true"></span></div>
			<div>
				<div class="stat-tile__value {{ openCount > 0 ? 'text-warning' : '' }}">{{ openCount }}</div>
				<div class="stat-tile__label">Ouverts / sous surveillance</div>
			</div>
		</div>
		<div class="stat-tile">
			<div class="stat-tile__icon"><span class="ti ti-repeat" aria-hidden="true"></span></div>
			<div>
				<div class="stat-tile__value {{ recurringCategories|length > 0 ? 'text-warning' : '' }}">{{ recurringCategories|length }}</div>
				<div class="stat-tile__label">Catégories récurrentes (≥2)</div>
			</div>
		</div>
	</div>

	{% if recurringCategories|length > 0 %}
		<div class="card mb-6 border-l-4 border-warning">
			<h3 class="text-xs font-bold uppercase tracking-wider opacity-40 mb-3 flex items-center gap-2">
				<span class="ti ti-repeat text-sm" aria-hidden="true"></span>
				Récurrence par catégorie — un même type d'incident qui revient signale une cause racine non traitée
			</h3>
			<div class="flex flex-wrap gap-2">
				{% for row in recurringCategories %}
					{% set cat = constant('App\\Enum\\IncidentCategoryEnum::' ~ row.category|upper) %}
					<a href="{{ path('admin_incident_index', {category: row.category}) }}" class="badge {{ cat.badgeClass }} inline-flex items-center gap-1.5">
						{{ cat.label }}
						<span class="bg-white/30 rounded-full px-1.5">{{ row.count }}</span>
					</a>
				{% endfor %}
			</div>
		</div>
	{% endif %}

	<form method="get" class="flex flex-wrap items-end gap-3 mb-4">
		<div>
			<label class="block text-xs font-bold mb-1 opacity-70" for="filter-category">Catégorie</label>
			<select id="filter-category" name="category" class="input input-select text-sm" onchange="this.form.submit()">
				<option value="">Toutes</option>
				{% for cat in categories %}
					<option value="{{ cat.value }}" {{ filters.category == cat.value ? 'selected' : '' }}>{{ cat.label }}</option>
				{% endfor %}
			</select>
		</div>
		<div>
			<label class="block text-xs font-bold mb-1 opacity-70" for="filter-severity">Gravité</label>
			<select id="filter-severity" name="severity" class="input input-select text-sm" onchange="this.form.submit()">
				<option value="">Toutes</option>
				{% for sev in severities %}
					<option value="{{ sev.value }}" {{ filters.severity == sev.value ? 'selected' : '' }}>{{ sev.label }}</option>
				{% endfor %}
			</select>
		</div>
		<div>
			<label class="block text-xs font-bold mb-1 opacity-70" for="filter-status">Statut</label>
			<select id="filter-status" name="status" class="input input-select text-sm" onchange="this.form.submit()">
				<option value="">Tous</option>
				{% for st in statuses %}
					<option value="{{ st.value }}" {{ filters.status == st.value ? 'selected' : '' }}>{{ st.label }}</option>
				{% endfor %}
			</select>
		</div>
		{% if filters.category or filters.severity or filters.status %}
			<a href="{{ path('admin_incident_index') }}" class="btn btn-ghost btn-sm">Réinitialiser</a>
		{% endif %}
	</form>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Liste des incidents</caption>
			<thead>
				<tr>
					<th scope="col" class="w-16">Id</th>
					<th scope="col">Incident</th>
					<th scope="col" class="w-36">Catégorie</th>
					<th scope="col" class="w-28">Gravité</th>
					<th scope="col" class="w-32">Statut</th>
					<th scope="col" class="w-32">Détecté</th>
					<th scope="col" class="w-32 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for incident in incidents %}
					<tr>
						<td class="font-mono text-xs opacity-50">{{ incident.id }}</td>
						<td>
							<div class="font-bold truncate text-(--color-brand-dark)">{{ incident.title }}</div>
							{% if incident.relatedReference %}
								<div class="text-xs opacity-60 flex items-center gap-1 mt-0.5">
									<span class="ti ti-link text-sm" aria-hidden="true"></span>
									{{ incident.relatedReference }}
								</div>
							{% endif %}
						</td>
						<td><span class="badge {{ incident.category.badgeClass }}">{{ incident.category.label }}</span></td>
						<td><span class="badge {{ incident.severity.badgeClass }}">{{ incident.severity.label }}</span></td>
						<td><span class="badge {{ incident.status.badgeClass }}">{{ incident.status.label }}</span></td>
						<td class="text-xs opacity-80 whitespace-nowrap">{{ incident.detectedAt ? incident.detectedAt|date('d/m/Y H:i') : '—' }}</td>
						<td>
							<div class="flex items-center justify-end gap-1">
								<a href="{{ path('admin_incident_read', {'id': incident.id}) }}" class="btn btn-ghost btn-icon" aria-label="Voir {{ incident.title }}">
									<span class="ti ti-eye text-lg" aria-hidden="true"></span>
								</a>
								<a href="{{ path('admin_incident_update', {'id': incident.id}) }}" class="btn btn-ghost btn-icon text-amber-600" aria-label="Modifier {{ incident.title }}">
									<span class="ti ti-edit text-lg" aria-hidden="true"></span>
								</a>
								{% if is_granted(constant('App\\Security\\Voter\\IncidentVoter::DELETE'), incident) %}
									<twig:DeleteModal :id="incident.id" :action="path('admin_incident_delete', {id: incident.id})" :token="csrf_token('admin_incident_delete_' ~ incident.id)" :label="incident.title" entity="cet incident" />
								{% endif %}
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="7"><twig:EmptyState text="Aucun incident enregistré pour le moment — tant mieux." icon="ti-alert-triangle" /></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
