{# templates/admin/incident/create.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Déclarer un incident{% endblock %}

{% block body %}
	<div class="container mx-auto px-4 py-8">
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
			<div>
				<div class="flex items-center gap-2 text-xs font-bold text-brand-dark opacity-40 uppercase tracking-wider">
					<a href="{{ path('admin_incident_index') }}" class="hover:text-brand-primary transition-colors">Incidents</a>
					<span class="ti ti-chevron-right text-xs" aria-hidden="true"></span>
					<span>Nouveau</span>
				</div>
				<h1 class="text-3xl font-heading font-bold mt-1 flex items-center gap-2 text-brand-dark">
					<span class="ti ti-alert-triangle text-brand-primary" aria-hidden="true"></span>
					<span>Déclarer un incident</span>
				</h1>
			</div>

			<a href="{{ path('admin_incident_index') }}" class="btn btn-secondary gap-2 px-4 py-2">
				<span class="ti ti-arrow-left text-base" aria-hidden="true"></span>
				<span>Retour à la liste</span>
			</a>
		</div>

		{{ include('admin/incident/_form.html.twig', {'button_label': 'Enregistrer l\'incident'}) }}
	</div>
{% endblock %}
