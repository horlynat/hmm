{# templates/user/update.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Modifier :
	{{ user.fullName ?? user.email }}
{% endblock %}

{% block body %}
	<div>

		<!-- 🏷️ FIL D'ARIANE / HEADER -->
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
			<div>
				<div class="flex items-center gap-2 text-xs font-bold text-brand-dark opacity-40 uppercase tracking-wider">
					<a href="{{ path('admin_users_index') }}" class="hover:text-brand-primary transition-colors">Clients</a>
					<span class="ti ti-chevron-right text-xs" aria-hidden="true"></span>
					<span>Édition</span>
				</div>
				<h1 class="text-3xl font-heading font-bold mt-1 flex items-center gap-2 text-brand-dark">
					<span class="ti ti-edit text-brand-primary" aria-hidden="true"></span>
					<span>Modifier le client</span>
				</h1>
			</div>

			<a href="{{ path('admin_users_index') }}" class="btn btn-secondary gap-2 px-4 py-2">
				<span class="ti ti-arrow-left text-base" aria-hidden="true"></span>
				<span>Retour à la liste</span>
			</a>
		</div>

		<!-- ⚡ FORMULAIRE -->
		{{ include('admin/admins/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

	</div>
{% endblock %}
