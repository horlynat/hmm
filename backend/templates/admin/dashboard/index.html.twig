{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord Administration
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>window.dashboardData = {{ chartData|json_encode|raw }};</script>
	{{ vite_entry_script_tags('dashboard') }}
{% endblock %}

{% block body %}
	<div class="container mx-auto px-4 py-8 text-brand-dark">

		<!-- 👑 EN-TÊTE DU DASHBOARD -->
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
			<div>
				<h1 class="text-[21px] font-heading font-bold tracking-tight">Vue Globale</h1>
				<p class="text-sm text-brand-dark/60">Pilotez votre activité, vos projets et la santé du système.</p>
			</div>
			<div class="flex items-center gap-3 bg-white border border-gray-100 p-1.5 rounded-xl text-xs font-medium shadow-sm">
				<span class="px-3 py-1.5 bg-brand-light/20 text-brand-primary rounded-lg font-semibold">Année
					{{ "now"|date("Y") }}</span>
				<span class="text-gray-400 pr-2">Mis à jour à l'instant</span>
			</div>
		</div>

		<!-- ⚡ 1. ACTIONS RAPIDES (QUICK ACTIONS) -->
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
			<a href="{{ path('admin_project_create') }}" class="flex items-center gap-3 p-3.5 bg-brand-primary/5 hover:bg-brand-primary/10 text-brand-primary rounded-xl font-semibold transition text-sm group">
				<i class="ti ti-plus text-lg transition-transform group-hover:scale-110"></i>
				<span>Nouveau Projet</span>
			</a>
			<a href="{{ path('admin_article_create') }}" class="flex items-center gap-3 p-3.5 bg-brand-dark/5 hover:bg-brand-dark/10 text-brand-dark rounded-xl font-semibold transition text-sm group">
				<i class="ti ti-file-plus text-lg transition-transform group-hover:scale-110"></i>
				<span>Rédiger un Article</span>
			</a>
			<a href="{{ path('admin_request_index') }}" class="flex items-center gap-3 p-3.5 bg-amber-500/5 hover:bg-amber-500/10 text-amber-700 rounded-xl font-semibold transition text-sm group">
				<i class="ti ti-mail-forward text-lg transition-transform group-hover:scale-110"></i>
				<span>Traiter les Devis</span>
			</a>
			<a href="{{ path('admin_config_index') }}" class="flex items-center gap-3 p-3.5 bg-purple-500/5 hover:bg-purple-500/10 text-purple-700 rounded-xl font-semibold transition text-sm group">
				<i class="ti ti-adjustments text-lg transition-transform group-hover:scale-110"></i>
				<span>Paramètres Serveur</span>
			</a>
		</div>

		<!-- ==========================================
				     🛑 ZONE D'ALERTE SYSTEME / DANGER (Si incident existant)
				     ========================================== -->
		{% if stats.criticalIncidentsCount is defined and stats.criticalIncidentsCount > 0 %}
			<div class="mb-8 border border-red-200 bg-red-50/50 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center gap-4 animate-pulse-danger">
				<div class="p-3 bg-danger text-white rounded-xl shadow-sm shrink-0">
					<i class="ti ti-alert-triangle text-xl"></i>
				</div>
				<div class="flex-1">
					<h3 class="font-heading font-bold text-red-900 text-base">Ça demande une action maintenant</h3>
					<p class="text-sm text-red-700/90 mt-0.5">
						{% if stats.overBudgetCount > 0 %}
							{{ stats.overBudgetCount }} projet{{ stats.overBudgetCount > 1 ? 's' : '' }} en dépassement de budget
						{% endif %}
						{% if stats.overBudgetCount > 0 and overdueInvoicesCount > 0 %}
							·
						{% endif %}
						{% if overdueInvoicesCount > 0 %}
							{{ overdueInvoicesCount }} facture{{ overdueInvoicesCount > 1 ? 's' : '' }} en retard de paiement
						{% endif %}
					</p>
				</div>
				<div class="flex items-center gap-2 shrink-0">
					{% if stats.overBudgetCount > 0 %}
						<a href="{{ path('admin_dashboard_projects', {budget_status: 'over'}) }}" class="px-4 py-2 bg-danger hover:bg-red-700 text-white text-xs font-semibold rounded-xl transition shadow-sm">
							Voir les projets
						</a>
					{% endif %}
					{% if overdueInvoicesCount > 0 %}
						<a href="{{ path('admin_finance_index') }}" class="px-4 py-2 border border-danger text-danger hover:bg-red-100 text-xs font-semibold rounded-xl transition">
							Voir les factures
						</a>
					{% endif %}
				</div>
			</div>
		{% endif %}

		<!-- ==========================================
				     📊 INDICATEURS CLÉS (KPIs)
				     ========================================== -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
			<div class="soft-card p-3.5">
				<div class="flex items-center justify-between mb-4">
					<span class="text-xs uppercase text-brand-dark/50 font-bold tracking-wider">CA Encaissé</span>
					<div class="p-2 bg-emerald-50 text-success rounded-xl">
						<i class="ti ti-coin text-xl"></i>
					</div>
				</div>
				<div class="text-xl font-bold tracking-tight">{{ revenue.realizedRevenue|default(0)|money(revenue.ledgerCurrency|default('EUR')) }}</div>
				<p class="text-xs text-success font-medium mt-2 flex items-center gap-1">
					<i class="ti ti-arrow-up-right"></i>
					{{ revenue.realizedRevenueCount|default(0) }} facture{{ revenue.realizedRevenueCount > 1 ? 's' : '' }} payée{{ revenue.realizedRevenueCount > 1 ? 's' : '' }}
				</p>
			</div>

			<div class="soft-card p-3.5">
				<div class="flex items-center justify-between mb-4">
					<span class="text-xs uppercase text-brand-dark/50 font-bold tracking-wider">Facturé, en attente</span>
					<div class="p-2 bg-blue-50 text-info rounded-xl">
						<i class="ti ti-file-invoice text-xl"></i>
					</div>
				</div>
				<div class="text-xl font-bold tracking-tight">{{ revenue.invoicedPending|default(0)|money(revenue.ledgerCurrency|default('EUR')) }}</div>
				<p class="text-xs text-info font-medium mt-2 flex items-center gap-1">
					<i class="ti ti-clock-hour-4"></i>
					{{ revenue.invoicedPendingCount|default(0) }} facture{{ revenue.invoicedPendingCount > 1 ? 's' : '' }} pas encore payée{{ revenue.invoicedPendingCount > 1 ? 's' : '' }} — pas du CA
				</p>
			</div>

			<div class="soft-card p-3.5">
				<div class="flex items-center justify-between mb-4">
					<span class="text-xs uppercase text-brand-dark/50 font-bold tracking-wider">Demandes Actives</span>
					<div class="p-2 bg-amber-50 text-warning rounded-xl">
						<i class="ti ti-git-pull-request text-xl"></i>
					</div>
				</div>
				<div class="text-xl font-bold tracking-tight">{{ pendingQuoteRequestsCount|default(0) }}</div>
				<p class="text-xs text-brand-dark/60 mt-2">
					Devis en attente
				</p>
				{% if revenue.pipelineQuoteCount|default(0) > 0 %}
					<p class="text-[11px] text-brand-dark/40 mt-1.5 border-t border-gray-100 pt-1.5">
						≈ {{ revenue.pipelineEstimate|money(revenue.ledgerCurrency|default('EUR')) }} estimés sur {{ revenue.pipelineQuoteCount }} devis actifs
						<span class="italic">— pipeline, jamais compté au CA</span>
					</p>
				{% endif %}
			</div>

			<div class="soft-card p-3.5">
				<div class="flex items-center justify-between mb-4">
					<span class="text-xs uppercase text-brand-dark/50 font-bold tracking-wider">Messages reçus</span>
					<div class="p-2 bg-purple-50 text-purple-600 rounded-xl">
						<i class="ti ti-message-code text-xl"></i>
					</div>
				</div>
				<div class="text-xl font-bold tracking-tight">{{ unreadContactsCount|default(0) }}</div>
				<p class="text-xs text-brand-dark/60 mt-2">
					Non lus, formulaire de contact
				</p>
			</div>
		</div>

		<!-- ==========================================
				     🎛️ VUE D'ENSEMBLE DE LA PLATEFORME
				     ========================================== -->
		<div class="soft-card p-3.5 mb-8">
			<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60 mb-4">Vue d'ensemble de la plateforme</h2>

			<p class="text-xs uppercase text-brand-dark/40 font-bold tracking-wider mb-2">Sécurité</p>
			<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5">
				<twig:DashboardTile route="admin_security_two_factor_index" icon="ti-shield-off" :count="usersWithoutTwoFactorCount|default(0)" label="Comptes sans 2FA" :warn="true" />
				<twig:DashboardTile route="admin_security_log_index" :params="{tab: 'failed'}" icon="ti-alert-triangle" :count="recentFailedLoginAttemptsCount|default(0)" label="Connexions échouées (24h)" :warn="true" />
				<twig:DashboardTile route="admin_security_session_index" icon="ti-device-desktop-analytics" :count="activeSessionsCount|default(0)" label="Sessions actives" :warn="false" />
			</div>

			<p class="text-xs uppercase text-brand-dark/40 font-bold tracking-wider mb-2">Équipe & utilisateurs</p>
			<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5">
				<twig:DashboardTile route="admin_admins_index" icon="ti-user-shield" :count="adminsCount|default(0)" label="Admins" :warn="false" />
				<twig:DashboardTile route="admin_collaborator_index" icon="ti-users-group" :count="collaboratorsCount|default(0)" label="Collaborateurs" :warn="false" />
				<twig:DashboardTile route="admin_users_index" icon="ti-user-dollar" :count="clientsCount|default(0)" label="Clients" :warn="false" />
			</div>

			<p class="text-xs uppercase text-brand-dark/40 font-bold tracking-wider mb-2">Contenu</p>
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
				<twig:DashboardTile route="admin_article_index" icon="ti-news" :count="articlesCount|default(0)" label="Articles" :warn="false" />
				<twig:DashboardTile route="admin_skill_index" icon="ti-code" :count="skillsCount|default(0)" label="Compétences" :warn="false" />
				<twig:DashboardTile route="admin_course_index" icon="ti-school" :count="coursesCount|default(0)" label="Formations" :warn="false" />
				<twig:DashboardTile route="admin_experience_index" icon="ti-history" :count="experiencesCount|default(0)" label="Expériences" :warn="false" />
			</div>

			<p class="text-xs uppercase text-brand-dark/40 font-bold tracking-wider mb-2">Finance & Support</p>
			<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5">
				<twig:DashboardTile route="admin_finance_index" icon="ti-file-invoice" :count="overdueInvoicesCount|default(0)" label="Factures en retard" :warn="true" />
				<twig:DashboardTile route="admin_finance_index" icon="ti-receipt-2" :count="pendingExpensesCount|default(0)" label="Dépenses à approuver" :warn="true" />
				<twig:DashboardTile route="admin_support_ticket_index" icon="ti-headset" :count="openTicketsCount|default(0)" label="Tickets support ouverts" :warn="true" />
			</div>

			<p class="text-xs uppercase text-brand-dark/40 font-bold tracking-wider mb-2">Modération</p>
			<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
				<twig:DashboardTile route="admin_testimonial_index" icon="ti-message-star" :count="pendingTestimonialsCount|default(0)" label="Témoignages en attente" :warn="true" />
			</div>
		</div>

		<!-- ==========================================
				     🤝 CRM — RELATION CLIENT
				     (acquisition : devis, contacts, portefeuille client — tout ce
				     qui précède un projet signé. Même découpage que l'aside admin
				     et la maquette de refonte validée.)
				     ========================================== -->
		<div class="flex items-center gap-3 mb-4 mt-2">
			<div class="p-2.5 bg-brand-primary/10 text-brand-primary rounded-xl shrink-0">
				<i class="ti ti-users-group text-xl"></i>
			</div>
			<div>
				<h2 class="text-xl font-heading font-bold">CRM — Relation client</h2>
				<p class="text-xs text-brand-dark/50">Acquisition, devis et demandes entrantes — tout ce qui précède un projet signé</p>
			</div>
		</div>

		<!-- 📬 FLUX CONTACTS & DEMANDES RECENTES -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
			<div class="soft-card p-3.5">
				<div class="flex justify-between items-center mb-4">
					<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60">Demandes Commerciales & Devis</h2>
					<a href="{{ path('admin_request_index') }}" class="text-xs font-semibold text-brand-primary hover:underline">Voir tout</a>
				</div>
				<div class="divide-y divide-gray-100 max-h-[360px] overflow-y-auto scrollbar-none">
					{% for quoteRequest in recentQuoteRequests %}
						<a href="{{ path('admin_request_read', {id: quoteRequest.id}) }}" class="flex justify-between items-center py-3.5 first:pt-0 last:pb-0 hover:opacity-70 transition">
							<div class="min-w-0">
								<h4 class="font-medium text-sm truncate">{{ quoteRequest.name }}</h4>
								<p class="text-xs text-brand-dark/50 mt-0.5 flex items-center gap-1.5 truncate">
									<span class="inline-block w-1.5 h-1.5 bg-amber-400 rounded-full shrink-0"></span>
									{{ quoteRequest.message|slice(0, 60) }}{{ quoteRequest.message|length > 60 ? '…' }}
								</p>
							</div>
							<div class="text-right shrink-0 pl-3">
								<span class="text-xs font-semibold px-2.5 py-1 bg-gray-100 text-gray-700 rounded-lg">En attente</span>
							</div>
						</a>
					{% else %}
						<div class="text-center py-8 text-sm text-brand-dark/40">
							<i class="ti ti-mailbox text-2xl block mb-2 text-gray-300"></i>
							Aucune proposition commerciale en attente.
						</div>
					{% endfor %}
				</div>
			</div>

			<div class="soft-card p-3.5">
				<div class="flex justify-between items-center mb-4">
					<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60">Derniers Contacts Reçus</h2>
					<a href="{{ path('admin_contact_index') }}" class="text-xs font-semibold text-brand-primary hover:underline">Voir tout</a>
				</div>
				<div class="divide-y divide-gray-100 max-h-[360px] overflow-y-auto scrollbar-none">
					{% for contact in recentContacts %}
						<a href="{{ path('admin_contact_read', {id: contact.id}) }}" class="flex items-center gap-3 py-3.5 first:pt-0 last:pb-0 hover:opacity-70 transition">
							<img class="h-9 w-9 rounded-xl border border-gray-100 shadow-sm" src="https://ui-avatars.com/api/?background=eaeaea&color=333&name={{ contact.name|url_encode }}" alt="{{ contact.name }}">
							<div class="flex-1 min-w-0">
								<h4 class="font-medium text-sm truncate">{{ contact.name }}</h4>
								<p class="text-xs text-brand-dark/50 truncate mt-0.5">{{ contact.subject }}</p>
							</div>
							<span class="text-[11px] text-gray-400 shrink-0 font-medium">{{ contact.createdAt|date('d/m H:i') }}</span>
						</a>
					{% else %}
						<div class="text-center py-8 text-sm text-brand-dark/40">
							<i class="ti ti-message-off text-2xl block mb-2 text-gray-300"></i>
							Aucun message de contact récent.
						</div>
					{% endfor %}
				</div>
			</div>
		</div>

		<!-- ==========================================
				     🏗️ ERP — PRODUCTION & FACTURATION
				     (une fois le devis signé : projets, budgets, facturation.)
				     ========================================== -->
		<div class="flex items-center gap-3 mb-4 mt-2">
			<div class="p-2.5 bg-blue-50 text-info rounded-xl shrink-0">
				<i class="ti ti-briefcase text-xl"></i>
			</div>
			<div>
				<h2 class="text-xl font-heading font-bold">ERP — Production & facturation</h2>
				<p class="text-xs text-brand-dark/50">Une fois le devis signé — projets en cours, facturation et journal d'activité</p>
			</div>
		</div>

		<!-- 📁 RÉPARTITION PAR STATUTS DES PROJETS -->
		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-8">
			{% for status, data in projectsByStatus %}
				<div class="bg-gray-50/60 border border-gray-100 rounded-xl p-4 text-center transition hover:bg-white hover:border-gray-200">
					<div class="text-xs font-semibold text-brand-dark/50 mb-1">{{ data.label }}</div>
					<div class="text-2xl font-bold {{ data.badgeClass|default('text-brand-dark') }}">
						{{ data.count }}
					</div>
					<div class="text-[10px] text-gray-400 mt-1">
						{{ stats.totalProjects|default(0) > 0 ? (data.count / stats.totalProjects * 100)|round(1) : 0 }}% du volume
					</div>
				</div>
			{% endfor %}
		</div>

		<!-- 🚨 ALERTES BUDGET PROJETS
		     (déjà calculées par le contrôleur, jamais affichées jusqu'ici) -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
			<div class="soft-card p-3.5">
				<div class="flex justify-between items-center mb-4">
					<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60 flex items-center gap-2">
						<i class="ti ti-alert-triangle text-danger"></i>
						En dépassement de budget
					</h2>
					<span class="text-xs font-bold text-danger">{{ overBudgetProjects|length }}</span>
				</div>
				<div class="divide-y divide-gray-100">
					{% for project in overBudgetProjects|slice(0, 5) %}
						<a href="{{ path('admin_project_read', {id: project.id}) }}" class="flex items-center justify-between py-3 first:pt-0 hover:opacity-70 transition">
							<div class="min-w-0">
								<h4 class="font-medium text-sm truncate">{{ project.title }}</h4>
								<p class="text-xs text-brand-dark/50 truncate">{{ project.owner.fullName ?? project.owner.email }}</p>
							</div>
							<span class="text-xs font-bold text-danger shrink-0 pl-3">{{ project.spent|money('EUR') }} / {{ project.budget|money('EUR') }}</span>
						</a>
					{% else %}
						<div class="text-center py-8 text-sm text-brand-dark/40">
							<i class="ti ti-circle-check text-2xl block mb-2 text-gray-300"></i>
							Aucun projet en dépassement.
						</div>
					{% endfor %}
				</div>
			</div>

			<div class="soft-card p-3.5">
				<div class="flex justify-between items-center mb-4">
					<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60 flex items-center gap-2">
						<i class="ti ti-gauge text-warning"></i>
						Budget presque épuisé
					</h2>
					<span class="text-xs font-bold text-warning">{{ lowBudgetProjects|length }}</span>
				</div>
				<div class="divide-y divide-gray-100">
					{% for project in lowBudgetProjects|slice(0, 5) %}
						<a href="{{ path('admin_project_read', {id: project.id}) }}" class="flex items-center justify-between py-3 first:pt-0 hover:opacity-70 transition">
							<div class="min-w-0">
								<h4 class="font-medium text-sm truncate">{{ project.title }}</h4>
								<p class="text-xs text-brand-dark/50 truncate">{{ project.owner.fullName ?? project.owner.email }}</p>
							</div>
							<span class="text-xs font-bold text-warning shrink-0 pl-3">{{ project.getBudgetPercentageUsed()|default(0) }}% utilisé</span>
						</a>
					{% else %}
						<div class="text-center py-8 text-sm text-brand-dark/40">
							<i class="ti ti-circle-check text-2xl block mb-2 text-gray-300"></i>
							Aucun projet à moins de 10% de budget restant.
						</div>
					{% endfor %}
				</div>
			</div>
		</div>

		<!-- 📅 CHRONOLOGIE DES ÉCHÉANCES & SANTÉ TECHNIQUE -->
		<div
			class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
			<!-- Prochaines Deadlines (2/3) -->
			<div class="soft-card p-3.5 lg:col-span-2">
				<div class="flex justify-between items-center mb-4">
					<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60">Jalons & Deadlines Imminentes</h2>
					<span class="text-xs text-brand-dark/40">15 prochains jours</span>
				</div>
				<div class="divide-y divide-gray-100">
					{% for entry in upcomingDeadlines %}
						{% set project = entry.project %}
						<div class="flex items-center justify-between py-3 first:pt-0">
							<div class="flex items-center gap-3">
								<div class="p-2 {{ entry.daysRemaining <= 3 ? 'bg-amber-50 text-amber-700' : 'bg-blue-50 text-brand-primary' }} rounded-xl text-xs font-bold text-center w-12 shrink-0">
									<span class="block text-base">{{ project.deadline|date('d') }}</span>
									{{ project.deadline|format_datetime(pattern: 'MMM', locale: 'fr')|capitalize }}
								</div>
								<div>
									<h4 class="font-medium text-sm">{{ project.title }}</h4>
									<p class="text-xs text-brand-dark/50">{{ project.owner.fullName ?? project.owner.email }} — {{ project.status.label }}</p>
								</div>
							</div>
							<span class="text-xs font-semibold px-2.5 py-1 {{ entry.daysRemaining <= 3 ? 'bg-amber-50 text-amber-800' : 'bg-blue-50 text-brand-primary' }} rounded-lg">
								{{ entry.daysRemaining == 0 ? 'Aujourd\'hui' : 'J-' ~ entry.daysRemaining }}
							</span>
						</div>
					{% else %}
						<div class="text-center py-8 text-sm text-brand-dark/40">
							<i class="ti ti-calendar-off text-2xl block mb-2 text-gray-300"></i>
							Aucune échéance dans les 15 prochains jours.
						</div>
					{% endfor %}
				</div>
			</div>

			<!-- Santé Serveur & Taux Support (1/3) -->
			<div class="soft-card p-3.5 flex flex-col justify-between">
				<div>
					<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60 mb-4">Santé Technique & Performance</h2>
					<div class="space-y-4">
						<div>
							<div class="flex items-center justify-between text-sm mb-1">
								<span class="text-brand-dark/70 flex items-center gap-2">
									<i class="ti ti-server text-brand-primary text-base"></i>
									Espace Disque Serveur
								</span>
								<span class="text-xs font-bold text-brand-dark/70">
									{{ diskUsedPercent is not null ? diskUsedPercent ~ '% utilisé' : 'Indisponible' }}
								</span>
							</div>
							{% if diskUsedPercent is not null %}
								<div class="w-full bg-gray-100 rounded-full h-1.5">
									<div class="{{ diskUsedPercent >= 90 ? 'bg-danger' : 'bg-brand-primary' }} h-1.5 rounded-full" style="width: {{ diskUsedPercent }}%"></div>
								</div>
							{% endif %}
						</div>
						<div class="flex items-center justify-between text-sm">
							<span class="text-brand-dark/70 flex items-center gap-2">
								<i class="ti ti-briefcase text-brand-primary text-base"></i>
								Projets en cours
							</span>
							<span class="text-xs font-bold text-brand-dark/70">{{ projectsByStatus['en_cours'].count|default(0) }}</span>
						</div>
					</div>
				</div>

				<!-- 4. SUPPORT ET PERFORMANCE (En bas du bloc technique) -->
				<div class="mt-4 pt-4 border-t border-gray-100 space-y-2">
					<div class="flex items-center justify-between text-xs">
						<span class="text-brand-dark/50">Conversion des Devis (acceptés / total) :</span>
						<span class="font-bold text-success">{{ quoteConversionRate }}%</span>
					</div>
				</div>
			</div>
		</div>

		<!-- 📈 ZONE GRAPHIQUES & TENDANCES -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
			<div class="soft-card p-3.5 lg:col-span-2">
				<div class="flex items-center justify-between mb-6">
					<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60">Évolution Financière Mensuelle</h2>
					<span class="text-xs text-brand-dark/40">CA vs Dépenses</span>
				</div>
				<div class="chart-container">
					<canvas id="expensesByMonthChart"></canvas>
				</div>
			</div>

			<div class="soft-card p-3.5">
				<div class="flex items-center justify-between mb-6">
					<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60">Volume Projets</h2>
					<i class="ti ti-chart-pie text-gray-400 text-lg"></i>
				</div>
				<div class="chart-container">
					<canvas id="projectsByStatusChart"></canvas>
				</div>
			</div>
		</div>

		<!-- 💎 TOP PROJETS + 👥 CLIENTS LES PLUS ACTIFS -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
			<div class="soft-card p-3.5 lg:col-span-2">
				<div class="flex justify-between items-center mb-4">
					<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60">Top Projets Stratégiques (Finances & Délais)</h2>
					<a href="{{ path('admin_dashboard_projects') }}" class="text-xs font-semibold text-brand-primary hover:underline">Voir tout</a>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm border-collapse">
						<thead>
							<tr class="border-b border-gray-100 text-brand-dark/40 text-xs font-bold uppercase tracking-wider">
								<th class="pb-3 font-semibold">Projet</th>
								<th class="pb-3 font-semibold">Client / Pilote</th>
								<th class="pb-3 font-semibold">Budget Total</th>
								<th class="pb-3 font-semibold">Progression Production</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-50">
							{% for project in topBudgetProjects|slice(0, 4) %}
								<tr>
									<td class="py-4 font-medium text-gray-900">{{ project.title }}</td>
									<td class="py-4 text-brand-dark/70">{{ project.owner.fullName ?? project.owner.email }}</td>
									<td class="py-4 font-semibold">{{ project.budget|money('EUR') }}</td>
									<td class="py-4">
										<div class="flex items-center gap-3 max-w-xs">
											<div class="w-full bg-gray-100 rounded-full h-2">
												<div class="bg-brand-primary h-2 rounded-full transition-all" style="width: {{ project.getBudgetPercentageUsed()|default(0) }}%"></div>
											</div>
											<span class="text-xs font-bold text-brand-dark/60">{{ project.getBudgetPercentageUsed()|default(0) }}%</span>
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Clients les plus actifs : déjà calculé par le contrôleur (propriétaires
			     de projets, triés par nombre de projets), jamais affiché jusqu'ici. -->
			<div class="soft-card p-3.5">
				<h2 class="text-xs font-heading font-bold uppercase tracking-wide text-brand-dark/60 mb-4">Clients les Plus Actifs</h2>
				<div class="divide-y divide-gray-100">
					{% for user in activeUsers %}
						<a href="{{ path('admin_users_read', {id: user.id}) }}" class="flex items-center gap-3 py-3 first:pt-0 hover:opacity-70 transition">
							<img class="h-9 w-9 rounded-xl border border-gray-100 shadow-sm" src="https://ui-avatars.com/api/?background=eaeaea&color=333&name={{ (user.fullName ?? user.email)|url_encode }}" alt="">
							<div class="flex-1 min-w-0">
								<h4 class="font-medium text-sm truncate">{{ user.fullName ?? user.email }}</h4>
								<p class="text-xs text-brand-dark/50 truncate">{{ user.ownedProjects|length }} projet{{ user.ownedProjects|length > 1 ? 's' : '' }}</p>
							</div>
						</a>
					{% else %}
						<div class="text-center py-8 text-sm text-brand-dark/40">
							<i class="ti ti-users text-2xl block mb-2 text-gray-300"></i>
							Aucun client avec un projet en cours.
						</div>
					{% endfor %}
				</div>
			</div>
		</div>

	</div>
{% endblock %}
