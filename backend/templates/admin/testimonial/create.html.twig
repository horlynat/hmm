{# templates/admin/testimonial/create.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Ajouter un témoignage
{% endblock %}

{% block body %}
	<div>

		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
			<div>
				<div class="flex items-center gap-2 text-xs font-bold text-brand-dark opacity-40 uppercase tracking-wider">
					<a href="{{ path('admin_testimonial_index') }}" class="hover:text-brand-primary transition-colors">Témoignages</a>
					<span class="ti ti-chevron-right text-xs" aria-hidden="true"></span>
					<span>Création</span>
				</div>
				<h1 class="text-3xl font-heading font-bold mt-1 flex items-center gap-2 text-brand-dark">
					<span class="ti ti-message-star text-brand-primary" aria-hidden="true"></span>
					<span>Nouveau témoignage</span>
				</h1>
			</div>

			<a href="{{ path('admin_testimonial_index') }}" class="btn btn-secondary gap-2 px-4 py-2">
				<span class="ti ti-arrow-left text-base" aria-hidden="true"></span>
				<span>Retour à la liste</span>
			</a>
		</div>

		{{ include('admin/testimonial/_form.html.twig', {'button_label': 'Ajouter le témoignage'}) }}

	</div>
{% endblock %}
