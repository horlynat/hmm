{% extends 'base.html.twig' %}

{% block title %}Gestion des compétences{% endblock %}

{% block body %}
	{% set sub = total ~ ' compétence' ~ (total > 1 ? 's' : '') ~ ' — expertise technique.' %}
	<twig:PageHeader title="Compétences" :subtitle="sub" icon="ti-code">
		<a href="{{ path('admin_skill_create') }}" class="btn btn-primary gap-2">
			<span class="ti ti-plus" aria-hidden="true"></span>
			<span>Ajouter une compétence</span>
		</a>
	</twig:PageHeader>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Liste des compétences</caption>
			<thead>
				<tr>
					<th scope="col" class="w-16">Id</th>
					<th scope="col">Nom</th>
					<th scope="col">Niveau</th>
					<th scope="col" class="w-40 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for skill in skills %}
					<tr>
						<td class="font-mono text-xs opacity-50">{{ skill.id }}</td>
						<td class="font-bold text-(--brand-dark)">{{ skill.name }}</td>
						<td><twig:Badge variant="info">{{ skill.level }}</twig:Badge></td>
						<td>
							<div class="flex items-center justify-end gap-1">
								<a href="{{ path('admin_skill_read', {'id': skill.id}) }}" class="btn btn-ghost btn-icon" aria-label="Voir {{ skill.name }}">
									<span class="ti ti-eye text-lg" aria-hidden="true"></span>
								</a>
								<a href="{{ path('admin_skill_update', {'id': skill.id}) }}" class="btn btn-ghost btn-icon text-amber-600" aria-label="Modifier {{ skill.name }}">
									<span class="ti ti-edit text-lg" aria-hidden="true"></span>
								</a>
								<twig:DeleteModal :id="skill.id" :action="path('admin_skill_delete', {id: skill.id})" :token="csrf_token('delete' ~ skill.id)" :label="skill.name" entity="cette compétence" />
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="4"><twig:EmptyState text="Aucune compétence trouvée." icon="ti-code" /></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	{% if totalPages > 1 %}
		<div class="flex justify-center mt-6">
			<twig:Pagination :currentPage="currentPage" :totalPages="totalPages" route="admin_skill_index" />
		</div>
	{% endif %}
{% endblock %}
