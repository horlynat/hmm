{% extends 'base.html.twig' %}

{% block title %}Finance — Dépenses{% endblock %}

{% block body %}
	<div>

		<!-- 📑 EN-TÊTE -->
		<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<h1 class="text-3xl font-heading font-bold flex items-center gap-2 text-brand-dark">
					<span class="ti ti-receipt text-brand-primary" aria-hidden="true"></span>
					<span>Dépenses</span>
				</h1>
				<p class="text-sm opacity-60 mt-1">Tous projets confondus — la soumission et l'approbation restent dans l'écran du projet concerné.</p>
			</div>
			<a href="{{ path('admin_finance_expenses_export', filters) }}" class="btn btn-secondary text-sm gap-2">
				<span class="ti ti-download" aria-hidden="true"></span> Export CSV
			</a>
		</div>

		<!-- 🔍 FILTRES -->
		<form method="get" class="soft-card p-4 mb-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
			<select name="status" class="input input-select text-sm">
				<option value="">Tous les statuts</option>
				{% for status in statuses %}
					<option value="{{ status.value }}" {{ filters.status == status.value ? 'selected' }}>{{ status.label }}</option>
				{% endfor %}
			</select>

			<select name="category" class="input input-select text-sm">
				<option value="">Toutes les catégories</option>
				{% for category in categories %}
					<option value="{{ category.value }}" {{ filters.category == category.value ? 'selected' }}>{{ category.label }}</option>
				{% endfor %}
			</select>

			<select name="project" class="input input-select text-sm">
				<option value="">Tous les projets</option>
				{% for p in projects %}
					<option value="{{ p.id }}" {{ filters.project == p.id ? 'selected' }}>{{ p.title }}</option>
				{% endfor %}
			</select>

			<select name="sort" class="input input-select text-sm">
				<option value="createdAt" {{ filters.sort == 'createdAt' ? 'selected' }}>Trier : date de saisie</option>
				<option value="spentAt" {{ filters.sort == 'spentAt' ? 'selected' }}>Trier : date de dépense</option>
				<option value="amount" {{ filters.sort == 'amount' ? 'selected' }}>Trier : montant</option>
				<option value="status" {{ filters.sort == 'status' ? 'selected' }}>Trier : statut</option>
				<option value="category" {{ filters.sort == 'category' ? 'selected' }}>Trier : catégorie</option>
			</select>

			<input type="number" step="0.01" name="min" value="{{ filters.min }}" placeholder="Montant min." class="input text-sm">
			<input type="number" step="0.01" name="max" value="{{ filters.max }}" placeholder="Montant max." class="input text-sm">
			<input type="date" name="start" value="{{ filters.start }}" class="input text-sm" aria-label="Depuis le">
			<input type="date" name="end" value="{{ filters.end }}" class="input text-sm" aria-label="Jusqu'au">

			<div class="flex gap-2 lg:col-span-4">
				<button type="submit" class="btn btn-primary text-sm">Filtrer</button>
				<a href="{{ path('admin_finance_expenses') }}" class="btn btn-secondary text-sm" title="Réinitialiser">
					<span class="ti ti-x text-base" aria-hidden="true"></span>
				</a>
			</div>
		</form>

		<!-- 📊 TABLEAU -->
		<div class="soft-card overflow-hidden">
			<table class="table">
				<thead>
					<tr>
						<th>Projet</th>
						<th>Catégorie</th>
						<th>Description</th>
						<th>Montant</th>
						<th>Statut</th>
						<th>Auteur</th>
						<th>Date</th>
						<th class="w-16 text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for expense in expenses %}
						<tr>
							<td class="text-sm font-semibold text-brand-dark">{{ expense.project.title }}</td>
							<td class="text-sm">
								<span class="ti {{ expense.category.icon }} opacity-60 mr-1" aria-hidden="true"></span>
								{{ expense.category.label }}
							</td>
							<td class="text-sm opacity-70">{{ expense.description|default('—') }}</td>
							<td class="text-sm font-semibold text-brand-dark">{{ expense.amount|money('EUR') }}</td>
							<td><twig:Badge :variant="expense.status.variant" icon="{{ expense.status.icon }}">{{ expense.status.label }}</twig:Badge></td>
							<td class="text-sm opacity-70">{{ expense.user.fullName ?? expense.user.email }}</td>
							<td class="text-sm opacity-70">{{ expense.effectiveDate|date('d/m/Y') }}</td>
							<td class="text-right">
								<a href="{{ path('admin_project_read', {id: expense.project.id}) }}" class="p-2 hover:bg-brand-light rounded-sm transition-colors text-brand-dark" title="Voir dans le projet">
									<span class="ti ti-eye text-lg block" aria-hidden="true"></span>
								</a>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="8" class="text-center py-12 opacity-40">Aucune dépense ne correspond aux critères.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<!-- 📄 PAGINATION -->
		{% if totalPages > 1 %}
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-4">
				<span class="text-sm text-gray-500">Page <strong>{{ page }}</strong> sur <strong>{{ totalPages }}</strong></span>
				<nav aria-label="Navigation des dépenses">
					<ul class="flex items-center gap-1">
						<li>
							<a class="btn btn-secondary text-sm py-1.5 px-3 {{ page == 1 ? 'pointer-events-none opacity-40' }}" href="{{ path('admin_finance_expenses', filters|merge({page: page - 1})) }}">Précédent</a>
						</li>
						{% for p in 1..totalPages %}
							<li>
								<a class="btn text-sm py-1.5 px-3 {{ p == page ? 'btn-primary' : 'btn-secondary' }}" href="{{ path('admin_finance_expenses', filters|merge({page: p})) }}">{{ p }}</a>
							</li>
						{% endfor %}
						<li>
							<a class="btn btn-secondary text-sm py-1.5 px-3 {{ page == totalPages ? 'pointer-events-none opacity-40' }}" href="{{ path('admin_finance_expenses', filters|merge({page: page + 1})) }}">Suivant</a>
						</li>
					</ul>
				</nav>
			</div>
		{% endif %}
	</div>
{% endblock %}
