{% extends 'base.html.twig' %}

{% block title %}Gestion des articles{% endblock %}

{% block body %}
	{% set sub = total ~ ' article' ~ (total > 1 ? 's' : '') ~ ' — blog & contenus.' %}
	<twig:PageHeader title="Articles" :subtitle="sub" icon="ti-news">
		<a href="{{ path('admin_article_create') }}" class="btn btn-primary gap-2">
			<span class="ti ti-plus" aria-hidden="true"></span>
			<span>Nouvel article</span>
		</a>
	</twig:PageHeader>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Liste des articles</caption>
			<thead>
				<tr>
					<th scope="col" class="w-16">Id</th>
					<th scope="col">Article</th>
					<th scope="col">Date</th>
					<th scope="col" class="w-32">Statut</th>
					<th scope="col" class="w-40 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for article in articles %}
					<tr>
						<td class="font-mono text-xs opacity-50">{{ article.id }}</td>
						<td class="max-w-md">
							<div class="font-semibold truncate">{{ article.title }}</div>
							<div class="text-xs opacity-40 truncate mt-0.5">{{ article.content|striptags }}</div>
						</td>
						<td class="text-xs opacity-70 whitespace-nowrap">
							{{ article.publishedAt ? article.publishedAt|date('d/m/Y') : '—' }}
						</td>
						<td>
							{% if article.publishedAt %}
								<twig:Badge variant="success" icon="ti-circle-check">Publié</twig:Badge>
							{% else %}
								<twig:Badge variant="warning" icon="ti-pencil">Brouillon</twig:Badge>
							{% endif %}
						</td>
						<td>
							<div class="flex items-center justify-end gap-1">
								<a href="{{ path('admin_article_read', {'slug': article.slug}) }}" class="btn btn-ghost btn-icon" aria-label="Voir {{ article.title }}">
									<span class="ti ti-eye text-lg" aria-hidden="true"></span>
								</a>
								<a href="{{ path('admin_article_update', {'slug': article.slug}) }}" class="btn btn-ghost btn-icon text-amber-600" aria-label="Modifier {{ article.title }}">
									<span class="ti ti-edit text-lg" aria-hidden="true"></span>
								</a>
								<twig:DeleteModal :id="article.id" :action="path('admin_article_delete', {slug: article.slug})" :token="csrf_token('delete' ~ article.id)" :label="article.title" entity="cet article" />
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="5"><twig:EmptyState text="Aucun article pour le moment." icon="ti-news" /></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	{% if totalPages > 1 %}
		<div class="flex justify-center mt-6">
			<twig:Pagination :currentPage="currentPage" :totalPages="totalPages" route="admin_article_index" />
		</div>
	{% endif %}
{% endblock %}
