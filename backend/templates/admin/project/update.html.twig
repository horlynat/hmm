{# templates/admin/project/update.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Modifier le projet : {{ project.title }}{% endblock %}

{% block body %}
<div class="space-y-4">

	<div class="flex flex-wrap justify-between items-center gap-4">
		<div class="min-w-0">
			<div class="flex items-center gap-2 text-xs font-semibold text-brand-dark/40 uppercase tracking-wider">
				<a href="{{ path('admin_project_index') }}" class="hover:text-brand-primary transition">Projets</a>
				<span class="ti ti-chevron-right text-xs" aria-hidden="true"></span>
				<a href="{{ path('admin_project_read', {id: project.id}) }}" class="hover:text-brand-primary transition truncate max-w-[30ch] inline-block align-bottom">{{ project.title }}</a>
				<span class="ti ti-chevron-right text-xs" aria-hidden="true"></span>
				<span>Édition</span>
			</div>
			<h1 class="text-3xl font-heading font-bold tracking-tight mt-1 flex items-center gap-2">
				<span class="ti ti-edit text-(--color-brand-primary)" aria-hidden="true"></span>
				<span class="truncate">Modifier « {{ project.title }} »</span>
			</h1>
		</div>

		<a href="{{ path('admin_project_read', {id: project.id}) }}" class="btn btn-secondary gap-2 shrink-0">
			<span class="ti ti-arrow-left text-sm" aria-hidden="true"></span> Retour au projet
		</a>
	</div>

	{{ include('admin/project/_form.html.twig', {'button_label': 'Mettre à jour le projet'}) }}

</div>
{% endblock %}
