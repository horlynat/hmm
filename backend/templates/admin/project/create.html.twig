{% extends 'base.html.twig' %}

{% block title %}Nouveau projet{% endblock %}

{% block body %}
<div class="container mx-auto max-w-3xl px-4 py-8 text-brand-dark">

    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 flex items-center space-x-2">
                <span class="ti ti-edit text-blue-600" aria-hidden="true"></span>
                <span>Nouveau projet</span>
            </h1>
            <p class="mt-1 text-sm opacity-60">Un assistant en 4 étapes pour ne rien oublier — informations, vitrine portfolio, gestion, puis médias.</p>
        </div>
        <a href="{{ path('admin_project_index') }}"
           class="px-5 py-2 bg-white border border-gray-200 text-gray-600 rounded-lg shadow-sm hover:bg-gray-50 transition flex items-center space-x-2">
            <span class="ti ti-arrow-left text-sm" aria-hidden="true"></span>
            <span>Retour</span>
        </a>
    </div>

    {% include 'admin/project/_form_wizard.html.twig' with {'button_label': 'Créer le projet'} %}

</div>
{% endblock %}
