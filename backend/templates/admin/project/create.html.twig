{% extends 'base.html.twig' %}

{% block title %}Ajouter un project{% endblock %}

{% block body %}
<div>

    <div class="flex justify-between items-center mb-8">
        <h1 class="text-2xl font-bold text-gray-800 flex items-center space-x-2">
            <span class="ti ti-edit text-blue-600" aria-hidden="true"></span>
            <span>Nouvelle publication</span>
        </h1>
        <a href="{{ path('admin_project_index') }}"
           class="px-5 py-2 bg-white border border-gray-200 text-gray-600 rounded-lg shadow-sm hover:bg-gray-50 transition flex items-center space-x-2">
            <span class="ti ti-arrow-left text-sm" aria-hidden="true"></span>
            <span>Retour</span>
        </a>
    </div>

    {# On passe button_label au fragment de formulaire #}
    {% include 'admin/project/_form.html.twig' with {'button_label': 'Ajouter l\'project'} %}

</div>
{% endblock %}