{% extends 'base.html.twig' %}

{% block title %}Nouveau projet{% endblock %}

{% block body %}
<div class="space-y-4">

	<div class="flex flex-wrap justify-between items-center gap-4">
		<div>
			<div class="flex items-center gap-2 text-xs font-semibold text-brand-dark/40 uppercase tracking-wider">
				<a href="{{ path('admin_project_index') }}" class="hover:text-brand-primary transition">Projets</a>
				<span class="ti ti-chevron-right text-xs" aria-hidden="true"></span>
				<span>Nouveau</span>
			</div>
			<h1 class="text-3xl font-heading font-bold tracking-tight mt-1 flex items-center gap-2">
				<span class="ti ti-folder-plus text-(--color-brand-primary)" aria-hidden="true"></span>
				Nouveau projet
			</h1>
			<p class="mt-1 text-sm opacity-60">Informations, vitrine portfolio, planification et médias — organisés en onglets, une seule soumission finale.</p>
		</div>
		<a href="{{ path('admin_project_index') }}" class="btn btn-secondary gap-2">
			<span class="ti ti-arrow-left text-sm" aria-hidden="true"></span> Retour
		</a>
	</div>

	{% include 'admin/project/_form.html.twig' with {'button_label': 'Créer le projet'} %}

</div>
{% endblock %}
