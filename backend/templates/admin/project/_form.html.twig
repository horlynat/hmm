{# templates/admin/project/_form.html.twig — formulaire projet unifié
   (création ET édition), en onglets plutôt qu'un assistant linéaire :
   contrairement à un wizard forcé pas-à-pas, on peut ici aller corriger
   directement l'onglet "Vitrine portfolio" sans re-traverser tout le
   formulaire — important en édition, où on ne touche souvent qu'une
   section précise. Réutilise le mécanisme d'onglets déjà en place sur
   read.html.twig (assets/js/project.js, [data-project-tabs]), déjà chargé
   globalement (importé dans app.js) : aucun JS supplémentaire nécessaire. #}
{% set tabBtn = 'group inline-flex items-center gap-2 px-4 py-2.5 -mb-px border-b-2 border-transparent text-sm font-semibold text-brand-dark/60 hover:text-brand-dark whitespace-nowrap cursor-pointer transition-colors aria-selected:border-(--color-brand-primary) aria-selected:text-(--color-brand-primary)' %}
{% set hasPlanning = form.priority is defined %}
{% set currentCover = project.info.coverImage ?? null %}

{# Oubliée lors de l'unification create/update (régression constatée en
   édition : plus aucun moyen de choisir la langue de saisie, donc plus de
   traduction automatique en direct vers l'autre langue) — présente dans
   l'ancien _form_wizard.html.twig, réintégrée ici pour les deux contextes.
   Cf. bilingual_field_controller.js pour le mécanisme complet. #}
<twig:LocaleToggle />

{{ form_start(form, {'attr': {'novalidate': 'novalidate'}, 'enctype': 'multipart/form-data'}) }}

<div data-project-tabs class="space-y-4">
	<div class="card !p-0 overflow-x-auto">
		<div role="tablist" class="flex border-b border-gray-100 dark:border-gray-800 px-2 min-w-max">
			<button type="button" role="tab" data-tab="infos" aria-selected="true" class="{{ tabBtn }}">
				<span class="ti ti-info-circle" aria-hidden="true"></span> Informations
			</button>
			<button type="button" role="tab" data-tab="showcase" aria-selected="false" class="{{ tabBtn }}">
				<span class="ti ti-presentation" aria-hidden="true"></span> Vitrine portfolio
			</button>
			{% if hasPlanning %}
				<button type="button" role="tab" data-tab="planning" aria-selected="false" class="{{ tabBtn }}">
					<span class="ti ti-calendar-stats" aria-hidden="true"></span> Planification
				</button>
			{% endif %}
			<button type="button" role="tab" data-tab="media" aria-selected="false" class="{{ tabBtn }}">
				<span class="ti ti-photo" aria-hidden="true"></span> Médias &amp; couverture
			</button>
		</div>
	</div>

	{# ============================== INFORMATIONS ============================== #}
	<section data-tab-panel="infos" role="tabpanel" class="space-y-4">
		<div class="card space-y-4">
			<twig:FieldPair :fr="form.title" :en="form.titleEn" />

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-controller="bilingual-field">
				<div>
					{{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
					<div class="rich-text-editor" data-controller="rich-text" data-rich-text-placeholder-value="Contexte en une phrase ou deux : pour qui, pourquoi, dans quel cadre." data-rich-text-min-height-value="160px">
						{{ form_widget(form.description, {'attr': {'class': 'hidden', 'data-rich-text-target': 'source', 'data-bilingual-field-target': 'fr', 'data-action': 'input->bilingual-field#scheduleFromFr'}}) }}
						<div data-rich-text-target="editor"></div>
					</div>
					{{ form_errors(form.description, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>

				<div>
					{{ form_label(form.descriptionEn, form.descriptionEn.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1 opacity-70'}}) }}
					<p class="text-[11px] opacity-40 mb-2">{{ form.descriptionEn.vars.help }}</p>
					<div class="rich-text-editor" data-controller="rich-text" data-rich-text-placeholder-value="Context in a sentence or two: for whom, why, in what setting." data-rich-text-min-height-value="120px">
						{{ form_widget(form.descriptionEn, {'attr': {'class': 'hidden', 'data-rich-text-target': 'source', 'data-bilingual-field-target': 'en', 'data-action': 'input->bilingual-field#scheduleFromEn'}}) }}
						<div data-rich-text-target="editor"></div>
					</div>
					{{ form_errors(form.descriptionEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
				<div>
					{{ form_label(form.link, 'Lien du projet (site en ligne, démo...)', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
					{{ form_widget(form.link, {'attr': {'class': 'input w-full text-sm', 'placeholder': 'https://monprojet.com'}}) }}
					{{ form_errors(form.link, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>

				<div>
					{{ form_label(form.skills, 'Technologies utilisées', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
					{{ form_widget(form.skills, {'attr': {'class': 'input w-full text-sm'}}) }}
					<p class="text-[11px] opacity-40 mt-2">Maintenez <kbd class="bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded text-[10px]">Ctrl</kbd> pour sélectionner plusieurs technologies.</p>
					{{ form_errors(form.skills, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
			</div>

			{# form.budget est TOUJOURS présent (ajouté sans condition dans
			   ProjectType, contrairement à priority/billingType/startedAt/deadline
			   qui eux dépendent de include_planning) — rendu ici, en dehors de
			   l'onglet Planification ci-dessous, pour rester atteignable en
			   édition aussi. L'oublier ici le fait réapparaître tout seul, sans
			   style, à la toute fin du formulaire via le rendu de secours de
			   form_end() — constaté en pratique. #}
			<div class="lg:max-w-[calc(50%-0.5rem)]">
				{{ form_label(form.budget, 'Budget alloué (€)', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
				{{ form_widget(form.budget, {'attr': {'class': 'input w-full text-sm', 'placeholder': '0.00'}}) }}
				<p class="text-[11px] opacity-40 mt-2">Requis (&gt; 0) pour pouvoir enregistrer des dépenses sur le projet.</p>
				{{ form_errors(form.budget, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
			</div>
		</div>
	</section>

	{# ============================== VITRINE PORTFOLIO ============================== #}
	<section data-tab-panel="showcase" role="tabpanel" class="space-y-4" hidden>
		<div class="card space-y-4">
			<div class="border-b border-gray-100 dark:border-gray-800 pb-3">
				<p class="text-sm opacity-60 mb-0">Ce contenu alimente la fiche publique du projet et les réponses de l'assistant IA aux visiteurs. Tous les champs sont optionnels, mais plus ils sont précis, plus la fiche est convaincante — et modifiable à tout moment, y compris après création.</p>
			</div>

			<twig:FieldPair :fr="form.role" :en="form.roleEn" />

			{# Objectifs/techStack/challenges/results portent un exemple concret en
			   plus de l'aide standard (syntaxe "un par ligne" ou "clé | valeur"
			   peu commune) — wiring bilingue manuel pour le conserver plutôt que
			   de passer par <twig:FieldPair />, qui ne rend que le help brut du
			   champ. #}
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-controller="bilingual-field">
				<div class="field">
					{{ form_label(form.objectives, form.objectives.vars.label, {'label_attr': {'class': 'field-label'}}) }}
					<p class="text-[11px] opacity-40 mb-1">{{ form.objectives.vars.help }} — Exemple : Réduire le temps de paiement de 40%</p>
					<p class="inline-flex items-center gap-1.5 text-xs font-mono bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-800 rounded px-2 py-1 mb-1.5">
						<span aria-hidden="true">📌</span> Format attendu : un objectif par ligne
					</p>
					{{ form_widget(form.objectives, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Simplifier le parcours d'achat sur mobile\nIntégrer un paiement fiable", 'data-bilingual-field-target': 'fr', 'data-action': 'input->bilingual-field#scheduleFromFr'}}) }}
					{{ form_errors(form.objectives, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
				<div class="field">
					{{ form_label(form.objectivesEn, form.objectivesEn.vars.label, {'label_attr': {'class': 'field-label opacity-70'}}) }}
					<p class="text-[11px] opacity-40 mb-1">{{ form.objectivesEn.vars.help }}</p>
					<p class="inline-flex items-center gap-1.5 text-xs font-mono bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-800 rounded px-2 py-1 mb-1.5">
						<span aria-hidden="true">📌</span> Expected format: one objective per line
					</p>
					{{ form_widget(form.objectivesEn, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Simplify the mobile purchase journey\nIntegrate reliable payment", 'data-bilingual-field-target': 'en', 'data-action': 'input->bilingual-field#scheduleFromEn'}}) }}
					{{ form_errors(form.objectivesEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-controller="bilingual-field">
				<div class="field">
					{{ form_label(form.techStack, form.techStack.vars.label, {'label_attr': {'class': 'field-label'}}) }}
					<p class="text-[11px] opacity-40 mb-1">{{ form.techStack.vars.help }} — Exemple : Next.js | Rendu rapide et bon référencement</p>
					<p class="inline-flex items-center gap-1.5 text-xs font-mono bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-800 rounded px-2 py-1 mb-1.5">
						<span aria-hidden="true">📌</span> Format : <strong class="font-semibold">Technologie&nbsp;|&nbsp;Pourquoi ce choix</strong> <span class="opacity-70">(la partie après « | » est facultative)</span>
					</p>
					{{ form_widget(form.techStack, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Next.js | Rendu rapide et bon référencement\nSymfony / API Platform | API robuste et typée", 'data-bilingual-field-target': 'fr', 'data-action': 'input->bilingual-field#scheduleFromFr'}}) }}
					{{ form_errors(form.techStack, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
				<div class="field">
					{{ form_label(form.techStackEn, form.techStackEn.vars.label, {'label_attr': {'class': 'field-label opacity-70'}}) }}
					<p class="text-[11px] opacity-40 mb-1">{{ form.techStackEn.vars.help }}</p>
					<p class="inline-flex items-center gap-1.5 text-xs font-mono bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-800 rounded px-2 py-1 mb-1.5">
						<span aria-hidden="true">📌</span> Format: <strong class="font-semibold">Technology&nbsp;|&nbsp;Why this choice</strong> <span class="opacity-70">(the part after "|" is optional)</span>
					</p>
					{{ form_widget(form.techStackEn, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Next.js | Fast rendering and good SEO\nSymfony / API Platform | Robust, typed API", 'data-bilingual-field-target': 'en', 'data-action': 'input->bilingual-field#scheduleFromEn'}}) }}
					{{ form_errors(form.techStackEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-controller="bilingual-field">
				<div class="field" data-controller="pair-format-hint">
					{{ form_label(form.challenges, form.challenges.vars.label, {'label_attr': {'class': 'field-label'}}) }}
					<p class="text-[11px] opacity-40 mb-1">{{ form.challenges.vars.help }} — c'est souvent le point le plus convaincant pour un recruteur.</p>
					<p class="inline-flex items-center gap-1.5 text-xs font-mono bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800 rounded px-2 py-1 mb-1.5">
						<span aria-hidden="true">📌</span> Format attendu, une ligne par défi : <strong class="font-semibold">Défi&nbsp;|&nbsp;Solution</strong>
					</p>
					{{ form_widget(form.challenges, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Éviter la survente lors des pics de commandes | Verrouillage optimiste du stock en base", 'data-bilingual-field-target': 'fr', 'data-pair-format-hint-target': 'input', 'data-action': 'input->bilingual-field#scheduleFromFr input->pair-format-hint#check'}}) }}
					<p class="hidden text-amber-600 dark:text-amber-500 text-xs mt-1" data-pair-format-hint-target="hint"></p>
					{{ form_errors(form.challenges, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
				<div class="field" data-controller="pair-format-hint">
					{{ form_label(form.challengesEn, form.challengesEn.vars.label, {'label_attr': {'class': 'field-label opacity-70'}}) }}
					<p class="text-[11px] opacity-40 mb-1">{{ form.challengesEn.vars.help }}</p>
					<p class="inline-flex items-center gap-1.5 text-xs font-mono bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800 rounded px-2 py-1 mb-1.5">
						<span aria-hidden="true">📌</span> Expected format, one line per challenge: <strong class="font-semibold">Challenge&nbsp;|&nbsp;Solution</strong>
					</p>
					{{ form_widget(form.challengesEn, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Avoiding overselling during order spikes | Optimistic stock locking at the database level", 'data-bilingual-field-target': 'en', 'data-pair-format-hint-target': 'input', 'data-action': 'input->bilingual-field#scheduleFromEn input->pair-format-hint#check'}}) }}
					<p class="hidden text-amber-600 dark:text-amber-500 text-xs mt-1" data-pair-format-hint-target="hint"></p>
					{{ form_errors(form.challengesEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-controller="bilingual-field">
				<div class="field">
					{{ form_label(form.results, form.results.vars.label, {'label_attr': {'class': 'field-label'}}) }}
					<p class="text-[11px] opacity-40 mb-1">{{ form.results.vars.help }} — Exemple : Temps de paiement | -40%</p>
					<p class="inline-flex items-center gap-1.5 text-xs font-mono bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-800 rounded px-2 py-1 mb-1.5">
						<span aria-hidden="true">📌</span> Format : <strong class="font-semibold">Indicateur&nbsp;|&nbsp;Valeur</strong> <span class="opacity-70">(la partie après « | » est facultative)</span>
					</p>
					{{ form_widget(form.results, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Temps de paiement | -40%\nTaux d'abandon panier | -25%", 'data-bilingual-field-target': 'fr', 'data-action': 'input->bilingual-field#scheduleFromFr'}}) }}
					{{ form_errors(form.results, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
				<div class="field">
					{{ form_label(form.resultsEn, form.resultsEn.vars.label, {'label_attr': {'class': 'field-label opacity-70'}}) }}
					<p class="text-[11px] opacity-40 mb-1">{{ form.resultsEn.vars.help }}</p>
					<p class="inline-flex items-center gap-1.5 text-xs font-mono bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-800 rounded px-2 py-1 mb-1.5">
						<span aria-hidden="true">📌</span> Format: <strong class="font-semibold">Metric&nbsp;|&nbsp;Value</strong> <span class="opacity-70">(the part after "|" is optional)</span>
					</p>
					{{ form_widget(form.resultsEn, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Payment time | -40%\nCart abandonment rate | -25%", 'data-bilingual-field-target': 'en', 'data-action': 'input->bilingual-field#scheduleFromEn'}}) }}
					{{ form_errors(form.resultsEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
			</div>

			<div class="lg:max-w-[calc(50%-0.5rem)]">
				{{ form_label(form.repoUrl, form.repoUrl.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
				{{ form_widget(form.repoUrl, {'attr': {'class': 'input w-full text-sm', 'placeholder': 'https://github.com/...'}}) }}
				{{ form_errors(form.repoUrl, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
			</div>
		</div>
	</section>

	{# ============================== PLANIFICATION (création uniquement) ============================== #}
	{% if hasPlanning %}
		<section data-tab-panel="planning" role="tabpanel" class="space-y-4" hidden>
			<div class="card space-y-4">
				<p class="text-sm opacity-60 mb-0">Données internes de suivi — jamais affichées publiquement. Modifiables ensuite depuis la fiche du projet (onglet Vue d'ensemble). Le budget se règle dans l'onglet Informations.</p>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
					<div>
						{{ form_label(form.priority, 'Priorité', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
						{{ form_widget(form.priority, {'attr': {'class': 'input input-select w-full text-sm'}}) }}
						{{ form_errors(form.priority, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
					</div>
					<div>
						{{ form_label(form.billingType, 'Type de facturation', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
						{{ form_widget(form.billingType, {'attr': {'class': 'input input-select w-full text-sm'}}) }}
						{{ form_errors(form.billingType, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
					</div>
					<div>
						{{ form_label(form.startedAt, 'Démarrage', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
						{{ form_widget(form.startedAt, {'attr': {'class': 'input w-full text-sm'}}) }}
						{{ form_errors(form.startedAt, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
					</div>
					<div>
						{{ form_label(form.deadline, 'Échéance', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
						{{ form_widget(form.deadline, {'attr': {'class': 'input w-full text-sm'}}) }}
						{{ form_errors(form.deadline, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
					</div>
				</div>
			</div>
		</section>
	{% endif %}

	{# ============================== MÉDIAS & COUVERTURE ============================== #}
	<section data-tab-panel="media" role="tabpanel" class="space-y-4" hidden>
		<div class="card space-y-4">
			<div>
				{{ form_label(form.coverImage, null, {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
				<p class="text-[11px] opacity-40 mb-2">{{ form.coverImage.vars.help }} — JPG, PNG, WebP ou SVG, 5 Mo max.</p>

				<div class="flex flex-col sm:flex-row items-start gap-4">
					{% if currentCover %}
						<div class="shrink-0">
							<img src="{{ currentCover.filePath }}" alt="{{ currentCover.altText }}" class="w-40 h-28 object-cover rounded-lg border border-gray-200 dark:border-gray-800">
							<label class="mt-2 flex items-center gap-2 text-xs text-danger cursor-pointer">
								{{ form_widget(form.removeCoverImage, {'attr': {'class': 'cursor-pointer'}}) }}
								Retirer l'image actuelle
							</label>
						</div>
					{% else %}
						{# Toujours rendre le champ (même sans rien à retirer) : sans ça,
						   form_end() ci-dessous le considère "non affiché" et l'ajoute tout
						   seul, sans style, en bas du formulaire — constaté sur la page de
						   création (aucune image existante → cette branche jamais prise). #}
						{{ form_widget(form.removeCoverImage, {'attr': {'hidden': 'hidden'}}) }}
					{% endif %}
					<div class="flex-1 min-w-0">
						{{ form_widget(form.coverImage, {'attr': {'class': 'w-full text-xs opacity-70 file:mr-3 file:py-2 file:px-3 file:rounded-sm file:border-0 file:text-xs file:font-bold file:bg-brand-light file:text-brand-primary hover:file:opacity-80 cursor-pointer'}}) }}
						<p class="text-[11px] opacity-40 mt-2">{{ currentCover ? 'Envoyer un fichier remplace automatiquement l\'image actuelle.' : 'Mise en avant en haut de la fiche publique du projet.' }}</p>
						{{ form_errors(form.coverImage, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
					</div>
				</div>
			</div>

			<div class="border-t border-gray-100 dark:border-gray-800 pt-4">
				{{ form_label(form.media, 'Images et documents (galerie)', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
				{{ form_widget(form.media, {'attr': {'class': 'w-full text-xs opacity-70 file:mr-3 file:py-2 file:px-3 file:rounded-sm file:border-0 file:text-xs file:font-bold file:bg-brand-light file:text-brand-primary hover:file:opacity-80 cursor-pointer'}}) }}
				<p class="text-[11px] opacity-40 mt-2">Formats : JPG, PNG, WebP, SVG, PDF (Max : 5 Mo). Consultables ensuite depuis l'onglet Médias de la fiche projet.</p>
				{{ form_errors(form.media, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
			</div>

			{# Promouvoir une photo déjà en galerie au rang de couverture — sans
			   ré-upload (cf. AdminProjectController::setCoverImage()). N'a de
			   sens qu'en édition : à la création, la galerie est encore vide,
			   rien à choisir avant le premier enregistrement. #}
			{% if project.id and project.media|length > 0 %}
				<div class="border-t border-gray-100 dark:border-gray-800 pt-4">
					<p class="block text-sm font-bold mb-2">Ou choisir la couverture parmi la galerie</p>
					<div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-3">
						{% for media in project.media %}
							{% if 'image' in media.mimeType %}
								<div class="relative group rounded-lg overflow-hidden border border-gray-100 dark:border-gray-800">
									<img src="{{ media.filePath }}" alt="{{ media.altText }}" class="aspect-square w-full object-cover">
									{% if currentCover and currentCover.id == media.id %}
										<span class="absolute inset-x-0 bottom-0 bg-(--color-brand-primary) text-white text-[10px] font-bold text-center py-1">Couverture actuelle</span>
									{% else %}
										<form method="POST" action="{{ path('admin_project_set_cover_image', {id: project.id, mediaId: media.id}) }}" class="absolute inset-x-0 bottom-0 opacity-0 group-hover:opacity-100 transition-opacity">
											<input type="hidden" name="_token" value="{{ csrf_token('admin_project_set_cover_' ~ media.id) }}">
											<button type="submit" class="w-full bg-black/70 text-white text-[10px] font-semibold text-center py-1.5 border-0 cursor-pointer hover:bg-black/85">
												Définir comme couverture
											</button>
										</form>
									{% endif %}
								</div>
							{% endif %}
						{% endfor %}
					</div>
				</div>
			{% endif %}
		</div>
	</section>
</div>

<div class="card flex items-center justify-end gap-3 sticky bottom-4">
	<a href="{{ project.id ? path('admin_project_read', {id: project.id}) : path('admin_project_index') }}" class="btn btn-secondary">Annuler</a>
	<button type="submit" class="btn btn-primary gap-2 group">
		<span class="ti ti-device-floppy text-sm transition-transform group-hover:scale-110" aria-hidden="true"></span>
		<span>{{ button_label|default('Enregistrer') }}</span>
	</button>
</div>

{{ form_end(form) }}
