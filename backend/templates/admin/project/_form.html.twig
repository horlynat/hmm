{# templates/admin/project/_form.html.twig #}
<twig:LocaleToggle />

{{ form_start(form, {
    'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'},
    'enctype': 'multipart/form-data'
}) }}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

	<!-- 📄 COLONNE PRINCIPALE : ÉCRITURE -->
	<div class="lg:col-span-2 space-y-6 card">
		{# Utilisation de ta classe .card #}

		<!-- Champ Titre -->
		<twig:FieldPair :fr="form.title" :en="form.titleEn" />

		<!-- Champ Description — wiring bilingue manuel (FieldPair ne gère que
		     les champs texte simples, pas l'éditeur riche Quill par-dessus) -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-controller="bilingual-field">
			<div>
				{{ form_label(form.description, 'Description complète', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
				<div class="rich-text-editor" data-controller="rich-text" data-rich-text-placeholder-value="Décrivez les objectifs, les livrables et le contexte..." data-rich-text-min-height-value="420px">
					{{ form_widget(form.description, {'attr': {'class': 'hidden', 'data-rich-text-target': 'source', 'data-bilingual-field-target': 'fr', 'data-action': 'input->bilingual-field#scheduleFromFr'}}) }}
					<div data-rich-text-target="editor"></div>
				</div>
				{{ form_errors(form.description, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
			</div>

			<div>
				{{ form_label(form.descriptionEn, form.descriptionEn.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1 opacity-70'}}) }}
				<p class="text-[11px] opacity-40 mb-2">{{ form.descriptionEn.vars.help }}</p>
				<div class="rich-text-editor" data-controller="rich-text" data-rich-text-placeholder-value="Describe the goals, deliverables and context..." data-rich-text-min-height-value="300px">
					{{ form_widget(form.descriptionEn, {'attr': {'class': 'hidden', 'data-rich-text-target': 'source', 'data-bilingual-field-target': 'en', 'data-action': 'input->bilingual-field#scheduleFromEn'}}) }}
					<div data-rich-text-target="editor"></div>
				</div>
				{{ form_errors(form.descriptionEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
			</div>
		</div>
	</div>

	<!-- ⚙️ COLONNE LATÉRALE : CONFIGURATION -->
		<div
		class="space-y-6"> <!-- Bloc Actions, Statut & Sauvegarde -->
		<div class="card space-y-4">
			<h3 class="text-xs font-bold uppercase tracking-wider opacity-40 border-b border-gray-100 pb-2 flex items-center gap-2">
				<span class="ti ti-bolt text-sm" aria-hidden="true"></span>
				Statut & Sauvegarde
			</h3>

			<div class="text-xs opacity-60 bg-brand-light/20 p-2.5 rounded-sm flex items-center gap-2">
				<span class="inline-block w-2 h-2 bg-warning rounded-full animate-pulse"></span>
				<span>Modifications locales prêtes</span>
			</div>

			{# Statut du projet (si configuré dans le formulaire projet) #}
			{% if form.status is defined %}
				<div>
					{{ form_label(form.status, 'Statut de départ', {'label_attr': {'class': 'block text-xs font-bold uppercase mb-2'}}) }}
					{{ form_widget(form.status, {'attr': {'class': 'input w-full text-xs'}}) }}
					{{ form_errors(form.status, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
			{% endif %}

			<div class="pt-2 flex flex-col gap-2">
				<button type="submit" class="btn btn-primary w-full gap-2 cursor-pointer group">
					<span class="ti ti-device-floppy text-sm transition-transform group-hover:scale-110" aria-hidden="true"></span>
					<span>{{ button_label|default('Enregistrer le projet') }}</span>
				</button>
				{% if cancel_path is defined %}
					<a href="{{ cancel_path }}" class="w-full inline-flex justify-center items-center px-4 py-2.5 bg-white border border-gray-200 text-brand-dark/70 text-sm font-semibold rounded-xl hover:bg-gray-50 transition-all cursor-pointer">
						Annuler
					</a>
				{% endif %}
			</div>
		</div>

		<!-- Bloc Budget -->
		<div class="card">
			{{ form_label(form.budget, 'Budget alloué (€)', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
			{{ form_widget(form.budget, {'attr': {'class': 'input w-full text-sm', 'placeholder': '0.00'}}) }}
			<p class="text-[11px] opacity-40 mt-2 leading-normal">Requis (&gt; 0) pour enregistrer des dépenses sur le projet.</p>
			{{ form_errors(form.budget, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
		</div>

		{# Bloc Paramètres & planning (présent uniquement à la création) #}
		{% if form.priority is defined %}
			<div class="card space-y-3">
				<h3 class="text-xs font-bold uppercase tracking-wider opacity-40 border-b border-gray-100 pb-2 flex items-center gap-2">
					<span class="ti ti-adjustments text-sm" aria-hidden="true"></span> Paramètres &amp; planning
				</h3>
				<div>
					{{ form_label(form.priority, 'Priorité', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
					{{ form_widget(form.priority, {'attr': {'class': 'input input-select w-full text-sm'}}) }}
					{{ form_errors(form.priority, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
				<div>
					{{ form_label(form.billingType, 'Type de facturation', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
					{{ form_widget(form.billingType, {'attr': {'class': 'input input-select w-full text-sm'}}) }}
					{{ form_errors(form.billingType, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
				</div>
				<div class="grid grid-cols-2 gap-2">
					<div>
						{{ form_label(form.startedAt, 'Démarrage', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
						{{ form_widget(form.startedAt, {'attr': {'class': 'input w-full text-sm'}}) }}
						{{ form_errors(form.startedAt, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
					</div>
					<div>
						{{ form_label(form.deadline, 'Échéance', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
						{{ form_widget(form.deadline, {'attr': {'class': 'input w-full text-sm'}}) }}
						{{ form_errors(form.deadline, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
					</div>
				</div>
			</div>
		{% endif %}

		<!-- Bloc Technologies / Skills -->
		<div class="card">
			<div class="flex items-center justify-between mb-2">
				{{ form_label(form.skills, 'Technologies utilisées', {'label_attr': {'class': 'block text-sm font-bold'}}) }}
			</div>

			{{ form_widget(form.skills, {'attr': {'class': 'input w-full text-sm'}}) }}
			<p class="text-[11px] opacity-40 mt-2 leading-normal">Maintenez
				<kbd class="bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded text-[10px]">Ctrl</kbd>
				pour faire plusieurs choix.</p>
			{{ form_errors(form.skills, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
		</div>

		<!-- Bloc Lien Externe (URL Démo/Prod) -->
		<div class="card">
			{{ form_label(form.link, 'Lien du projet', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
			{{ form_widget(form.link, {'attr': {'class': 'input w-full text-sm', 'placeholder': 'https://monprojet.com'}}) }}
			{{ form_errors(form.link, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
		</div>

		<!-- Bloc Couverture / Média -->
		<div class="card">
			{{ form_label(form.media, 'Image de couverture', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}

			{% if project is defined and project.media is not empty %}
				{% set uploadedMedia = project.media|first %}
				<div class="mb-3 rounded-md overflow-hidden border border-gray-100 max-h-36 flex items-center justify-center group relative">
					{# Media::$filePath contient déjà le chemin complet depuis la
					   racine web ("/uploads/projects/xxx.png", cf. MediaUploader::upload()
					   -> 'path' => '/uploads/'.$relativePath) — ne pas le repréfixer. #}
					<img src="{{ asset(uploadedMedia.filePath) }}" alt="{{ uploadedMedia.altText|default('Couverture') }}" class="object-cover h-full w-full transition group-hover:scale-105">
				</div>
			{% endif %}

			{{ form_widget(form.media, {'attr': {'class': 'w-full text-xs opacity-70 file:mr-3 file:py-2 file:px-3 file:rounded-sm file:border-0 file:text-xs file:font-bold file:bg-brand-light file:text-brand-primary hover:file:opacity-80 cursor-pointer'}}) }}
			<p class="text-[11px] opacity-40 mt-2">Formats : JPG, PNG, PDF (Max : 5 Mo).</p>
			{{ form_errors(form.media, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
		</div>

	</div>
</div>
{{ form_end(form) }}
