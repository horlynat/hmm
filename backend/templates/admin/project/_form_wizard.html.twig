{# templates/admin/project/_form_wizard.html.twig
   Assistant de création en 4 étapes — une seule soumission finale.
   Voir assets/controllers/wizard_controller.js pour la navigation. #}
{{ form_start(form, {
    'attr': {'class': 'space-y-6', 'novalidate': 'novalidate', 'data-controller': 'wizard'},
    'enctype': 'multipart/form-data'
}) }}

<!-- 🧭 Repère d'étapes -->
<div class="card">
    <ol class="flex items-center gap-2">
        {% set wizardSteps = ['Informations', 'Vitrine portfolio', 'Gestion & planning', 'Médias & envoi'] %}
        {% for label in wizardSteps %}
            <li class="flex flex-1 items-center gap-2">
                <span data-wizard-target="dot"
                      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold bg-gray-100 text-gray-400 transition-colors">
                    {{ loop.index }}
                </span>
                <span class="hidden text-xs font-semibold uppercase tracking-wide opacity-60 sm:inline">{{ label }}</span>
                {% if not loop.last %}
                    <span class="h-px flex-1 bg-gray-200"></span>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</div>

<!-- ============================== ÉTAPE 1 — INFORMATIONS GÉNÉRALES ============================== -->
<fieldset data-wizard-target="step" class="space-y-6">
    <div class="card space-y-4">
        <div class="border-b border-gray-100 pb-3">
            <span class="badge badge-info">Étape 1 sur 4</span>
            <h2 class="mt-2 text-lg font-bold">Informations générales</h2>
            <p class="mt-1 text-sm opacity-60">Le strict nécessaire pour identifier le projet : ce qui apparaît en premier sur la fiche.</p>
        </div>

        <div>
            {{ form_label(form.title, 'Titre du projet', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'input w-full text-lg font-semibold', 'placeholder': 'Ex : Refonte de la plateforme e-commerce...'}}) }}
            {{ form_errors(form.title, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.titleEn, form.titleEn.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1 opacity-70'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.titleEn.vars.help }}</p>
            {{ form_widget(form.titleEn, {'attr': {'class': 'input w-full text-sm', 'placeholder': 'Ex : E-commerce Platform Redesign...'}}) }}
            {{ form_errors(form.titleEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
            <div class="rich-text-editor" data-controller="rich-text" data-rich-text-placeholder-value="Contexte en une phrase ou deux : pour qui, pourquoi, dans quel cadre." data-rich-text-min-height-value="160px">
                {{ form_widget(form.description, {'attr': {'class': 'hidden', 'data-rich-text-target': 'source'}}) }}
                <div data-rich-text-target="editor"></div>
            </div>
            {{ form_errors(form.description, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.descriptionEn, form.descriptionEn.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1 opacity-70'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.descriptionEn.vars.help }}</p>
            <div class="rich-text-editor" data-controller="rich-text" data-rich-text-placeholder-value="Context in a sentence or two: for whom, why, in what setting." data-rich-text-min-height-value="120px">
                {{ form_widget(form.descriptionEn, {'attr': {'class': 'hidden', 'data-rich-text-target': 'source'}}) }}
                <div data-rich-text-target="editor"></div>
            </div>
            {{ form_errors(form.descriptionEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.link, 'Lien du projet (site en ligne, démo...)', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
            {{ form_widget(form.link, {'attr': {'class': 'input w-full text-sm', 'placeholder': 'https://monprojet.com'}}) }}
            {{ form_errors(form.link, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.skills, 'Technologies utilisées', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
            {{ form_widget(form.skills, {'attr': {'class': 'input w-full text-sm'}}) }}
            <p class="text-[11px] opacity-40 mt-2">Maintenez <kbd class="bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded text-[10px]">Ctrl</kbd> pour sélectionner plusieurs technologies.</p>
            {{ form_errors(form.skills, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>
    </div>
</fieldset>

<!-- ============================== ÉTAPE 2 — VITRINE PORTFOLIO ============================== -->
<fieldset data-wizard-target="step" class="space-y-6" hidden>
    <div class="card space-y-4">
        <div class="border-b border-gray-100 pb-3">
            <span class="badge badge-info">Étape 2 sur 4</span>
            <h2 class="mt-2 text-lg font-bold">Vitrine portfolio</h2>
            <p class="mt-1 text-sm opacity-60">Ce contenu alimente la fiche publique du projet et les réponses de l'assistant IA aux visiteurs. Tous les champs sont optionnels, mais plus ils sont précis, plus la fiche est convaincante.</p>
        </div>

        <div>
            {{ form_label(form.role, form.role.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
            {{ form_widget(form.role, {'attr': {'class': 'input w-full text-sm', 'placeholder': 'Ex : Développeur full-stack — conception et intégration de bout en bout'}}) }}
            {{ form_errors(form.role, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.roleEn, form.roleEn.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-2 opacity-70'}}) }}
            {{ form_widget(form.roleEn, {'attr': {'class': 'input w-full text-sm', 'placeholder': 'Ex : Full-stack developer — end-to-end design and integration'}}) }}
            {{ form_errors(form.roleEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.objectives, form.objectives.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.objectives.vars.help }} — Exemple : Réduire le temps de paiement de 40%</p>
            {{ form_widget(form.objectives, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Simplifier le parcours d'achat sur mobile\nIntégrer un paiement fiable"}}) }}
            {{ form_errors(form.objectives, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.objectivesEn, form.objectivesEn.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1 opacity-70'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.objectivesEn.vars.help }}</p>
            {{ form_widget(form.objectivesEn, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Simplify the mobile purchase journey\nIntegrate reliable payment"}}) }}
            {{ form_errors(form.objectivesEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.techStack, form.techStack.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.techStack.vars.help }} — Exemple : Next.js | Rendu rapide et bon référencement</p>
            {{ form_widget(form.techStack, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Next.js | Rendu rapide et bon référencement\nSymfony / API Platform | API robuste et typée"}}) }}
            {{ form_errors(form.techStack, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.techStackEn, form.techStackEn.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1 opacity-70'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.techStackEn.vars.help }}</p>
            {{ form_widget(form.techStackEn, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Next.js | Fast rendering and good SEO\nSymfony / API Platform | Robust, typed API"}}) }}
            {{ form_errors(form.techStackEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.challenges, form.challenges.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.challenges.vars.help }} — c'est souvent le point le plus convaincant pour un recruteur.</p>
            {{ form_widget(form.challenges, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Éviter la survente lors des pics de commandes | Verrouillage optimiste du stock en base"}}) }}
            {{ form_errors(form.challenges, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.challengesEn, form.challengesEn.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1 opacity-70'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.challengesEn.vars.help }}</p>
            {{ form_widget(form.challengesEn, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Avoiding overselling during order spikes | Optimistic stock locking at the database level"}}) }}
            {{ form_errors(form.challengesEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.results, form.results.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.results.vars.help }} — Exemple : Temps de paiement | -40%</p>
            {{ form_widget(form.results, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Temps de paiement | -40%\nTaux d'abandon panier | -25%"}}) }}
            {{ form_errors(form.results, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.resultsEn, form.resultsEn.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-1 opacity-70'}}) }}
            <p class="text-[11px] opacity-40 mb-2">{{ form.resultsEn.vars.help }}</p>
            {{ form_widget(form.resultsEn, {'attr': {'class': 'input textarea w-full h-24', 'placeholder': "Payment time | -40%\nCart abandonment rate | -25%"}}) }}
            {{ form_errors(form.resultsEn, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div>
            {{ form_label(form.repoUrl, form.repoUrl.vars.label, {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
            {{ form_widget(form.repoUrl, {'attr': {'class': 'input w-full text-sm', 'placeholder': 'https://github.com/...'}}) }}
            {{ form_errors(form.repoUrl, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>
    </div>
</fieldset>

<!-- ============================== ÉTAPE 3 — GESTION & PLANNING ============================== -->
<fieldset data-wizard-target="step" class="space-y-6" hidden>
    <div class="card space-y-4">
        <div class="border-b border-gray-100 pb-3">
            <span class="badge badge-info">Étape 3 sur 4</span>
            <h2 class="mt-2 text-lg font-bold">Gestion &amp; planification</h2>
            <p class="mt-1 text-sm opacity-60">Données internes de suivi — jamais affichées publiquement.</p>
        </div>

        <div>
            {{ form_label(form.budget, 'Budget alloué (€)', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
            {{ form_widget(form.budget, {'attr': {'class': 'input w-full text-sm', 'placeholder': '0.00'}}) }}
            <p class="text-[11px] opacity-40 mt-2">Requis (&gt; 0) pour pouvoir enregistrer des dépenses sur le projet.</p>
            {{ form_errors(form.budget, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                {{ form_label(form.priority, 'Priorité', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
                {{ form_widget(form.priority, {'attr': {'class': 'input input-select w-full text-sm'}}) }}
                {{ form_errors(form.priority, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
            </div>
            <div>
                {{ form_label(form.billingType, 'Type de facturation', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
                {{ form_widget(form.billingType, {'attr': {'class': 'input input-select w-full text-sm'}}) }}
                {{ form_errors(form.billingType, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                {{ form_label(form.startedAt, 'Démarrage', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
                {{ form_widget(form.startedAt, {'attr': {'class': 'input w-full text-sm'}}) }}
                {{ form_errors(form.startedAt, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
            </div>
            <div>
                {{ form_label(form.deadline, 'Échéance', {'label_attr': {'class': 'block text-sm font-bold mb-1'}}) }}
                {{ form_widget(form.deadline, {'attr': {'class': 'input w-full text-sm'}}) }}
                {{ form_errors(form.deadline, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
            </div>
        </div>
    </div>
</fieldset>

<!-- ============================== ÉTAPE 4 — MÉDIAS & ENVOI ============================== -->
<fieldset data-wizard-target="step" class="space-y-6" hidden>
    <div class="card space-y-4">
        <div class="border-b border-gray-100 pb-3">
            <span class="badge badge-info">Étape 4 sur 4</span>
            <h2 class="mt-2 text-lg font-bold">Médias &amp; envoi</h2>
            <p class="mt-1 text-sm opacity-60">Dernière étape : ajoutez une image de couverture, puis créez le projet.</p>
        </div>

        <div>
            {{ form_label(form.media, 'Images et documents', {'label_attr': {'class': 'block text-sm font-bold mb-2'}}) }}
            {{ form_widget(form.media, {'attr': {'class': 'w-full text-xs opacity-70 file:mr-3 file:py-2 file:px-3 file:rounded-sm file:border-0 file:text-xs file:font-bold file:bg-brand-light file:text-brand-primary hover:file:opacity-80 cursor-pointer'}}) }}
            <p class="text-[11px] opacity-40 mt-2">Formats : JPG, PNG, PDF (Max : 5 Mo).</p>
            {{ form_errors(form.media, {'attr': {'class': 'text-danger text-xs mt-1'}}) }}
        </div>
    </div>
</fieldset>

<!-- 🧭 Navigation -->
<div class="card flex items-center justify-between">
    <button type="button" data-wizard-target="prevBtn" data-action="wizard#prev"
            class="invisible inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-200 text-brand-dark/70 text-sm font-semibold rounded-xl hover:bg-gray-50 transition-all cursor-pointer">
        <span class="ti ti-arrow-left text-sm" aria-hidden="true"></span>
        <span>Précédent</span>
    </button>
    <button type="button" data-wizard-target="nextBtn" data-action="wizard#next" class="btn btn-primary gap-2">
        <span>Suivant</span>
        <span class="ti ti-arrow-right text-sm" aria-hidden="true"></span>
    </button>
    <button type="submit" data-wizard-target="submitBtn" class="hidden btn btn-primary gap-2 group">
        <span class="ti ti-device-floppy text-sm transition-transform group-hover:scale-110" aria-hidden="true"></span>
        <span>{{ button_label|default('Créer le projet') }}</span>
    </button>
</div>

{{ form_end(form) }}
