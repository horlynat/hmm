{# templates/admin/project/projects.html.twig — Centrale de gestion des projets #}
{% extends 'base.html.twig' %}

{% block title %}Centrale des projets — Administration{% endblock %}

{% block body %}
	{% set pctSpentGlobal = portfolio.totalBudget > 0 ? (portfolio.totalSpent / portfolio.totalBudget * 100) : 0 %}

	<div class="space-y-6">
		{# ================================================================= #}
		{# EN-TÊTE                                                           #}
		{# ================================================================= #}
		<div class="page-header">
			<div class="min-w-0">
				<h1 class="page-title flex items-center gap-2">
					<span class="ti ti-layout-dashboard text-(--brand-primary)" aria-hidden="true"></span>
					Centrale des projets
				</h1>
				<p class="page-subtitle">Pilotage du portefeuille : santé, budgets, échéances, charge et approbations.</p>
			</div>
			<a href="{{ path('admin_project_create') }}" class="btn btn-primary gap-2 shrink-0">
				<span class="ti ti-plus" aria-hidden="true"></span> Nouveau projet
			</a>
		</div>

		{# ================================================================= #}
		{# KPIs PORTEFEUILLE                                                 #}
		{# ================================================================= #}
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
			<div class="stat-tile">
				<div class="stat-tile__icon"><span class="ti ti-briefcase" aria-hidden="true"></span></div>
				<div>
					<div class="stat-tile__value">{{ portfolio.active }}</div>
					<div class="stat-tile__label">Projets actifs · {{ portfolio.total }} au total</div>
				</div>
			</div>
			<div class="stat-tile">
				<div class="stat-tile__icon"><span class="ti ti-wallet" aria-hidden="true"></span></div>
				<div>
					<div class="stat-tile__value">{{ portfolio.totalBudget|money('EUR') }}</div>
					<div class="stat-tile__label">Budget alloué</div>
				</div>
			</div>
			<div class="stat-tile">
				<div class="stat-tile__icon"><span class="ti ti-cash" aria-hidden="true"></span></div>
				<div>
					<div class="stat-tile__value">{{ portfolio.totalSpent|money('EUR') }}</div>
					<div class="stat-tile__label">Dépensé · {{ pctSpentGlobal|number_format(0) }}%</div>
				</div>
			</div>
			<div class="stat-tile">
				<div class="stat-tile__icon"><span class="ti ti-report-money" aria-hidden="true"></span></div>
				<div>
					<div class="stat-tile__value {{ portfolio.remainingBudget < 0 ? 'text-danger' : '' }}">{{ portfolio.remainingBudget|money('EUR') }}</div>
					<div class="stat-tile__label">Marge restante</div>
				</div>
			</div>
		</div>

		{# ================================================================= #}
		{# À TRAITER — alertes cliquables (raccourcis vers filtres)          #}
		{# ================================================================= #}
		<div>
			<h2 class="text-xs font-bold uppercase tracking-wider text-brand-dark/40 mb-2">À traiter</h2>
			<div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3">
				{% set alertCard = 'flex items-center gap-3 rounded-xl border p-3 transition hover:shadow-sm' %}

				<a href="{{ path('admin_project_index', {budget_status: 'over'}) }}" class="{{ alertCard }} {{ portfolio.overBudget > 0 ? 'bg-rose-50 border-rose-200' : 'bg-gray-50 border-gray-200' }}">
					<span class="ti ti-alert-triangle text-2xl {{ portfolio.overBudget > 0 ? 'text-rose-600' : 'text-gray-400' }}" aria-hidden="true"></span>
					<div><div class="text-xl font-extrabold text-brand-dark leading-none">{{ portfolio.overBudget }}</div><div class="text-[11px] text-brand-dark/60 mt-0.5">Budget dépassé</div></div>
				</a>

				<a href="{{ path('admin_project_index', {time_urgency: 'overdue'}) }}" class="{{ alertCard }} {{ portfolio.overdue > 0 ? 'bg-rose-50 border-rose-200' : 'bg-gray-50 border-gray-200' }}">
					<span class="ti ti-calendar-x text-2xl {{ portfolio.overdue > 0 ? 'text-rose-600' : 'text-gray-400' }}" aria-hidden="true"></span>
					<div><div class="text-xl font-extrabold text-brand-dark leading-none">{{ portfolio.overdue }}</div><div class="text-[11px] text-brand-dark/60 mt-0.5">En retard</div></div>
				</a>

				<a href="{{ path('admin_project_index', {time_urgency: 'imminent'}) }}" class="{{ alertCard }} {{ portfolio.dueThisWeek > 0 ? 'bg-amber-50 border-amber-200' : 'bg-gray-50 border-gray-200' }}">
					<span class="ti ti-clock-hour-4 text-2xl {{ portfolio.dueThisWeek > 0 ? 'text-amber-600' : 'text-gray-400' }}" aria-hidden="true"></span>
					<div><div class="text-xl font-extrabold text-brand-dark leading-none">{{ portfolio.dueThisWeek }}</div><div class="text-[11px] text-brand-dark/60 mt-0.5">Échéance &lt; 7j</div></div>
				</a>

				<div class="{{ alertCard }} {{ pendingApprovals.count > 0 ? 'bg-amber-50 border-amber-200' : 'bg-gray-50 border-gray-200' }}" title="{{ pendingApprovals.total|money('EUR') }} en attente">
					<span class="ti ti-clock-dollar text-2xl {{ pendingApprovals.count > 0 ? 'text-amber-600' : 'text-gray-400' }}" aria-hidden="true"></span>
					<div><div class="text-xl font-extrabold text-brand-dark leading-none">{{ pendingApprovals.count }}</div><div class="text-[11px] text-brand-dark/60 mt-0.5">Dépenses à approuver</div></div>
				</div>

				<a href="{{ path('admin_project_index', {orphan: 'no_client'}) }}" class="{{ alertCard }} {{ portfolio.noClient > 0 ? 'bg-gray-50 border-gray-300' : 'bg-gray-50 border-gray-200' }}">
					<span class="ti ti-user-off text-2xl {{ portfolio.noClient > 0 ? 'text-brand-dark/60' : 'text-gray-400' }}" aria-hidden="true"></span>
					<div><div class="text-xl font-extrabold text-brand-dark leading-none">{{ portfolio.noClient }}</div><div class="text-[11px] text-brand-dark/60 mt-0.5">Sans client</div></div>
				</a>

				<a href="{{ path('admin_project_index', {orphan: 'no_team'}) }}" class="{{ alertCard }} {{ portfolio.noTeam > 0 ? 'bg-gray-50 border-gray-300' : 'bg-gray-50 border-gray-200' }}">
					<span class="ti ti-users-minus text-2xl {{ portfolio.noTeam > 0 ? 'text-brand-dark/60' : 'text-gray-400' }}" aria-hidden="true"></span>
					<div><div class="text-xl font-extrabold text-brand-dark leading-none">{{ portfolio.noTeam }}</div><div class="text-[11px] text-brand-dark/60 mt-0.5">Sans équipe</div></div>
				</a>
			</div>
		</div>

		{# ================================================================= #}
		{# ANALYTICS : statuts · priorités · consommation budgétaire         #}
		{# ================================================================= #}
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			{# Répartition par statut (cartes-filtres) #}
			<div class="panel">
				<div class="panel-header"><h3 class="panel-title">Répartition par statut</h3></div>
				<div class="panel-body space-y-2">
					{% for statusKey, data in projectsByStatus %}
						<a href="{{ path('admin_project_index', {status: statusKey}) }}" class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 hover:bg-gray-50 dark:hover:bg-gray-800 transition {{ filters.status == statusKey ? 'ring-1 ring-(--brand-primary)' : '' }}">
							<span class="badge {{ data.badgeClass|default('bg-gray-400 text-white') }} text-xs">{{ data.label }}</span>
							<span class="font-bold text-brand-dark">{{ data.count }}</span>
						</a>
					{% endfor %}
				</div>
			</div>

			{# Répartition par priorité #}
			<div class="panel">
				<div class="panel-header"><h3 class="panel-title">Répartition par priorité</h3></div>
				<div class="panel-body space-y-3">
					{% set maxPrio = 1 %}
					{% for p in priorities %}{% if (byPriority[p.value] ?? 0) > maxPrio %}{% set maxPrio = byPriority[p.value] %}{% endif %}{% endfor %}
					{% for p in priorities %}
						{% set cnt = byPriority[p.value] ?? 0 %}
						<a href="{{ path('admin_project_index', {priority: p.value}) }}" class="block group">
							<div class="flex items-center justify-between text-sm mb-1">
								<span class="text-brand-dark/70 group-hover:text-brand-dark">{{ p.label }}</span>
								<span class="font-semibold text-brand-dark">{{ cnt }}</span>
							</div>
							<div class="w-full bg-gray-100 dark:bg-gray-800 rounded-full h-1.5">
								<div class="h-1.5 rounded-full bg-(--brand-primary)" style="width: {{ maxPrio > 0 ? (cnt / maxPrio * 100) : 0 }}%"></div>
							</div>
						</a>
					{% endfor %}
					{% if (byPriority[''] ?? 0) > 0 %}
						<div class="text-xs text-brand-dark/40 pt-1">{{ byPriority[''] }} projet(s) sans priorité définie.</div>
					{% endif %}
				</div>
			</div>

			{# Consommation budgétaire globale #}
			<div class="panel">
				<div class="panel-header"><h3 class="panel-title">Consommation budgétaire</h3></div>
				<div class="panel-body">
					<div class="flex items-end justify-between mb-2">
						<span class="text-2xl font-extrabold text-brand-dark">{{ pctSpentGlobal|number_format(0) }}%</span>
						<span class="text-xs text-brand-dark/60">{{ portfolio.totalSpent|money('EUR') }} / {{ portfolio.totalBudget|money('EUR') }}</span>
					</div>
					<div class="w-full bg-gray-100 dark:bg-gray-800 rounded-full h-3 overflow-hidden mb-3">
						<div class="h-3 rounded-full {{ pctSpentGlobal >= 100 ? 'bg-danger' : (pctSpentGlobal >= 80 ? 'bg-amber-500' : 'bg-(--brand-primary)') }}" style="width: {{ min(pctSpentGlobal, 100) }}%"></div>
					</div>
					<div class="grid grid-cols-2 gap-2 text-sm">
						<div class="flex items-center gap-2"><span class="ti ti-alert-triangle text-rose-600" aria-hidden="true"></span><span class="text-brand-dark/70">{{ portfolio.overBudget }} en dépassement</span></div>
						<div class="flex items-center gap-2"><span class="ti ti-alert-circle text-amber-600" aria-hidden="true"></span><span class="text-brand-dark/70">{{ portfolio.lowBudget }} en alerte (&lt;10%)</span></div>
					</div>
				</div>
			</div>
		</div>

		{# ================================================================= #}
		{# ÉCHÉANCES · CHARGE D'ÉQUIPE · ACTIVITÉ                            #}
		{# ================================================================= #}
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			{# Prochaines échéances #}
			<div class="panel">
				<div class="panel-header"><h3 class="panel-title">Prochaines échéances (14 j)</h3></div>
				<div class="panel-body">
					{% if upcomingDeadlines is empty %}
						<p class="text-sm text-gray-500 mb-0">Aucune échéance dans les 14 prochains jours.</p>
					{% else %}
						<ul class="space-y-2 mb-0">
							{% for p in upcomingDeadlines %}
								{% set dl = ((date(p.deadline)|date('U')) - (date('today')|date('U'))) // 86400 %}
								<li>
									<a href="{{ path('admin_project_read', {id: p.id}) }}" class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 hover:bg-gray-50 dark:hover:bg-gray-800 transition">
										<span class="min-w-0">
											<span class="block font-semibold text-sm text-brand-dark truncate">{{ p.title }}</span>
											<span class="block text-xs text-brand-dark/50">{{ p.deadline|date('d/m/Y') }}</span>
										</span>
										<span class="shrink-0 badge {{ dl <= 2 ? 'badge-danger' : (dl <= 7 ? 'badge-warning' : 'badge-neutral') }} text-xs">J-{{ dl }}</span>
									</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</div>
			</div>

			{# Charge d'équipe #}
			<div class="panel">
				<div class="panel-header"><h3 class="panel-title">Charge d'équipe (projets actifs)</h3></div>
				<div class="panel-body">
					{% if workload is empty %}
						<p class="text-sm text-gray-500 mb-0">Aucun collaborateur affecté à un projet actif.</p>
					{% else %}
						<ul class="space-y-2 mb-0">
							{% for w in workload %}
								<li>
									<a href="{{ path('admin_project_index', {collaborator: w.id}) }}" class="flex items-center gap-3 rounded-lg px-2 py-1.5 hover:bg-gray-50 dark:hover:bg-gray-800 transition">
										<span class="w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center font-bold text-brand-dark text-sm shrink-0">{{ (w.name ?? w.email)|first|upper }}</span>
										<span class="min-w-0 flex-1"><span class="block font-semibold text-sm text-brand-dark truncate">{{ w.name ?? w.email }}</span></span>
										<span class="shrink-0 badge badge-info text-xs">{{ w.cnt }} projet(s)</span>
									</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</div>
			</div>

			{# Activité récente #}
			<div class="panel">
				<div class="panel-header"><h3 class="panel-title">Activité récente</h3></div>
				<div class="panel-body">
					{% if recentHistory is not defined or recentHistory is empty %}
						<p class="text-sm text-gray-500 mb-0">Aucune activité récente.</p>
					{% else %}
						<ul class="space-y-2 mb-0 max-h-72 overflow-y-auto">
							{% for history in recentHistory %}
								<li>
									<a href="{{ path('admin_project_read', {id: history.project.id}) }}" class="flex items-start gap-2 rounded-lg px-2 py-1.5 hover:bg-gray-50 dark:hover:bg-gray-800 transition">
										<span class="text-base shrink-0 mt-0.5" aria-hidden="true">{{ history.getActionIcon() }}</span>
										<span class="min-w-0 flex-1">
											<span class="block text-xs text-brand-dark truncate"><strong>{{ history.getActionLabel() }}</strong> · {{ history.project.title }}</span>
											<span class="block text-[11px] text-brand-dark/40">{{ history.user.fullName ?? history.user.email }} — {{ history.createdAt|date('d/m H:i') }}</span>
										</span>
									</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</div>
			</div>
		</div>

		{# ================================================================= #}
		{# TABLEAU + FILTRES                                                 #}
		{# ================================================================= #}
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
			<div class="lg:col-span-9 space-y-6">
				<div class="panel overflow-hidden">
					<div class="panel-header flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
						<h3 class="panel-title mb-0">Projets ({{ totalItems }})</h3>
						<div class="flex items-center gap-2">
							<span class="text-gray-500 text-sm whitespace-nowrap">Trier :</span>
							<select class="input input-select text-sm py-1.5 auto-submit-trigger" name="sort" form="filter-sidebar-form" style="max-width: 150px;">
								<option value="createdAt" {{ filters.sort == 'createdAt' ? 'selected' }}>Création</option>
								<option value="title" {{ filters.sort == 'title' ? 'selected' }}>Nom</option>
								<option value="budget" {{ filters.sort == 'budget' ? 'selected' }}>Budget</option>
								<option value="progress" {{ filters.sort == 'progress' ? 'selected' }}>Avancement</option>
								<option value="deadline" {{ filters.sort == 'deadline' ? 'selected' }}>Échéance</option>
							</select>
							<select class="input input-select text-sm py-1.5 auto-submit-trigger" name="direction" form="filter-sidebar-form" style="max-width: 110px;">
								<option value="desc" {{ filters.direction == 'desc' ? 'selected' }}>↓ Desc</option>
								<option value="asc" {{ filters.direction == 'asc' ? 'selected' }}>↑ Asc</option>
							</select>
						</div>
					</div>

					<div class="overflow-x-auto">
						<table class="table mb-0">
							<thead>
								<tr>
									<th style="min-width: 220px; padding-left: 1.25rem;">Projet / Client</th>
									<th>Statut · Priorité</th>
									<th>Budget · Santé</th>
									<th>Avancement</th>
									<th>Échéance</th>
									<th class="text-right" style="padding-right: 1.25rem;">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for project in projects %}
									{% set closed = project.status.value in ['termine', 'suspendu'] %}
									{% set overdue = project.deadline and project.deadline < date() and not closed %}
									{% set pct = project.budget > 0 ? (project.spent / project.budget * 100) : 0 %}
									{% set health = project.spent > project.budget ? 'over' : (overdue ? 'late' : (pct >= 80 ? 'tight' : 'ok')) %}
									<tr>
										<td style="padding-left: 1.25rem;">
											<a href="{{ path('admin_project_read', {id: project.id}) }}" class="font-bold text-brand-dark hover:text-(--brand-primary) transition">{{ project.title }}</a>
											<div class="text-xs text-gray-500 flex items-center gap-1 mt-0.5">
												<span class="ti ti-user" aria-hidden="true"></span>{{ project.client ? (project.client.fullName ?? project.client.email) : 'Aucun client' }}
											</div>
										</td>
										<td>
											<span class="badge {{ project.status.badgeClass|default('bg-gray-400 text-white') }} text-xs">{{ project.status.label }}</span>
											{% if project.status.value == 'a_venir' %}
												<div class="mt-1"><span class="badge bg-amber-100 text-amber-800 text-xs gap-1" title="Visible dans l'espace « Projets disponibles » des freelances"><span class="ti ti-users-group" aria-hidden="true"></span> Espace freelance</span></div>
											{% endif %}
											{% if project.priority %}<div class="mt-1"><span class="badge {{ project.priority.badgeClass }} text-xs">{{ project.priority.label }}</span></div>{% endif %}
										</td>
										<td>
											<div class="text-sm text-brand-dark font-semibold">{{ project.budget|money('EUR') }}</div>
											<div class="mt-1">
												{% if health == 'over' %}<span class="badge badge-danger text-xs">Dépassé</span>
												{% elseif health == 'late' %}<span class="badge badge-danger text-xs">En retard</span>
												{% elseif health == 'tight' %}<span class="badge badge-warning text-xs">Tendu ({{ pct|number_format(0) }}%)</span>
												{% else %}<span class="badge badge-success text-xs">Sain</span>{% endif %}
											</div>
										</td>
										<td>
											<div class="flex items-center gap-2" style="min-width: 110px;">
												<div class="w-full rounded-full bg-gray-200 dark:bg-gray-700" style="height: 6px;">
													<div class="rounded-full bg-(--brand-primary)" style="height: 6px; width: {{ project.progress }}%;" role="progressbar" aria-valuenow="{{ project.progress }}" aria-valuemin="0" aria-valuemax="100"></div>
												</div>
												<span class="text-sm font-bold text-brand-dark">{{ project.progress }}%</span>
											</div>
										</td>
										<td>
											{% if project.deadline %}
												<span class="badge font-mono text-xs {{ overdue ? 'badge-danger' : 'badge-neutral' }}">{{ project.deadline|date('d/m/Y') }}</span>
											{% else %}
												<span class="text-gray-400 text-sm italic">—</span>
											{% endif %}
										</td>
										<td class="text-right" style="padding-right: 1.25rem;">
											<div class="flex items-center justify-end gap-1">
												<a href="{{ path('admin_project_read', {id: project.id}) }}" class="btn btn-ghost btn-icon btn-sm" title="Consulter"><span class="ti ti-eye" aria-hidden="true"></span></a>
												{% if not closed %}
													<a href="{{ path('admin_project_update', {id: project.id}) }}" class="btn btn-ghost btn-icon btn-sm text-amber-600" title="Modifier"><span class="ti ti-edit" aria-hidden="true"></span></a>
												{% endif %}
											</div>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="6" class="text-center py-10 text-gray-500">
											<span class="ti ti-mood-empty text-3xl block mb-2 opacity-50" aria-hidden="true"></span>
											<p class="mb-0 font-medium">Aucun projet ne correspond aux critères actuels.</p>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>

				{% if totalPages > 1 %}
					<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
						<span class="text-sm text-gray-500">Page <strong>{{ page }}</strong> sur <strong>{{ totalPages }}</strong></span>
						<nav aria-label="Navigation des projets">
							<ul class="flex items-center gap-1">
								<li><a class="btn btn-secondary text-sm py-1.5 px-3 {{ page == 1 ? 'pointer-events-none opacity-40' }}" href="{{ path('admin_project_index', filters|merge({ page: page - 1 })) }}">Précédent</a></li>
								{% for p in 1..totalPages %}
									<li><a class="btn text-sm py-1.5 px-3 {{ p == page ? 'btn-primary' : 'btn-secondary' }}" href="{{ path('admin_project_index', filters|merge({ page: p })) }}">{{ p }}</a></li>
								{% endfor %}
								<li><a class="btn btn-secondary text-sm py-1.5 px-3 {{ page == totalPages ? 'pointer-events-none opacity-40' }}" href="{{ path('admin_project_index', filters|merge({ page: page + 1 })) }}">Suivant</a></li>
							</ul>
						</nav>
					</div>
				{% endif %}
			</div>

			{# BARRE LATÉRALE DE FILTRAGE #}
			<aside class="lg:col-span-3" x-data="{ advancedOpen: {{ (filters.priority or filters.billing_type or filters.budget_status or filters.collaborator or filters.tag or filters.budget_min or filters.budget_max or filters.progress_min or filters.progress_max or filters.date_start or filters.date_end or filters.time_urgency or filters.inactive_days or filters.team_size or filters.orphan) ? 'true' : 'false' }} }">
				<div class="panel sticky top-4">
					<div class="panel-header flex items-center justify-between">
						<h6 class="panel-title mb-0">Filtres</h6>
						<a href="{{ path('admin_project_index') }}" class="text-sm text-danger font-medium" title="Réinitialiser tous les critères">Effacer</a>
					</div>

					<form id="filter-sidebar-form" method="GET" action="{{ path('admin_project_index') }}" class="panel-body space-y-3">
						<div>
							<label class="block text-sm font-semibold text-brand-dark mb-1">Recherche globale</label>
							<input type="text" name="search" class="input text-sm py-1.5 w-full" placeholder="Titre, description..." value="{{ filters.search }}">
						</div>
						<div>
							<label class="block text-sm font-semibold text-brand-dark mb-1">Statut</label>
							<select name="status" class="input input-select text-sm py-1.5 w-full">
								<option value="">Tous les statuts</option>
								{% for status in statuses %}<option value="{{ status.value }}" {{ filters.status == status.value ? 'selected' }}>{{ status.label }}</option>{% endfor %}
							</select>
						</div>
						<div>
							<label class="block text-sm font-semibold text-brand-dark mb-1">Client</label>
							<select name="client" class="input input-select text-sm py-1.5 w-full">
								<option value="">Tous les clients</option>
								{% for u in users %}<option value="{{ u.id }}" {{ filters.client == u.id ? 'selected' }}>{{ u.fullName ?? u.email }}</option>{% endfor %}
							</select>
						</div>

						<div x-show="advancedOpen" x-cloak class="space-y-3 pt-2 border-t border-gray-100 dark:border-gray-800">
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Priorité</label>
								<select name="priority" class="input input-select text-sm py-1.5 w-full">
									<option value="">Toutes</option>
									{% for priority in priorities %}<option value="{{ priority.value }}" {{ filters.priority == priority.value ? 'selected' }}>{{ priority.label }}</option>{% endfor %}
								</select>
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Type de facturation</label>
								<select name="billing_type" class="input input-select text-sm py-1.5 w-full">
									<option value="">Tous types</option>
									{% for type in billingTypes %}<option value="{{ type.value }}" {{ filters.billing_type == type.value ? 'selected' }}>{{ type.label }}</option>{% endfor %}
								</select>
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Santé budgétaire</label>
								<select name="budget_status" class="input input-select text-sm py-1.5 w-full">
									<option value="">Toutes</option>
									<option value="ok" {{ filters.budget_status == 'ok' ? 'selected' }}>Sain</option>
									<option value="low" {{ filters.budget_status == 'low' ? 'selected' }}>Alerte (&lt;10%)</option>
									<option value="over" {{ filters.budget_status == 'over' ? 'selected' }}>Dépassement</option>
								</select>
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Membre du staff</label>
								<select name="collaborator" class="input input-select text-sm py-1.5 w-full">
									<option value="">Tout le staff</option>
									{% for u in users %}<option value="{{ u.id }}" {{ filters.collaborator == u.id ? 'selected' }}>{{ u.fullName ?? u.email }}</option>{% endfor %}
								</select>
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Technologie / Tag</label>
								<select name="tag" class="input input-select text-sm py-1.5 w-full">
									<option value="">Tous les tags</option>
									{% for t in tags %}<option value="{{ t.id }}" {{ filters.tag == t.id ? 'selected' }}>{{ t.name }}</option>{% endfor %}
								</select>
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Tranche de budget (€)</label>
								<div class="grid grid-cols-2 gap-1">
									<input type="number" step="any" name="budget_min" class="input text-sm py-1.5 w-full" placeholder="Min" value="{{ filters.budget_min }}">
									<input type="number" step="any" name="budget_max" class="input text-sm py-1.5 w-full" placeholder="Max" value="{{ filters.budget_max }}">
								</div>
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Avancement (%)</label>
								<div class="grid grid-cols-2 gap-1">
									<input type="number" min="0" max="100" name="progress_min" class="input text-sm py-1.5 w-full" placeholder="Min" value="{{ filters.progress_min }}">
									<input type="number" min="0" max="100" name="progress_max" class="input text-sm py-1.5 w-full" placeholder="Max" value="{{ filters.progress_max }}">
								</div>
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Date de création</label>
								<input type="date" name="date_start" class="input text-sm py-1.5 w-full mb-1" value="{{ filters.date_start }}">
								<input type="date" name="date_end" class="input text-sm py-1.5 w-full" value="{{ filters.date_end }}">
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Proximité échéance</label>
								<select name="time_urgency" class="input input-select text-sm py-1.5 w-full">
									<option value="">Aucun critère</option>
									<option value="imminent" {{ filters.time_urgency == 'imminent' ? 'selected' }}>Imminent (&lt; 7 j)</option>
									<option value="overdue" {{ filters.time_urgency == 'overdue' ? 'selected' }}>En retard</option>
								</select>
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Inactivité (jours)</label>
								<input type="number" name="inactive_days" class="input text-sm py-1.5 w-full" placeholder="Ex : 30" value="{{ filters.inactive_days }}">
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Taille d'équipe</label>
								<select name="team_size" class="input input-select text-sm py-1.5 w-full">
									<option value="">Toutes</option>
									<option value="solo" {{ filters.team_size == 'solo' ? 'selected' }}>Seul (aucun staff)</option>
									<option value="small" {{ filters.team_size == 'small' ? 'selected' }}>Petite (1–3)</option>
									<option value="large" {{ filters.team_size == 'large' ? 'selected' }}>Grande (&gt; 3)</option>
								</select>
							</div>
							<div>
								<label class="block text-sm font-semibold text-brand-dark mb-1">Anomalies</label>
								<select name="orphan" class="input input-select text-sm py-1.5 w-full">
									<option value="">Aucune</option>
									<option value="no_client" {{ filters.orphan == 'no_client' ? 'selected' }}>Sans client</option>
									<option value="no_team" {{ filters.orphan == 'no_team' ? 'selected' }}>Sans staff</option>
								</select>
							</div>
						</div>

						<button type="button" class="text-sm text-gray-500 w-full text-center hover:text-(--brand-primary) cursor-pointer bg-transparent border-0" @click="advancedOpen = !advancedOpen">
							<span x-show="!advancedOpen">Plus de filtres…</span>
							<span x-show="advancedOpen" x-cloak>Masquer les filtres avancés</span>
						</button>
						<button type="submit" class="btn btn-primary w-full gap-2"><span class="ti ti-filter" aria-hidden="true"></span> Filtrer</button>
					</form>
				</div>
			</aside>
		</div>
	</div>
{% endblock %}
