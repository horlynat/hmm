{% extends 'base.html.twig' %}

{% block title %}Gestion des expériences{% endblock %}

{% block body %}
	{% set n = experiences|length %}
	<twig:PageHeader title="Expériences" :subtitle="n ~ ' expérience' ~ (n > 1 ? 's' : '') ~ ' — parcours professionnel.'" icon="ti-briefcase">
		<a href="{{ path('admin_experience_create') }}" class="btn btn-primary gap-2">
			<span class="ti ti-plus" aria-hidden="true"></span>
			<span>Ajouter une expérience</span>
		</a>
	</twig:PageHeader>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Liste des expériences professionnelles</caption>
			<thead>
				<tr>
					<th scope="col" class="w-16">Id</th>
					<th scope="col">Poste &amp; entreprise</th>
					<th scope="col" class="w-48">Période</th>
					<th scope="col" class="w-40 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for experience in experiences %}
					<tr>
						<td class="font-mono text-xs opacity-50">{{ experience.id }}</td>
						<td>
							<div class="font-bold truncate text-(--brand-dark)">{{ experience.role }}</div>
							<div class="text-xs opacity-70 flex items-center gap-1 mt-0.5">
								<span class="ti ti-building text-sm" aria-hidden="true"></span>
								{{ experience.company }}
							</div>
						</td>
						<td class="text-xs opacity-80 whitespace-nowrap">
							{{ experience.startDate ? experience.startDate|date('m/Y') : '—' }} — {{ experience.endDate ? experience.endDate|date('m/Y') : 'En cours' }}
						</td>
						<td>
							<div class="flex items-center justify-end gap-1">
								<a href="{{ path('admin_experience_read', {'id': experience.id}) }}" class="btn btn-ghost btn-icon" aria-label="Voir {{ experience.role }}">
									<span class="ti ti-eye text-lg" aria-hidden="true"></span>
								</a>
								<a href="{{ path('admin_experience_update', {'id': experience.id}) }}" class="btn btn-ghost btn-icon text-amber-600" aria-label="Modifier {{ experience.role }}">
									<span class="ti ti-edit text-lg" aria-hidden="true"></span>
								</a>
								<twig:DeleteModal :id="experience.id" :action="path('admin_experience_delete', {id: experience.id})" :token="csrf_token('delete' ~ experience.id)" :label="experience.role" entity="cette expérience" />
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="4"><twig:EmptyState text="Aucune expérience pour le moment." icon="ti-briefcase" /></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
