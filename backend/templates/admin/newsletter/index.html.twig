{% extends 'base.html.twig' %}

{% block title %}Abonnés newsletter{% endblock %}

{% block body %}
	<div class="page-header">
		<div class="min-w-0">
			<h1 class="page-title flex items-center gap-2">
				<span class="ti ti-mail-heart text-(--color-brand-primary)" aria-hidden="true"></span>
				Abonnés newsletter
				{% if pendingCount > 0 %}<twig:Badge variant="warning">{{ pendingCount }} en attente</twig:Badge>{% endif %}
			</h1>
			<p class="page-subtitle">{{ confirmedCount }} abonné{{ confirmedCount > 1 ? 's' : '' }} confirmé{{ confirmedCount > 1 ? 's' : '' }} — reçoivent une notification à chaque nouvel article ou projet publié.</p>
		</div>
	</div>

	<form method="get" role="search" class="panel panel-body mb-6 flex flex-col sm:flex-row gap-3 sm:items-end">
		<div class="flex-1">
			<label for="f-search" class="field-label">Recherche</label>
			<input id="f-search" type="search" name="search" value="{{ filters.search }}" placeholder="Adresse e-mail…" class="input w-full">
		</div>
		<div>
			<label for="f-status" class="field-label">Statut</label>
			<select id="f-status" name="status" class="input input-select">
				<option value="">Tous</option>
				<option value="confirmed" {% if filters.status == 'confirmed' %}selected{% endif %}>Confirmés</option>
				<option value="pending" {% if filters.status == 'pending' %}selected{% endif %}>En attente de confirmation</option>
				<option value="unsubscribed" {% if filters.status == 'unsubscribed' %}selected{% endif %}>Désinscrits</option>
			</select>
		</div>
		<button type="submit" class="btn btn-primary gap-2"><span class="ti ti-filter" aria-hidden="true"></span> Filtrer</button>
	</form>

	<div class="table-wrap">
		<table class="table">
			<caption class="sr-only">Abonnés à la newsletter</caption>
			<thead>
				<tr>
					<th scope="col" class="w-16">Id</th>
					<th scope="col">Statut</th>
					<th scope="col">Email</th>
					<th scope="col">Langue</th>
					<th scope="col">Inscrit le</th>
					<th scope="col">Confirmé le</th>
					<th scope="col" class="w-24 text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for subscriber in subscribers %}
					<tr>
						<td class="font-mono text-xs opacity-50">{{ subscriber.id }}</td>
						<td>
							{% if subscriber.unsubscribedAt %}
								<twig:Badge variant="neutral" icon="ti-mail-off">Désinscrit</twig:Badge>
							{% elseif subscriber.isConfirmed %}
								<twig:Badge variant="success" icon="ti-circle-check">Confirmé</twig:Badge>
							{% else %}
								<twig:Badge variant="warning" icon="ti-clock">En attente</twig:Badge>
							{% endif %}
						</td>
						<td class="font-medium">{{ subscriber.email }}</td>
						<td><twig:Badge variant="neutral">{{ subscriber.locale|upper }}</twig:Badge></td>
						<td class="text-sm opacity-70 whitespace-nowrap">{{ subscriber.subscribedAt ? subscriber.subscribedAt|date('d/m/Y H:i') : '—' }}</td>
						<td class="text-sm opacity-70 whitespace-nowrap">{{ subscriber.confirmedAt ? subscriber.confirmedAt|date('d/m/Y H:i') : '—' }}</td>
						<td>
							<div class="flex items-center justify-end gap-1">
								<twig:DeleteModal :id="subscriber.id" :action="path('admin_newsletter_delete', {id: subscriber.id})" :token="csrf_token('admin_newsletter_delete_' ~ subscriber.id)" :label="subscriber.email" entity="cet abonné" />
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="7"><twig:EmptyState text="Aucun abonné pour le moment." icon="ti-mail-off" /></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
