{% extends 'base.html.twig' %}

{% block title %}Contenu — Page d'accueil{% endblock %}

{% macro pair(fr, en, isTextarea = false) %}
	{% set widgetClass = isTextarea ? 'input textarea w-full' : 'input w-full' %}
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		<div class="field">
			{{ form_label(fr, null, {'label_attr': {'class': 'field-label'}}) }}
			{{ form_widget(fr, {'attr': {'class': widgetClass}}) }}
			{{ form_errors(fr, {'attr': {'class': 'field-error'}}) }}
		</div>
		<div class="field">
			{{ form_label(en, null, {'label_attr': {'class': 'field-label opacity-70'}}) }}
			{% if en.vars.help is defined and en.vars.help %}<p class="text-[11px] opacity-40 mb-1">{{ en.vars.help }}</p>{% endif %}
			{{ form_widget(en, {'attr': {'class': widgetClass}}) }}
			{{ form_errors(en, {'attr': {'class': 'field-error'}}) }}
		</div>
	</div>
{% endmacro %}

{% block body %}
	<twig:PageHeader title="Page d'accueil" subtitle="Hero, teaser à propos, pitch freelance et appel à l'action — bilingue FR/EN." icon="ti-home" />

	{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Hero</h2></div>
		<div class="panel-body space-y-4">
			{{ _self.pair(form.heroEyebrow, form.heroEyebrowEn) }}
			{{ _self.pair(form.heroTitle, form.heroTitleEn) }}
			{{ _self.pair(form.heroTitleAccent, form.heroTitleAccentEn) }}
			{{ _self.pair(form.heroSub, form.heroSubEn, true) }}
			{{ _self.pair(form.heroRoles, form.heroRolesEn, true) }}
			{{ _self.pair(form.founderBadge, form.founderBadgeEn) }}
			{{ _self.pair(form.diagramCaption, form.diagramCaptionEn) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Teaser "à propos"</h2></div>
		<div class="panel-body space-y-4">
			{{ _self.pair(form.aboutTitle, form.aboutTitleEn) }}
			{{ _self.pair(form.aboutP1, form.aboutP1En, true) }}
			{{ _self.pair(form.aboutP2, form.aboutP2En, true) }}
			{{ _self.pair(form.aboutHighlightTitle, form.aboutHighlightTitleEn) }}
			{{ _self.pair(form.aboutHighlightDesc, form.aboutHighlightDescEn, true) }}
			{{ _self.pair(form.aboutVisionText, form.aboutVisionTextEn, true) }}
			{{ _self.pair(form.aboutMissionText, form.aboutMissionTextEn, true) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Pitch freelance</h2></div>
		<div class="panel-body space-y-4">
			{{ _self.pair(form.freelanceTitle, form.freelanceTitleEn) }}
			{{ _self.pair(form.freelanceLede, form.freelanceLedeEn, true) }}
			{{ _self.pair(form.freelancePoint1, form.freelancePoint1En) }}
			{{ _self.pair(form.freelancePoint2, form.freelancePoint2En) }}
			{{ _self.pair(form.freelancePoint3, form.freelancePoint3En) }}
			{{ _self.pair(form.freelanceCardDesc, form.freelanceCardDescEn, true) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Appel à l'action final</h2></div>
		<div class="panel-body space-y-4">
			{{ _self.pair(form.contactCtaTitle, form.contactCtaTitleEn) }}
			{{ _self.pair(form.contactCtaSub, form.contactCtaSubEn, true) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-body flex items-center justify-between gap-4">
			{% if content.updatedAt %}
				<p class="text-xs opacity-60">
					Dernière mise à jour le {{ content.updatedAt|date('d/m/Y à H:i') }}
					{% if content.updatedBy %}par {{ content.updatedBy.fullName ?? content.updatedBy.email }}{% endif %}
				</p>
			{% else %}
				<span></span>
			{% endif %}
			<button type="submit" class="btn btn-primary gap-2">
				<span class="ti ti-device-floppy" aria-hidden="true"></span>
				<span>Enregistrer</span>
			</button>
		</div>
	</div>

	{{ form_end(form) }}
{% endblock %}
