{% extends 'base.html.twig' %}

{% block title %}Contenu — Page "À propos"{% endblock %}

{% macro pair(fr, en, isTextarea = false) %}
	{% set widgetClass = isTextarea ? 'input textarea w-full' : 'input w-full' %}
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		<div class="field">
			{{ form_label(fr, null, {'label_attr': {'class': 'field-label'}}) }}
			{{ form_widget(fr, {'attr': {'class': widgetClass}}) }}
			{{ form_errors(fr, {'attr': {'class': 'field-error'}}) }}
		</div>
		<div class="field">
			{{ form_label(en, null, {'label_attr': {'class': 'field-label opacity-70'}}) }}
			{% if en.vars.help is defined and en.vars.help %}<p class="text-[11px] opacity-40 mb-1">{{ en.vars.help }}</p>{% endif %}
			{{ form_widget(en, {'attr': {'class': widgetClass}}) }}
			{{ form_errors(en, {'attr': {'class': 'field-error'}}) }}
		</div>
	</div>
{% endmacro %}

{% block body %}
	<twig:PageHeader title='Page "À propos"' subtitle="Hero, profil, bio, vision, différenciateurs, à-côtés — bilingue FR/EN." icon="ti-user" />

	{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Hero</h2></div>
		<div class="panel-body space-y-4">
			{{ _self.pair(form.heroEyebrow, form.heroEyebrowEn) }}
			{{ _self.pair(form.heroTitle, form.heroTitleEn) }}
			{{ _self.pair(form.heroTitleAccent, form.heroTitleAccentEn) }}
			{{ _self.pair(form.heroSub, form.heroSubEn, true) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Carte profil</h2></div>
		<div class="panel-body space-y-4">
			<div class="field">
				{{ form_label(form.profileName, null, {'label_attr': {'class': 'field-label'}}) }}
				{{ form_widget(form.profileName, {'attr': {'class': 'input w-full'}}) }}
				{{ form_errors(form.profileName, {'attr': {'class': 'field-error'}}) }}
			</div>
			{{ _self.pair(form.profileRole, form.profileRoleEn) }}
			{{ _self.pair(form.profileAvailability, form.profileAvailabilityEn) }}
			{{ _self.pair(form.profileAlso, form.profileAlsoEn) }}
			{{ _self.pair(form.profileLocation, form.profileLocationEn) }}
			{{ _self.pair(form.profileWorkMode, form.profileWorkModeEn) }}
			{{ _self.pair(form.profileLanguages, form.profileLanguagesEn) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Bio</h2></div>
		<div class="panel-body space-y-4">
			{{ _self.pair(form.bioTitle, form.bioTitleEn) }}
			{{ _self.pair(form.bioP1, form.bioP1En, true) }}
			{{ _self.pair(form.bioP2, form.bioP2En, true) }}
			{{ _self.pair(form.bioP3, form.bioP3En, true) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Vision</h2></div>
		<div class="panel-body space-y-4">
			{{ _self.pair(form.visionTitle, form.visionTitleEn) }}
			{{ _self.pair(form.visionLede, form.visionLedeEn, true) }}
			{{ _self.pair(form.visionTodayText, form.visionTodayTextEn, true) }}
			{{ _self.pair(form.visionTomorrowText, form.visionTomorrowTextEn, true) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Pourquoi moi (4 différenciateurs)</h2></div>
		<div class="panel-body space-y-4">
			<hr class="border-gray-100">
			{{ _self.pair(form.why1Title, form.why1TitleEn) }}
			{{ _self.pair(form.why1Desc, form.why1DescEn, true) }}
			<hr class="border-gray-100">
			{{ _self.pair(form.why2Title, form.why2TitleEn) }}
			{{ _self.pair(form.why2Desc, form.why2DescEn, true) }}
			<hr class="border-gray-100">
			{{ _self.pair(form.why3Title, form.why3TitleEn) }}
			{{ _self.pair(form.why3Desc, form.why3DescEn, true) }}
			<hr class="border-gray-100">
			{{ _self.pair(form.why4Title, form.why4TitleEn) }}
			{{ _self.pair(form.why4Desc, form.why4DescEn, true) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Au-delà du code</h2></div>
		<div class="panel-body space-y-4">
			{{ _self.pair(form.beyondLanguages, form.beyondLanguagesEn, true) }}
			{{ _self.pair(form.beyondInterests, form.beyondInterestsEn, true) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-header"><h2 class="panel-title">Appel à l'action final</h2></div>
		<div class="panel-body space-y-4">
			{{ _self.pair(form.ctaTitle, form.ctaTitleEn) }}
			{{ _self.pair(form.ctaSub, form.ctaSubEn, true) }}
		</div>
	</div>

	<div class="panel">
		<div class="panel-body flex items-center justify-between gap-4">
			{% if content.updatedAt %}
				<p class="text-xs opacity-60">
					Dernière mise à jour le {{ content.updatedAt|date('d/m/Y à H:i') }}
					{% if content.updatedBy %}par {{ content.updatedBy.fullName ?? content.updatedBy.email }}{% endif %}
				</p>
			{% else %}
				<span></span>
			{% endif %}
			<button type="submit" class="btn btn-primary gap-2">
				<span class="ti ti-device-floppy" aria-hidden="true"></span>
				<span>Enregistrer</span>
			</button>
		</div>
	</div>

	{{ form_end(form) }}
{% endblock %}
