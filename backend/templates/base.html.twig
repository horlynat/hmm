<!DOCTYPE html>
{% set settings = systemSettingRepository.getSettings() %}
<html lang="{{ settings.defaultLocale }}" class="{{ settings.theme.value == 'dark' ? 'dark' : '' }}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}{{ settings.siteName }}{% endblock %}
		</title>

		{% if settings.theme.value == 'auto' %}
			{# Appliqué avant le premier paint pour éviter un flash de mauvais thème :
			   le rendu serveur ne peut pas connaître la préférence système du navigateur. #}
			<script>
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					document.documentElement.classList.add('dark');
				}
			</script>
		{% endif %}

		<style>
			:root { --color-brand-primary: {{ settings.primaryColor }}; }
		</style>

		{% if settings.logoPath %}
			{# Pas de type= figé : le logo peut être SVG, PNG, JPG ou WEBP selon ce qui est
			   téléversé dans Paramètres > Configuration (voir SystemSettingType::logoFile). #}
			<link rel="icon" href="{{ settings.logoPath }}">
		{% else %}
			<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% endif %}

		{# Polices de marque (référencées par app.css : Inter/Nunito/JetBrains Mono).
		   CSP OK : style-src fonts.googleapis.com, font-src fonts.gstatic.com. #}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Nunito:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

		{# Icônes Tabler : webfont vendorée (assets/vendor/tabler), Alpine.js
		   (build CSP) + plugin collapse : tout est bundlé par Vite dans l'entrée
		   `app` (assets/app.js) et servi en 'self'. Plus aucun <script>/<link>
		   vers un CDN tiers ici — cf. config/packages/nelmio_security.yaml. #}
		{% block stylesheets %}
			{{ vite_entry_link_tags('app') }}
		{% endblock %}

		{% block javascripts %}
			{{ vite_entry_script_tags('app') }}
		{% endblock %}
	</head>
	<body class="flex h-screen bg-(--color-bg-default) text-(--color-brand-dark) overflow-hidden relative" x-data="{ mobileSidebarOpen: false }">
		{# ♿ Lien d'évitement : premier élément focusable, mène directement au contenu #}
		<a href="#contenu" class="skip-link">Aller au contenu principal</a>

		{# 🟦 OVERLAY MOBILE : Assombrit l'écran quand le menu est ouvert sur mobile #}
		<div x-show="mobileSidebarOpen" @click="mobileSidebarOpen = false" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 bg-black/40 z-40 md:hidden backdrop-blur-sm"></div>

		{# 🏢 BARRE LATÉRALE DYNAMIQUE #}
		{% include '_partials/_admin.nav.html.twig' %}

		{# 💻 ZONE DE CONTENU PRINCIPALE #}
		<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
			{% include '_partials/_header.html.twig' %}

			{# Zone de défilement isolée pour éviter que toute la page ne bouge #}
			<div class="flex-1 overflow-y-auto p-4 md:p-6 space-y-4">
				{% include '_partials/_flashes.html.twig' %}

				<main id="contenu" tabindex="-1" class="animate-fade-in focus:outline-none">
					{% block body %}{% endblock %}
				</main>
			</div>
		</div>
	</body>
</html>
