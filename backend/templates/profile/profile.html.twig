{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ vite_entry_link_tags('profile') }}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ vite_entry_script_tags('profile') }}
{% endblock %}

{% block body %}

	{% include 'profile/_profile_banner.html.twig' %}

	<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-4 items-start">
		{% include 'profile/_profile_info.html.twig' %}
		{% include 'profile/_profile_security.html.twig' %}
	</div>

	{% if 'ROLE_EDITOR' in user.roles %}
		<div class="mt-4">
			{% include 'profile/_profile_collaborator.html.twig' %}
		</div>
	{% endif %}

	<div class="mt-4">
		{% include 'profile/_profile_activity.html.twig' %}
	</div>

{% endblock %}
