<!DOCTYPE html>
{% set settings = systemSettingRepository.getSettings() %}
{% set currentRoute = app.request.attributes.get('_route') %}
<html lang="{{ settings.defaultLocale }}" class="{{ settings.theme.value == 'dark' ? 'dark' : '' }}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% block title %}Mon espace{% endblock %} — {{ settings.siteName }}</title>

		<style>:root { --color-brand-primary: {{ settings.primaryColor }}; }</style>

		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📁</text></svg>">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Nunito:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

		{% block stylesheets %}{{ vite_entry_link_tags('app') }}{% endblock %}
		<script src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js" defer></script>
		<script src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3.x.x/dist/cdn.min.js" defer></script>
		{% block javascripts %}{{ vite_entry_script_tags('app') }}{% endblock %}
	</head>
	<body class="flex h-screen bg-(--bg-default) text-(--brand-dark) overflow-hidden relative" x-data="{ mobileSidebarOpen: false }">
		<a href="#contenu" class="skip-link">Aller au contenu principal</a>

		<div x-show="mobileSidebarOpen" @click="mobileSidebarOpen = false" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 bg-black/40 z-40 md:hidden backdrop-blur-sm"></div>

		<!-- 🧭 SIDEBAR ESPACE MEMBRE -->
		<aside class="fixed inset-y-0 left-0 z-50 w-64 h-full bg-(--bg-default) border-r border-gray-200 dark:border-gray-800 flex flex-col transition-transform duration-300 ease-in-out
					       md:translate-x-0 md:static md:h-screen shadow-xl md:shadow-none" :class="mobileSidebarOpen ? 'translate-x-0' : '-translate-x-full'" aria-label="Navigation de l'espace membre">
			<div class="p-6 border-b border-gray-200 dark:border-gray-800 flex items-center gap-3 justify-between shrink-0">
				<a href="{{ path('member_project_index') }}" class="flex items-center gap-3 min-w-0">
					<span class="ti ti-briefcase text-2xl text-(--brand-primary) shrink-0" aria-hidden="true"></span>
					<div class="min-w-0">
						<h1 class="text-lg font-heading font-bold text-(--brand-dark) truncate">{{ settings.siteName }}</h1>
						<p class="text-xs text-(--brand-dark)/60 truncate">Espace membre</p>
					</div>
				</a>
				<button type="button" @click="mobileSidebarOpen = false" class="md:hidden p-1 rounded-lg text-(--brand-dark) hover:bg-gray-100 dark:hover:bg-gray-800" aria-label="Fermer le menu">
					<span class="ti ti-x text-xl" aria-hidden="true"></span>
				</button>
			</div>

			<nav class="flex-1 p-4 space-y-1 overflow-y-auto text-sm">
				<a href="{{ path('member_project_index') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-(--brand-dark) hover:bg-brand-light/20 hover:text-(--brand-primary) transition {% if currentRoute starts with 'member_project' %}bg-brand-light/30 text-(--brand-primary) font-semibold{% endif %}">
					<span class="ti ti-layout-dashboard text-lg" aria-hidden="true"></span>
					Tableau de bord
				</a>
				<a href="{{ path('member_quote_index') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-(--brand-dark) hover:bg-brand-light/20 hover:text-(--brand-primary) transition {% if currentRoute starts with 'member_quote' %}bg-brand-light/30 text-(--brand-primary) font-semibold{% endif %}">
					<span class="ti ti-file-invoice text-lg" aria-hidden="true"></span>
					Mes devis
				</a>

				<p class="text-[10px] uppercase text-(--brand-dark)/50 font-bold mt-5 mb-1.5 ml-3 tracking-wider">Mon compte</p>
				<a href="{{ path('member_profile_read') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-(--brand-dark) hover:bg-brand-light/20 hover:text-(--brand-primary) transition {% if currentRoute starts with 'member_profile_read' or currentRoute starts with 'member_profile_update' %}bg-brand-light/30 text-(--brand-primary) font-semibold{% endif %}">
					<span class="ti ti-user-circle text-lg" aria-hidden="true"></span>
					Mon profil
				</a>
				<a href="{{ path('profile_two_factor_index') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium text-(--brand-dark) hover:bg-brand-light/20 hover:text-(--brand-primary) transition {% if currentRoute starts with 'profile_two_factor' %}bg-brand-light/30 text-(--brand-primary) font-semibold{% endif %}">
					<span class="ti ti-shield-lock text-lg" aria-hidden="true"></span>
					Sécurité &amp; 2FA
				</a>
			</nav>

			<div class="p-4 border-t border-gray-200 dark:border-gray-800 shrink-0">
				<div class="flex items-center gap-2.5 mb-3 min-w-0">
					<span class="flex h-8 w-8 items-center justify-center rounded-full text-xs font-bold text-white shadow-inner shrink-0" style="background: var(--color-brand-primary)" aria-hidden="true">
						{{ (app.user.fullName ?? app.user.email)|slice(0, 1)|upper }}
					</span>
					<div class="min-w-0">
						<p class="text-xs font-bold text-(--brand-dark) truncate">{{ app.user.fullName ?? app.user.email }}</p>
						<p class="text-[11px] text-gray-400 truncate">{{ app.user.email }}</p>
					</div>
				</div>
				<a href="{{ path('logout') }}" class="btn btn-secondary btn-sm w-full gap-1.5">
					<span class="ti ti-logout" aria-hidden="true"></span>
					Déconnexion
				</a>
			</div>
		</aside>

		<!-- 💻 ZONE DE CONTENU -->
		<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
			<header class="flex items-center gap-3 bg-white/85 dark:bg-gray-900/85 backdrop-blur-md px-4 md:px-6 py-3 border-b border-gray-200 dark:border-gray-800 sticky top-0 z-30 md:hidden">
				<button type="button" @click="mobileSidebarOpen = true"
						class="p-2 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
						aria-label="Ouvrir le menu de navigation">
					<span class="ti ti-menu-2 text-2xl" aria-hidden="true"></span>
				</button>
				<span class="font-bold text-(--brand-dark)">{{ settings.siteName }} · Espace membre</span>
			</header>

			<div class="flex-1 overflow-y-auto p-4 md:p-6 space-y-4">
				{% include '_partials/_flashes.html.twig' %}
				<main id="contenu" tabindex="-1" class="animate-fade-in focus:outline-none">
					{% block body %}{% endblock %}
				</main>
			</div>
		</div>
	</body>
</html>
