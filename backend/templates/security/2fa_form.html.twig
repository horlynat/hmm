<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Double authentification | Admin</title>

		{% set settings = systemSettingRepository.getSettings() %}
		{% if settings.logoPath %}
			<link rel="icon" href="{{ settings.logoPath }}">
		{% else %}
			<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% endif %}
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

		{{ vite_entry_link_tags('login') }}
		{{ vite_entry_script_tags('login') }}
	</head>
	<body>
		<div class="auth-editorial">
			{% include '_partials/_auth_hero.html.twig' %}

			<div class="auth-form-side">
			<div class="w-full max-w-sm animate-fade-in">
				<h1 class="text-2xl font-extrabold tracking-tight text-brand-dark mb-2">
					Vérification en deux étapes
				</h1>
				<p class="text-sm text-gray-500 mb-8">Saisissez le code affiché par votre application d'authentification.</p>

				{% if authenticationError %}
					<div class="mb-4 p-3 bg-red-100 text-red-700 rounded-lg border border-red-300 text-sm">
						{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
					</div>
				{% endif %}

				<form id="twoFactorForm" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" method="post" class="space-y-6">
					<div class="relative">
						<label for="_auth_code" class="label block">Code à 6 chiffres</label>
						<input
							id="_auth_code"
							type="text"
							name="{{ authCodeParameterName }}"
							inputmode="numeric"
							pattern="[0-9]*"
							maxlength="6"
							autocomplete="one-time-code"
							autofocus
							required
							class="input input-primary w-full text-center text-lg tracking-[0.5em] font-mono"
							placeholder="000000"
						/>
					</div>

					{% if displayTrustedOption %}
						<div class="flex items-center space-x-2">
							<input type="checkbox" id="_trusted" name="{{ trustedParameterName }}" class="input-checkbox">
							<label for="_trusted" class="label">Faire confiance à cet appareil</label>
						</div>
					{% endif %}

					{% if isCsrfProtectionEnabled %}
						<input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
					{% endif %}

					<button type="submit" class="btn btn-primary w-full" data-loading-label="⏳ Vérification...">
						Vérifier
					</button>
				</form>

				<p class="mt-8 text-sm text-gray-500">
					<a href="{{ logoutPath }}" class="font-semibold text-brand-primary hover:underline">Annuler et se déconnecter</a>
				</p>
			</div>
			</div>
		</div>
	</body>
</html>
