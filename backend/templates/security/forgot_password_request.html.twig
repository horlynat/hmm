<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Mot de passe oublié | Admin{% endblock %}
		</title>

		{% set settings = systemSettingRepository.getSettings() %}
		{% if settings.logoPath %}
			<link rel="icon" href="{{ settings.logoPath }}">
		{% else %}
			<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% endif %}
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

		{% include '_partials/_vite_fouc_guard.html.twig' %}

		{% block stylesheets %}
			{{ vite_entry_link_tags('login') }}
		{% endblock %}

		{% block javascripts %}
			{{ vite_entry_script_tags('login') }}
		{% endblock %}
	</head>
	<body>
		<div class="auth-editorial">
			{% include '_partials/_auth_hero.html.twig' %}

			<div class="auth-form-side">
			<div class="w-full max-w-sm animate-fade-in">
				<h1 class="text-2xl font-extrabold tracking-tight text-brand-dark mb-2">
					Mot de passe oublié
				</h1>
				<p class="text-sm text-gray-600 mb-8">
					Indique ton adresse email : si un compte y est associé, un lien de réinitialisation valable 1 heure te sera envoyé.
				</p>

				{% for message in app.flashes('success') %}
					<div class="mb-4 p-3 bg-green-100 text-green-700 rounded-lg border border-green-300 text-sm">
						{{ message }}
					</div>
				{% endfor %}
				{% for message in app.flashes('danger') %}
					<div class="mb-4 p-3 bg-red-100 text-red-700 rounded-lg border border-red-300 text-sm">
						{{ message }}
					</div>
				{% endfor %}

				{{ form_start(form) }}
					<div class="relative mb-6">
						{{ form_label(form.email, 'E-mail : ', {'label_attr': {'class': 'label block'}}) }}
						{{ form_widget(form.email, {'attr': {'class': 'input input-email input-primary w-full', 'placeholder': 'Votre adresse email', 'autocomplete': 'email', 'autofocus': 'autofocus'}}) }}
						{{ form_errors(form.email, {'attr': {'class': 'text-sm mt-1 text-red-600'}}) }}
					</div>

					<button type="submit" class="btn btn-primary w-full" data-loading-label="⏳ Envoi en cours...">
						Envoyer le lien de réinitialisation
					</button>
				{{ form_end(form) }}

				<p class="mt-6 text-sm text-gray-500">
					<a href="{{ path('login') }}" class="font-semibold text-brand-primary hover:underline">← Retour à la connexion</a>
				</p>
			</div>
			</div>
		</div>
	</body>
</html>
