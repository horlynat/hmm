{# 📌 Détection automatique de la route actuelle pour ouvrir le bon accordéon au chargement #}
{% set currentRoute = app.request.attributes.get('_route') %}
{# CRM = tout ce qui précède un projet signé (acquisition, relation client) ;
   ERP = tout ce qui suit (production, facturation) — même séparation que le
   dashboard admin (cf. isCrmActive/isErpActive utilisés plus bas) et que la
   maquette de refonte validée. admin_project_freelance_space (validation des
   candidatures d'auto-association, AdminProjectController::freelanceSpace)
   est côté CRM malgré son préfixe de route : c'est une décision de
   recrutement, pas une action de production. admin_project_statistics reste
   côté ERP (c'était déjà son rattachement sous l'ex-groupe Finance). #}
{% set isCrmActive = currentRoute starts with 'admin_collaborator' or currentRoute starts with 'admin_contact' or currentRoute starts with 'admin_newsletter' or currentRoute starts with 'admin_request' or currentRoute starts with 'admin_testimonial' or currentRoute starts with 'admin_users' or currentRoute == 'admin_project_freelance_space' %}
{% set isErpActive = currentRoute starts with 'admin_finance' or (currentRoute starts with 'admin_project' and currentRoute != 'admin_project_freelance_space') %}
{% set isContenuActive = currentRoute starts with 'admin_skill' or currentRoute starts with 'admin_tag' or currentRoute starts with 'admin_article' or currentRoute starts with 'admin_course' or currentRoute starts with 'admin_experience' or currentRoute starts with 'admin_home_content' or currentRoute starts with 'admin_about_content' or currentRoute starts with 'admin_ai_assistant' %}
{% set isSecuriteActive = currentRoute starts with 'admin_security_' or currentRoute starts with 'admin_admins' %}
{% set isParametresActive = currentRoute starts with 'admin_config' or currentRoute starts with 'admin_notification' or currentRoute starts with 'admin_integration' or currentRoute starts with 'admin_backup' %}
{% set isSupportActive = currentRoute starts with 'admin_support' %}

{# 🔒 Visibilité par rôle : chaque booléen reflète EXACTEMENT le denyAccessUnlessGranted/Voter
   de la méthode index() du contrôleur ciblé (voir routes admin_*), pas une approximation —
   sinon on retombe dans le problème d'origine (des liens visibles qui 403ent). #}
{% set canViewDashboard = is_granted(constant('App\\Security\\Voter\\DashboardVoter::VIEW')) %}

{% set canViewFinanceOverview = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
{% set canViewFinanceInvoices = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
{% set canViewFinanceExpenses = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
{% set canViewFinanceReports = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
{% set canViewFinanceJournal = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
{# admin_project_statistics (AdminProjectController::statistics()) partage la garde ROLE_ADMIN
   de "Projets" ci-dessous — c'est le même périmètre que l'ex-groupe Finance dont ce lien venait. #}
{% set canViewFinanceProjects = is_granted('ROLE_ADMIN') %}

{% set canViewProjects = is_granted('ROLE_ADMIN') %}
{# admin_project_freelance_space (validation des candidatures d'auto-association) partage la
   garde ROLE_ADMIN de "Projets" côté contrôleur — même chose ici, seul le groupement change (CRM). #}
{% set canViewProjectFreelanceSpace = is_granted('ROLE_ADMIN') %}
{% set canViewSkills = is_granted('ROLE_EDITOR') %}
{% set canViewSkillCategories = is_granted('ROLE_ADMIN') %}
{% set canViewArticles = is_granted(constant('App\\Security\\Voter\\ArticleVoter::VIEW')) %}
{% set canViewTags = is_granted('ROLE_ADMIN') %}
{% set canViewCourses = is_granted('ROLE_EDITOR') %}
{% set canViewExperiences = is_granted('ROLE_ADMIN') %}
{% set canViewHomeContent = is_granted('ROLE_ADMIN') %}
{% set canViewAboutContent = is_granted('ROLE_ADMIN') %}
{% set canViewAiAssistant = is_granted('ROLE_ADMIN') %}
{% set canViewContenuSection = canViewSkills or canViewSkillCategories or canViewArticles or canViewTags or canViewCourses or canViewExperiences or canViewHomeContent or canViewAboutContent or canViewAiAssistant %}

{% set canViewAdmins = is_granted('ROLE_ADMIN') %}
{% set canViewCollaborators = is_granted('ROLE_ADMIN') %}
{% set canViewClients = is_granted('ROLE_ADMIN') %}
{% set canViewContacts = is_granted(constant('App\\Security\\Voter\\ContactVoter::VIEW')) %}
{% set canViewNewsletter = is_granted(constant('App\\Security\\Voter\\NewsletterVoter::VIEW')) %}
{% set canViewQuoteRequests = is_granted(constant('App\\Security\\Voter\\QuoteVoter::VIEW')) %}
{% set canViewTestimonials = is_granted(constant('App\\Security\\Voter\\TestimonialVoter::VIEW')) %}
{# CRM — tout ce qui précède un projet signé : acquisition (devis, contacts,
   newsletter), relation client (clients, témoignages) et recrutement
   (collaborateurs, candidatures d'auto-association). #}
{% set canViewCrmSection = canViewQuoteRequests or canViewContacts or canViewNewsletter or canViewCollaborators or canViewClients or canViewTestimonials or canViewProjectFreelanceSpace %}
{# ERP — tout ce qui suit : production (projets) et facturation. #}
{% set canViewErpSection = canViewProjects or canViewFinanceOverview or canViewFinanceInvoices or canViewFinanceExpenses or canViewFinanceReports or canViewFinanceJournal or canViewFinanceProjects %}

{% set canViewSecurityLogs = is_granted(constant('App\\Security\\Voter\\SecurityVoter::VIEW_LOGS')) %}
{% set canViewSecuritySessions = is_granted(constant('App\\Security\\Voter\\SecurityVoter::MANAGE_SESSIONS')) %}
{% set canViewSecurityRoles = is_granted(constant('App\\Security\\Voter\\SecurityVoter::VIEW_ROLES')) %}
{% set canViewSecurityAudit = is_granted(constant('App\\Security\\Voter\\SecurityVoter::VIEW_AUDIT')) %}
{% set canViewSecurity2fa = is_granted(constant('App\\Security\\Voter\\SecurityVoter::MANAGE_2FA')) %}
{% set canViewSecurityPolicies = is_granted(constant('App\\Security\\Voter\\SecurityVoter::VIEW_POLICIES')) %}
{% set canManagePermissions = is_granted(constant('App\\Security\\Voter\\SecurityVoter::MANAGE_PERMISSIONS')) %}
{% set canViewSecuriteSection = canViewSecurityLogs or canViewSecuritySessions or canViewSecurityRoles or canViewSecurityAudit or canViewSecurity2fa or canViewSecurityPolicies or canManagePermissions or canViewAdmins %}

{% set canViewConfig = is_granted(constant('App\\Security\\Voter\\SettingsVoter::VIEW_CONFIG')) %}
{% set canViewNotifications = is_granted(constant('App\\Security\\Voter\\SettingsVoter::VIEW_NOTIFICATIONS')) %}
{% set canViewIntegrations = is_granted(constant('App\\Security\\Voter\\SettingsVoter::VIEW_INTEGRATIONS')) %}
{% set canViewBackups = is_granted(constant('App\\Security\\Voter\\SettingsVoter::VIEW_BACKUPS')) %}
{% set canViewMailAdmin = is_granted('ROLE_ADMIN') %}
{% set canViewParametresSection = canViewConfig or canViewNotifications or canViewIntegrations or canViewBackups or canViewMailAdmin %}

{% set canViewSupportDocs = is_granted('ROLE_EDITOR') %}
{% set canViewSupportFaq = is_granted('ROLE_EDITOR') %}
{% set canViewSupportTickets = is_granted(constant('App\\Security\\Voter\\SupportTicketVoter::VIEW')) %}
{% set canViewSupportSection = canViewSupportDocs or canViewSupportFaq or canViewSupportTickets %}

{% if is_granted('ROLE_EDITOR') %}
{#
	⚠️ Le repli mobile utilisait `-translate-x-full`/`md:translate-x-0` (propriété CSS `translate`
	standalone, composée via `--tw-translate-x`/`--tw-translate-y` enregistrées en `@property
	syntax:"*"`) : le `translate` calculé restait bloqué à l'identité quel que soit l'état, aside
	toujours visible en dessous de md — confirmé en isolant chaque déclaration (aucune règle
	concurrente, aucun !important, la règle matche bien l'élément, et pourtant `getComputedStyle`
	ignore la valeur). Un `transform: translateX(...)` en propriété arbitraire n'a pas non plus
	suffi. Bascule sur `hidden`/`flex` (affichage, pas transform) : mécanisme différent, aucune
	ambiguïté possible, vérifié en direct. Perd l'animation de glissement, gagne la fiabilité.
#}
<aside class="fixed inset-y-0 left-0 z-50 w-56 h-full bg-(--color-bg-default) border-r border-gray-200 dark:border-gray-800 flex-col
			       md:static md:h-screen md:flex shadow-xl md:shadow-none" :class="mobileSidebarOpen ? 'flex' : 'hidden'" aria-label="Navigation principale">
	<!-- 🏢 LOGO & ENTÊTE (configurable : Paramètres > Configuration) -->
	<div class="p-4 border-b border-gray-200 flex items-center gap-3 justify-between shrink-0">
		<div class="flex items-center gap-2.5 min-w-0">
			{% if settings.logoPath %}
				{# Pas d'arrondi de conteneur : le logo (monogramme H) a déjà ses propres
				   coins arrondis dessinés dans le fichier lui-même — en cumuler un second
				   par-dessus (rounded-lg = 16px sur ce projet, très prononcé sur 36px)
				   le fait paraître presque circulaire. #}
				<img src="{{ settings.logoPath }}" alt="{{ settings.siteName }}" class="h-7 w-7 object-contain shrink-0">
			{% endif %}
			<div class="min-w-0">
				<h1 class="text-sm font-heading font-bold text-(--color-brand-dark) truncate">{{ settings.siteName }}</h1>
				<p class="text-[10.5px] text-(--color-brand-dark)/60 truncate">Admin | Portail Digital </p>
			</div>
		</div>
		<button type="button" @click="mobileSidebarOpen = false" class="md:hidden p-1 rounded-lg text-(--color-brand-dark) hover:bg-gray-100 dark:hover:bg-gray-800" aria-label="Fermer le menu">
			<span class="ti ti-x text-xl" aria-hidden="true"></span>
		</button>
	</div>

	<!-- 🧭 NAVIGATION SCROLLABLE -->
	<nav class="flex-1 p-4 space-y-3 overflow-y-auto text-sm scrollbar-none">

		<!-- ==========================================
				     📌 PRINCIPAL
				     ========================================== -->
		<div>
			<p class="text-[10px] uppercase text-(--color-brand-dark) font-bold mb-1.5 ml-3 tracking-wider">Principal</p>
			{# Accueil : sans garde propre, le nav entier est déjà gardé ROLE_EDITOR
			   ci-dessus (bloc englobant) — la page elle-même n'exige que ROLE_USER
			   (cf. HomeController), donc toujours accessible à qui voit ce menu. #}
			<a href="{{ path('home_index') }}" class="flex items-center px-2.5 py-[7px] rounded-lg transition gap-3 font-medium text-(--color-brand-dark) hover:bg-brand-light/20 hover:text-(--color-brand-primary) {% if currentRoute == 'home_index' %}bg-brand-light/30 text-(--color-brand-primary) font-semibold{% endif %}">
				<i class="ti ti-home text-lg"></i>
				<span>Accueil</span>
			</a>
			{% if canViewDashboard %}
				<a href="{{ path('admin_dashboard_index') }}" class="flex items-center px-2.5 py-[7px] rounded-lg transition gap-3 font-medium text-(--color-brand-dark) hover:bg-brand-light/20 hover:text-(--color-brand-primary) {% if currentRoute == 'admin_dashboard_index' %}bg-brand-light/30 text-(--color-brand-primary) font-semibold{% endif %}">
					<i class="ti ti-layout-dashboard text-lg"></i>
					<span>Dashboard</span>
				</a>
			{% endif %}
		</div>

		<!-- ==========================================
				     🤝 CRM — RELATION CLIENT (ACCORDÉON)
				     ========================================== -->
		{% if canViewCrmSection %}
			<div x-data="{ open: {{ isCrmActive ? 'true' : 'false' }} }">
				<button type="button" @click="open = !open" :aria-expanded="open" class="w-full flex items-center justify-between px-2.5 py-[7px] rounded-lg text-(--color-brand-dark) hover:bg-gray-50 dark:hover:bg-gray-800 transition font-medium">
					<div class="flex items-center gap-3">
						<i class="ti ti-users-group text-lg text-(--color-brand-dark)"></i>
						<span>CRM</span>
					</div>
					<i class="ti text-xs transition-transform duration-200" :class="open ? 'ti-chevron-up' : 'ti-chevron-down'"></i>
				</button>

				<div x-show="open" x-collapse class="pl-4 mt-1 space-y-0.5 border-l border-gray-200 ml-5">
					{% if canViewQuoteRequests %}
						<a href="{{ path('admin_request_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_request' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-git-pull-request text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Pipeline des devis
						</a>
					{% endif %}
					{% if canViewContacts %}
						<a href="{{ path('admin_contact_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_contact' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-mail text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Contacts
						</a>
					{% endif %}
					{% if canViewNewsletter %}
						<a href="{{ path('admin_newsletter_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_newsletter' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-mail-heart text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Newsletter
						</a>
					{% endif %}
					{% if canViewClients %}
						<a href="{{ path('admin_users_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_users' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-user-dollar text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Clients
						</a>
					{% endif %}
					{% if canViewTestimonials %}
						<a href="{{ path('admin_testimonial_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_testimonial' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-message-star text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Témoignages
						</a>
					{% endif %}
					{% if canViewCollaborators %}
						<a href="{{ path('admin_collaborator_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_collaborator' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-users-group text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Collaborateurs
						</a>
					{% endif %}
					{% if canViewProjectFreelanceSpace %}
						<a href="{{ path('admin_project_freelance_space') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute == 'admin_project_freelance_space' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-user-check text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Candidatures freelance
						</a>
					{% endif %}
				</div>
			</div>
		{% endif %}

		<!-- ==========================================
				     🏗️ ERP — PRODUCTION & FACTURATION (ACCORDÉON)
				     ========================================== -->
		{% if canViewErpSection %}
			<div x-data="{ open: {{ isErpActive ? 'true' : 'false' }} }">
				<button type="button" @click="open = !open" :aria-expanded="open" class="w-full flex items-center justify-between px-2.5 py-[7px] rounded-lg text-(--color-brand-dark) hover:bg-gray-50 dark:hover:bg-gray-800 transition font-medium">
					<div class="flex items-center gap-3">
						<i class="ti ti-report-money text-lg text-(--color-brand-dark)"></i>
						<span>ERP</span>
					</div>
					<i class="ti text-xs transition-transform duration-200" :class="open ? 'ti-chevron-up' : 'ti-chevron-down'"></i>
				</button>

				<div x-show="open" x-collapse class="pl-4 mt-1 space-y-0.5 border-l border-gray-200 ml-5">
					{% if canViewProjects %}
						<a href="{{ path('admin_project_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_project' and currentRoute != 'admin_project_statistics' and currentRoute != 'admin_project_freelance_space' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-briefcase text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Projets
						</a>
					{% endif %}
					{% if canViewFinanceOverview %}
						<a href="{{ path('admin_finance_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute == 'admin_finance_index' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-chart-pie text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Vue d'ensemble
						</a>
					{% endif %}
					{% if canViewFinanceInvoices %}
						<a href="{{ path('admin_finance_invoices') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_finance_invoices' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-file-invoice text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Factures
						</a>
					{% endif %}
					{% if canViewFinanceExpenses %}
						<a href="{{ path('admin_finance_expenses') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_finance_expenses' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-receipt text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Dépenses
						</a>
					{% endif %}
					{% if canViewFinanceProjects %}
						<a href="{{ path('admin_project_statistics') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute == 'admin_project_statistics' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-chart-infographic text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Statistiques projets
						</a>
					{% endif %}
					{% if canViewFinanceReports %}
						<a href="{{ path('admin_finance_reports') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_finance_reports' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-report text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Rapports
						</a>
					{% endif %}
					{% if canViewFinanceJournal %}
						<a href="{{ path('admin_finance_journal') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_finance_journal' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-history text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Journal
						</a>
					{% endif %}
				</div>
			</div>
		{% endif %}

		<!-- ==========================================
				     📁 CONTENU (ACCORDÉON)
				     ========================================== -->
		{% if canViewContenuSection %}
			<div x-data="{ open: {{ isContenuActive ? 'true' : 'false' }} }">
				<button type="button" @click="open = !open" :aria-expanded="open" class="w-full flex items-center justify-between px-2.5 py-[7px] rounded-lg text-(--color-brand-dark) hover:bg-gray-50 dark:hover:bg-gray-800 transition font-medium">
					<div class="flex items-center gap-3">
						<i class="ti ti-folders text-lg text-(--color-brand-dark)"></i>
						<span>Contenu</span>
					</div>
					<i class="ti text-xs transition-transform duration-200" :class="open ? 'ti-chevron-up' : 'ti-chevron-down'"></i>
				</button>

				<div x-show="open" x-collapse class="pl-4 mt-1 space-y-0.5 border-l border-gray-200 ml-5">
					{% if canViewSkills %}
						<a href="{{ path('admin_skill_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_skill_' and not (currentRoute starts with 'admin_skill_category') %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-code text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Compétences
						</a>
					{% endif %}
					{% if canViewSkillCategories %}
						<a href="{{ path('admin_skill_category_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_skill_category' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-category text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Catégories de compétences
						</a>
					{% endif %}
					{% if canViewArticles %}
						<a href="{{ path('admin_article_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_article' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-news text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Articles
						</a>
					{% endif %}

					{% if canViewTags %}
						<a href="{{ path('admin_tag_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_tag' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-tag text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Tags
						</a>
					{% endif %}

					{% if canViewCourses %}
						<a href="{{ path('admin_course_index') }}" class="group flex items-center gap-2 py-[6px] px-2.5 rounded-md text-(--color-brand-dark) hover:text-(--color-brand-primary) hover:bg-gray-50 transition {% if currentRoute starts with 'admin_course' %}text-(--color-brand-primary) bg-brand-light/10 font-medium{% endif %}">
							<i class="ti ti-school text-base text-(--color-brand-dark) group-hover:text-(--color-brand-primary)"></i>
							Formations
						</a>
					{% endif %}
