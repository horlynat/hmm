{% set firstName = app.user ? app.user.email|split('@')[0]|capitalize : 'Visiteur' %}
{% set userRole = app.user ? (app.user.primaryRole|replace({'ROLE_': ''})|lower|capitalize) : 'Invité' %}
{% set initials = firstName|slice(0, 2)|upper %}

<header class="flex justify-between items-center bg-white/85 dark:bg-gray-900/85 backdrop-blur-md px-4 md:px-6 py-3 border-b border-gray-200 dark:border-gray-800 sticky top-0 z-40">

	{# ── Gauche : déclencheur mobile + fil d'Ariane ── #}
	<div class="flex items-center gap-3 md:gap-6 min-w-0">
		<button type="button" @click="mobileSidebarOpen = true"
				class="md:hidden p-2 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
				aria-label="Ouvrir le menu de navigation">
			<span class="ti ti-menu-2 text-2xl" aria-hidden="true"></span>
		</button>

		<nav class="flex items-center text-xs md:text-sm text-gray-500 overflow-x-auto whitespace-nowrap py-1" aria-label="Fil d'Ariane">
			{# "Accueil" pointe vers le dashboard (ROLE_ADMIN) si accessible, sinon vers le
			   profil : seule page garantie accessible à tout ROLE_USER — jamais un lien mort. #}
			<a href="{{ is_granted(constant('App\\Security\\Voter\\DashboardVoter::VIEW')) ? path('admin_dashboard_index') : path('profile_read', {'id': app.user.id}) }}" class="flex items-center text-(--brand-primary) font-bold hover:text-brand-accent transition">
				<span class="ti ti-home text-base mr-1" aria-hidden="true"></span>
				Accueil
			</a>
			{% set segments = app.request.pathInfo|trim('/')|split('/') %}
			{% for segment in segments %}
				<span class="mx-1.5 text-gray-300 dark:text-gray-600" aria-hidden="true">/</span>
				<span class="capitalize text-(--brand-dark) font-medium truncate max-w-[120px] md:max-w-none"
					  {% if loop.last %}aria-current="page"{% endif %}>
					{{ segment|replace({'_': ' '}) }}
				</span>
			{% endfor %}
		</nav>
	</div>

	{# ── Droite : recherche + notifications + menu utilisateur ── #}
	<div class="flex items-center gap-2 md:gap-4 shrink-0">
		<form role="search" class="relative hidden sm:block" onsubmit="return false">
			<label for="admin-search" class="sr-only">Rechercher dans l'administration</label>
			<input id="admin-search" type="search" placeholder="Rechercher…"
				   class="input input-search w-48 lg:w-72 text-sm py-1.5" />
		</form>

		<form method="post" action="{{ path('admin_currency_set') }}" class="hidden sm:block">
			<label for="admin-currency" class="sr-only">Devise d'affichage</label>
			<select id="admin-currency" name="currency" onchange="this.form.submit()"
					class="input input-select text-sm py-1.5 w-auto" aria-label="Devise d'affichage">
				{% for currency in currency_choices() %}
					<option value="{{ currency.value }}" {% if active_currency() == currency.value %}selected{% endif %}>{{ currency.getSymbol() }} {{ currency.value }}</option>
				{% endfor %}
			</select>
		</form>

		{% if is_granted(constant('App\\Security\\Voter\\SettingsVoter::VIEW_NOTIFICATIONS')) %}
			<a href="{{ path('admin_notification_index') }}"
			   class="relative p-2 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition text-gray-600 dark:text-gray-300"
			   aria-label="Notifications">
				<span class="ti ti-bell text-xl" aria-hidden="true"></span>
				<span class="absolute top-1.5 right-1.5 w-2 h-2 bg-danger rounded-full ring-2 ring-white dark:ring-gray-900" aria-hidden="true"></span>
			</a>
		{% endif %}

		<div class="relative" x-data="{ open: false }">
			<button type="button" @click="open = !open" :aria-expanded="open" aria-haspopup="menu"
					class="flex items-center gap-2 rounded-full border border-gray-200 dark:border-gray-700 p-1 md:px-2 md:py-1.5 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
				<span class="flex h-8 w-8 items-center justify-center rounded-full text-xs font-bold text-white shadow-inner" style="background: var(--color-brand-primary)" aria-hidden="true">{{ initials }}</span>
				<span class="text-left pr-1 hidden md:block select-none">
					<span class="block text-xs font-bold text-(--brand-dark) leading-tight">{{ firstName }}</span>
					<span class="block text-[9px] text-gray-400 uppercase tracking-wide font-medium">{{ userRole }}</span>
				</span>
				<span class="ti ti-chevron-down text-sm text-gray-400 hidden md:block" aria-hidden="true"></span>
			</button>

			<div x-show="open" x-cloak @click.away="open = false" @keydown.escape.window="open = false"
				 x-transition:enter="transition ease-out duration-150"
				 x-transition:enter-start="opacity-0 scale-95 -translate-y-2" x-transition:enter-end="opacity-100 scale-100 translate-y-0"
				 x-transition:leave="transition ease-in duration-100"
				 x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95"
				 class="absolute right-0 mt-2 w-64 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 z-50 py-1.5 text-sm"
				 role="menu" style="display: none;">
				<div class="px-4 py-2.5 border-b border-gray-100 dark:border-gray-700">
					<p class="text-sm font-bold text-(--brand-dark) dark:text-gray-100 truncate">{{ app.user.fullName ?? firstName }}</p>
					<p class="text-xs text-gray-400 truncate">{{ app.user.email }}</p>
				</div>

				<a href="{{ path('member_project_index') }}" role="menuitem" class="flex items-center px-4 py-2 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
					<span class="ti ti-briefcase text-base mr-3 text-gray-400" aria-hidden="true"></span>Mes projets
				</a>
				<a href="{{ path('member_quote_index') }}" role="menuitem" class="flex items-center px-4 py-2 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
					<span class="ti ti-file-invoice text-base mr-3 text-gray-400" aria-hidden="true"></span>Mes devis
				</a>

				<hr class="my-1.5 border-gray-100 dark:border-gray-700">

				<a href="{{ path('profile_read', {'id': app.user.id}) }}" role="menuitem" class="flex items-center px-4 py-2 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
					<span class="ti ti-user-circle text-base mr-3 text-gray-400" aria-hidden="true"></span>Voir mon profil
				</a>
				<a href="{{ path('profile_update', {'id': app.user.id}) }}" role="menuitem" class="flex items-center px-4 py-2 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
					<span class="ti ti-edit text-base mr-3 text-gray-400" aria-hidden="true"></span>Modifier le profil
				</a>
				<a href="{{ path('profile_change_password', {'id': app.user.id}) }}" role="menuitem" class="flex items-center px-4 py-2 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
					<span class="ti ti-lock-cog text-base mr-3 text-gray-400" aria-hidden="true"></span>Changer le mot de passe
				</a>
				<a href="{{ path('profile_two_factor_index') }}" role="menuitem" class="flex items-center px-4 py-2 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
					<span class="ti ti-shield-lock text-base mr-3 text-gray-400" aria-hidden="true"></span>Sécurité et 2FA
				</a>

				{% if is_granted('ROLE_EDITOR') %}
					<hr class="my-1.5 border-gray-100 dark:border-gray-700">
					<a href="{{ path('admin_config_index') }}" role="menuitem" class="flex items-center px-4 py-2 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
						<span class="ti ti-adjustments text-base mr-3 text-gray-400" aria-hidden="true"></span>Préférences du site
					</a>
				{% endif %}

				<hr class="my-1.5 border-gray-100 dark:border-gray-700">
				<a href="{{ path('logout') }}" role="menuitem" class="flex items-center px-4 py-2 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 transition font-medium">
					<span class="ti ti-logout text-base mr-3 opacity-80" aria-hidden="true"></span>Déconnexion
				</a>
			</div>
		</div>
	</div>
</header>
