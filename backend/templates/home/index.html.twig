<!DOCTYPE html>
{% set settings = systemSettingRepository.getSettings() %}
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ settings.siteName }} — Accueil</title>

		{% if settings.logoPath %}
			<link rel="icon" href="{{ settings.logoPath }}">
		{% else %}
			<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% endif %}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

		{% include '_partials/_vite_fouc_guard.html.twig' %}

		{% block stylesheets %}
			{{ vite_entry_link_tags('home') }}
		{% endblock %}

		{% block javascripts %}
			{{ vite_entry_script_tags('home') }}
		{% endblock %}
	</head>
	<body class="h-screen flex flex-col overflow-hidden bg-brand-dark">

		{% set hour = "now"|date("G") %}
		{% set greeting = hour < 12 ? 'Bonjour' : (hour < 18 ? 'Bon après-midi' : 'Bonsoir') %}
		{% set roleLabels = {
			'ROLE_USER': 'Client',
			'ROLE_EDITOR': 'Collaborateur',
			'ROLE_MODERATOR': 'Modérateur',
			'ROLE_MANAGER': 'Manager',
			'ROLE_ADMIN': 'Administrateur',
			'ROLE_SUPER_ADMIN': 'Super Administrateur',
		} %}
		{# Même garde exacte que la route ciblée (DashboardVoter::VIEW, ROLE_ADMIN) —
		   jamais un panneau visible qui mènerait à un refus d'accès. L'espace projets,
		   lui, n'a aucune garde propre au-delà du plancher ROLE_USER déjà requis pour
		   atteindre cette page (cf. MemberProjectController::index()) : toujours visible. #}
		{% set canViewAdministration = is_granted(constant('App\\Security\\Voter\\DashboardVoter::VIEW')) %}

		{# 🏛️ EN-TÊTE — zone d'orientation : marque + salutation. Distincte des
		   panneaux ci-dessous (fond plein uni, pas de dégradé) pour qu'on lise
		   tout de suite la page en deux zones, pas un empilement flou. #}
		<header class="shrink-0 text-center text-white px-6 py-7 animate-fade-in">
			{% if settings.logoPath %}
				<img src="{{ settings.logoPath }}" alt="{{ settings.siteName }}" class="h-9 w-9 object-contain mx-auto mb-3">
			{% endif %}
			{% if app.user.primaryRole is defined and roleLabels[app.user.primaryRole] is defined %}
				<span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-[11px] font-semibold tracking-wide uppercase ring-1 ring-white/15">
					<i class="ti ti-sparkles" aria-hidden="true"></i>
					{{ roleLabels[app.user.primaryRole] }}
				</span>
			{% endif %}
			<h1 class="mt-3 text-2xl md:text-[1.75rem] font-heading font-extrabold tracking-tight">
				{{ greeting }}, {{ app.user.fullName ?? app.user.userIdentifier }} 👋
			</h1>
			<p class="mt-1 text-white/60 text-sm">Quel espace souhaitez-vous rejoindre ?</p>
		</header>

		{# 🚪 LES DEUX PORTES — chaque panneau occupe toute la hauteur restante :
		   pas de petites cartes perdues dans du vide, un choix structuré en
		   deux zones pleines, égales, immédiatement lisibles. #}
		<div class="flex-1 flex flex-col md:flex-row min-h-0">

			{% if canViewAdministration %}
				<a href="{{ path('admin_dashboard_index') }}"
				   class="group relative flex-1 flex flex-col items-center justify-center gap-5 text-center px-8 py-10 overflow-hidden text-white bg-linear-to-br from-brand-dark via-[#0B1D8A] to-brand-primary transition-all duration-300 hover:flex-[1.08]">
					<div class="absolute -left-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
					<div class="absolute right-10 bottom-0 h-48 w-48 rounded-full bg-brand-accent/20 blur-3xl" aria-hidden="true"></div>

					<span class="relative flex h-24 w-24 items-center justify-center rounded-3xl text-5xl bg-white/10 backdrop-blur-sm ring-1 ring-white/20 shadow-2xl transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
						<i class="ti ti-building" aria-hidden="true"></i>
					</span>
					<span class="relative">
						<span class="block font-heading font-bold text-2xl md:text-3xl">Administration</span>
						<span class="block text-sm md:text-base text-white/70 mt-2 max-w-xs mx-auto">Pilotez l'activité : finance, contenu, utilisateurs, sécurité.</span>
					</span>
					<span class="relative inline-flex items-center gap-2 rounded-full bg-white text-brand-dark px-5 py-2.5 text-sm font-heading font-semibold shadow-lg transition-transform duration-300 group-hover:translate-x-1">
						Accéder à cet espace
						<i class="ti ti-arrow-right" aria-hidden="true"></i>
					</span>
				</a>
			{% endif %}

			<a href="{{ path('member_project_index') }}"
			   class="group relative flex-1 flex flex-col items-center justify-center gap-5 text-center px-8 py-10 overflow-hidden text-white bg-linear-to-br from-brand-primary via-[#0090CE] to-brand-accent transition-all duration-300 hover:flex-[1.08]">
				<div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
				<div class="absolute left-10 bottom-0 h-48 w-48 rounded-full bg-brand-dark/20 blur-3xl" aria-hidden="true"></div>

				<span class="relative flex h-24 w-24 items-center justify-center rounded-3xl text-5xl bg-white/10 backdrop-blur-sm ring-1 ring-white/20 shadow-2xl transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3">
					<i class="ti ti-briefcase" aria-hidden="true"></i>
				</span>
				<span class="relative">
					<span class="block font-heading font-bold text-2xl md:text-3xl">Espace Projets</span>
					<span class="block text-sm md:text-base text-white/70 mt-2 max-w-xs mx-auto">Suivez vos projets et échangez avec l'équipe.</span>
				</span>
				<span class="relative inline-flex items-center gap-2 rounded-full bg-white text-brand-primary px-5 py-2.5 text-sm font-heading font-semibold shadow-lg transition-transform duration-300 group-hover:translate-x-1">
					Accéder à cet espace
					<i class="ti ti-arrow-right" aria-hidden="true"></i>
				</span>
			</a>

		</div>
	</body>
</html>
