<!DOCTYPE html>
{% set settings = systemSettingRepository.getSettings() %}
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ settings.siteName }} — Accueil</title>

		{% if settings.logoPath %}
			<link rel="icon" href="{{ settings.logoPath }}">
		{% else %}
			<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% endif %}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

		{% include '_partials/_vite_fouc_guard.html.twig' %}

		{% block stylesheets %}
			{{ vite_entry_link_tags('home') }}
		{% endblock %}

		{% block javascripts %}
			{{ vite_entry_script_tags('home') }}
		{% endblock %}
	</head>
	<body class="h-screen overflow-hidden bg-brand-dark">

		{% set hour = "now"|date("G") %}
		{% set greeting = hour < 12 ? 'Bonjour' : (hour < 18 ? 'Bon après-midi' : 'Bonsoir') %}
		{% set roleLabels = {
			'ROLE_USER': 'Client',
			'ROLE_EDITOR': 'Collaborateur',
			'ROLE_MODERATOR': 'Modérateur',
			'ROLE_MANAGER': 'Manager',
			'ROLE_ADMIN': 'Administrateur',
			'ROLE_SUPER_ADMIN': 'Super Administrateur',
		} %}
		{# Même garde exacte que la route ciblée (DashboardVoter::VIEW, ROLE_ADMIN) —
		   jamais un panneau visible qui mènerait à un refus d'accès. L'espace projets,
		   lui, n'a aucune garde propre au-delà du plancher ROLE_USER déjà requis pour
		   atteindre cette page (cf. MemberProjectController::index()) : toujours visible. #}
		{% set canViewAdministration = is_granted(constant('App\\Security\\Voter\\DashboardVoter::VIEW')) %}

		<div class="relative h-full">

			{# 🪟 EN-TÊTE FLOTTANT — superposé, pas empilé : les panneaux occupent
			   TOUTE la hauteur dès y=0, la marque flotte par-dessus en verre
			   dépoli. Plus de zone "décorative" séparée du choix lui-même. #}
			<header class="absolute inset-x-0 top-0 z-20 flex items-center justify-between gap-4 px-6 py-4 md:px-10 bg-linear-to-b from-black/25 to-transparent animate-fade-in">
				<div class="flex items-center gap-2.5 text-white">
					{% if settings.logoPath %}
						<img src="{{ settings.logoPath }}" alt="{{ settings.siteName }}" class="h-7 w-7 object-contain">
					{% endif %}
					<span class="font-heading font-bold text-sm tracking-tight">{{ settings.siteName }}</span>
				</div>
				<div class="flex items-center gap-3 text-white text-right">
					<span class="hidden sm:block text-sm text-white/70">{{ greeting }}, {{ app.user.fullName ?? app.user.userIdentifier }}</span>
					{% if app.user.primaryRole is defined and roleLabels[app.user.primaryRole] is defined %}
						<span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-[11px] font-semibold tracking-wide uppercase ring-1 ring-white/15 backdrop-blur-sm">
							{{ roleLabels[app.user.primaryRole] }}
						</span>
					{% endif %}
				</div>
			</header>

			{# 🚪 LES DEUX PORTES : contraste de DENSITÉ plutôt que jumelage —
			   Administration porte visuellement le poids d'un système à 20
			   espaces (réseau de nœuds, chiffre géant en filigrane, matière),
			   Espace Projets reste volontairement épuré : il EST une seule
			   destination, il n'a pas à feindre la même densité. #}
			<div class="h-full flex flex-col md:flex-row">

				{% if canViewAdministration %}
					<a href="{{ path('admin_dashboard_index') }}"
					   class="group relative flex-1 md:flex-[1.2] flex flex-col items-center justify-center gap-6 text-center px-8 pt-24 pb-12 overflow-hidden text-white bg-brand-dark transition-[flex-grow] duration-500 ease-out hover:flex-[1.4]">

						{# Filigrane "20" — le concept rendu visible, pas juste raconté. #}
						<span class="pointer-events-none select-none absolute -left-6 -bottom-16 font-heading font-black leading-none text-white/[0.05] text-[22rem] md:text-[28rem]" aria-hidden="true">20</span>

						{# Réseau de nœuds : un vrai schéma de système, pas des icônes dans des bulles. #}
						<svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.35] animate-pulse" viewBox="0 0 500 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
							<g stroke="#ffffff" stroke-width="1" opacity="0.4">
								<line x1="60" y1="80" x2="140" y2="50"/>
								<line x1="140" y1="50" x2="220" y2="90"/>
								<line x1="220" y1="90" x2="320" y2="60"/>
								<line x1="320" y1="60" x2="400" y2="100"/>
								<line x1="60" y1="80" x2="40" y2="200"/>
								<line x1="140" y1="50" x2="150" y2="180"/>
								<line x1="220" y1="90" x2="260" y2="210"/>
								<line x1="320" y1="60" x2="380" y2="220"/>
								<line x1="400" y1="100" x2="450" y2="180"/>
								<line x1="40" y1="200" x2="150" y2="180"/>
								<line x1="150" y1="180" x2="260" y2="210"/>
								<line x1="260" y1="210" x2="380" y2="220"/>
								<line x1="380" y1="220" x2="450" y2="180"/>
								<line x1="40" y1="200" x2="80" y2="320"/>
								<line x1="150" y1="180" x2="190" y2="300"/>
								<line x1="260" y1="210" x2="300" y2="330"/>
								<line x1="380" y1="220" x2="420" y2="340"/>
								<line x1="80" y1="320" x2="190" y2="300"/>
								<line x1="190" y1="300" x2="300" y2="330"/>
								<line x1="300" y1="330" x2="420" y2="340"/>
								<line x1="80" y1="320" x2="60" y2="440"/>
								<line x1="190" y1="300" x2="170" y2="420"/>
								<line x1="300" y1="330" x2="290" y2="450"/>
								<line x1="420" y1="340" x2="400" y2="430"/>
								<line x1="60" y1="440" x2="170" y2="420"/>
								<line x1="170" y1="420" x2="290" y2="450"/>
								<line x1="290" y1="450" x2="400" y2="430"/>
								<line x1="170" y1="420" x2="140" y2="520"/>
								<line x1="290" y1="450" x2="260" y2="500"/>
							</g>
							<g fill="#ffffff">
								<circle cx="60" cy="80" r="4"/><circle cx="140" cy="50" r="4"/><circle cx="220" cy="90" r="4"/><circle cx="320" cy="60" r="4"/><circle cx="400" cy="100" r="4"/>
								<circle cx="450" cy="180" r="4"/><circle cx="40" cy="200" r="4"/><circle cx="150" cy="180" r="4"/><circle cx="260" cy="210" r="4"/><circle cx="380" cy="220" r="4"/>
								<circle cx="80" cy="320" r="4"/><circle cx="190" cy="300" r="4"/><circle cx="300" cy="330" r="4"/><circle cx="420" cy="340" r="4"/>
								<circle cx="60" cy="440" r="4"/><circle cx="170" cy="420" r="4"/><circle cx="290" cy="450" r="4"/><circle cx="400" cy="430" r="4"/>
								<circle cx="140" cy="520" r="4"/><circle cx="260" cy="500" r="4"/>
							</g>
						</svg>

						<span class="relative flex h-16 w-16 items-center justify-center rounded-2xl text-3xl bg-white text-brand-dark shadow-2xl transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6">
							<i class="ti ti-building" aria-hidden="true"></i>
						</span>
						<span class="relative">
							<span class="flex items-center justify-center gap-2 text-white/50 text-xs font-heading font-bold tracking-[0.3em] uppercase mb-2">
								<span class="h-px w-6 bg-white/30"></span>01
							</span>
							<span class="block font-heading font-extrabold text-4xl md:text-5xl tracking-tight">Administration</span>
							<span class="block text-sm md:text-base text-white/60 mt-3 max-w-sm mx-auto leading-relaxed">Finance, contenu, utilisateurs, sécurité, paramètres — une vingtaine d'espaces de gestion, tous ici.</span>
						</span>
						<span class="relative inline-flex items-center gap-2 rounded-full bg-white text-brand-dark px-6 py-3 text-sm font-heading font-bold shadow-xl transition-all duration-300 group-hover:gap-3.5 group-hover:shadow-2xl">
							Accéder à cet espace
							<i class="ti ti-arrow-right" aria-hidden="true"></i>
						</span>
					</a>
				{% endif %}

				<a href="{{ path('member_project_index') }}"
				   class="group relative flex-1 flex flex-col items-center justify-center gap-6 text-center px-8 pt-24 pb-12 overflow-hidden text-white bg-linear-to-br from-brand-primary to-brand-accent transition-[flex-grow] duration-500 ease-out hover:flex-[1.15]">
					<div class="pointer-events-none absolute -right-20 -bottom-20 h-96 w-96 rounded-full bg-white/10 blur-3xl animate-pulse" aria-hidden="true"></div>

					<span class="relative flex h-16 w-16 items-center justify-center rounded-2xl text-3xl bg-white text-brand-primary shadow-2xl transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6">
						<i class="ti ti-briefcase" aria-hidden="true"></i>
					</span>
					<span class="relative">
						<span class="flex items-center justify-center gap-2 text-white/60 text-xs font-heading font-bold tracking-[0.3em] uppercase mb-2">
							<span class="h-px w-6 bg-white/40"></span>02
						</span>
						<span class="block font-heading font-extrabold text-4xl md:text-5xl tracking-tight">Espace Projets</span>
						<span class="block text-sm md:text-base text-white/75 mt-3 max-w-xs mx-auto leading-relaxed">Suivez vos projets et échangez avec l'équipe.</span>
					</span>
					<span class="relative inline-flex items-center gap-2 rounded-full bg-white text-brand-primary px-6 py-3 text-sm font-heading font-bold shadow-xl transition-all duration-300 group-hover:gap-3.5 group-hover:shadow-2xl">
						Accéder à cet espace
						<i class="ti ti-arrow-right" aria-hidden="true"></i>
					</span>
				</a>

			</div>
		</div>
	</body>
</html>
