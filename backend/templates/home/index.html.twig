{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
	{% set hour = "now"|date("G") %}
	{% set greeting = hour < 12 ? 'Bonjour' : (hour < 18 ? 'Bon après-midi' : 'Bonsoir') %}
	{% set roleLabels = {
		'ROLE_EDITOR': 'Éditeur',
		'ROLE_MODERATOR': 'Modérateur',
		'ROLE_MANAGER': 'Manager',
		'ROLE_ADMIN': 'Administrateur',
		'ROLE_SUPER_ADMIN': 'Super Administrateur',
	} %}

	{# 🔒 Mêmes voters, mêmes libellés qu'_admin.nav.html.twig (source de vérité
	   partagée) : une carte n'apparaît que si au moins un lien qu'elle propose
	   mène quelque part de réellement accessible pour l'utilisateur courant —
	   jamais un lien visible qui 403e. #}
	{% set canViewDashboard = is_granted(constant('App\\Security\\Voter\\DashboardVoter::VIEW')) %}

	{% set canViewFinanceOverview = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
	{% set canViewFinanceInvoices = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
	{% set canViewFinanceExpenses = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
	{% set canViewFinanceReports = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
	{% set canViewFinanceJournal = is_granted(constant('App\\Security\\Voter\\FinanceVoter::VIEW')) %}
	{% set canViewFinanceProjects = is_granted('ROLE_ADMIN') %}
	{% set canViewFinancePipeline = is_granted(constant('App\\Security\\Voter\\QuoteVoter::VIEW')) %}
	{% set canViewFinanceSection = canViewFinanceOverview or canViewFinanceInvoices or canViewFinanceExpenses or canViewFinanceReports or canViewFinanceJournal or canViewFinanceProjects or canViewFinancePipeline %}
	{% set financeHref = canViewFinanceOverview ? path('admin_finance_index')
		: (canViewFinanceInvoices ? path('admin_finance_invoices')
		: (canViewFinanceExpenses ? path('admin_finance_expenses')
		: (canViewFinanceProjects ? path('admin_project_statistics')
		: (canViewFinancePipeline ? path('admin_request_index')
		: (canViewFinanceReports ? path('admin_finance_reports')
		: path('admin_finance_journal')))))) %}

	{% set canViewProjects = is_granted('ROLE_ADMIN') %}
	{% set canViewSkills = is_granted('ROLE_EDITOR') %}
	{% set canViewSkillCategories = is_granted('ROLE_ADMIN') %}
	{% set canViewArticles = is_granted(constant('App\\Security\\Voter\\ArticleVoter::VIEW')) %}
	{% set canViewTags = is_granted('ROLE_ADMIN') %}
	{% set canViewCourses = is_granted('ROLE_EDITOR') %}
	{% set canViewExperiences = is_granted('ROLE_ADMIN') %}
	{% set canViewHomeContent = is_granted('ROLE_ADMIN') %}
	{% set canViewAboutContent = is_granted('ROLE_ADMIN') %}
	{% set canViewAiAssistant = is_granted('ROLE_ADMIN') %}
	{% set canViewContenuSection = canViewProjects or canViewSkills or canViewSkillCategories or canViewArticles or canViewTags or canViewCourses or canViewExperiences or canViewHomeContent or canViewAboutContent or canViewAiAssistant %}
	{% set contenuHref = canViewProjects ? path('admin_project_index')
		: (canViewSkills ? path('admin_skill_index')
		: (canViewSkillCategories ? path('admin_skill_category_index')
		: (canViewArticles ? path('admin_article_index')
		: (canViewTags ? path('admin_tag_index')
		: (canViewCourses ? path('admin_course_index')
		: (canViewExperiences ? path('admin_experience_index')
		: (canViewHomeContent ? path('admin_home_content_index')
		: (canViewAboutContent ? path('admin_about_content_index')
		: path('admin_ai_assistant_index'))))))))) %}

	{% set canViewAdmins = is_granted('ROLE_ADMIN') %}
	{% set canViewCollaborators = is_granted('ROLE_ADMIN') %}
	{% set canViewClients = is_granted('ROLE_ADMIN') %}
	{% set canViewContacts = is_granted(constant('App\\Security\\Voter\\ContactVoter::VIEW')) %}
	{% set canViewQuoteRequests = is_granted(constant('App\\Security\\Voter\\QuoteVoter::VIEW')) %}
	{% set canViewTestimonials = is_granted(constant('App\\Security\\Voter\\TestimonialVoter::VIEW')) %}
	{% set canViewUtilisateursSection = canViewAdmins or canViewCollaborators or canViewClients or canViewContacts or canViewQuoteRequests or canViewTestimonials %}
	{% set utilisateursHref = canViewAdmins ? path('admin_admins_index')
		: (canViewCollaborators ? path('admin_collaborator_index')
		: (canViewClients ? path('admin_users_index')
		: (canViewContacts ? path('admin_contact_index')
		: (canViewQuoteRequests ? path('admin_request_index')
		: path('admin_testimonial_index'))))) %}

	{% set canViewSecurityLogs = is_granted(constant('App\\Security\\Voter\\SecurityVoter::VIEW_LOGS')) %}
	{% set canViewSecuritySessions = is_granted(constant('App\\Security\\Voter\\SecurityVoter::MANAGE_SESSIONS')) %}
	{% set canViewSecurityRoles = is_granted(constant('App\\Security\\Voter\\SecurityVoter::VIEW_ROLES')) %}
	{% set canViewSecurityAudit = is_granted(constant('App\\Security\\Voter\\SecurityVoter::VIEW_AUDIT')) %}
	{% set canViewSecurity2fa = is_granted(constant('App\\Security\\Voter\\SecurityVoter::MANAGE_2FA')) %}
	{% set canViewSecurityPolicies = is_granted(constant('App\\Security\\Voter\\SecurityVoter::VIEW_POLICIES')) %}
	{% set canViewSecuriteSection = canViewSecurityLogs or canViewSecuritySessions or canViewSecurityRoles or canViewSecurityAudit or canViewSecurity2fa or canViewSecurityPolicies %}
	{% set securiteHref = canViewSecurityLogs ? path('admin_security_log_index')
		: (canViewSecuritySessions ? path('admin_security_session_index')
		: (canViewSecurityRoles ? path('admin_security_role_index')
		: (canViewSecurityAudit ? path('admin_security_audit_index')
		: (canViewSecurity2fa ? path('admin_security_two_factor_index')
		: path('admin_security_policy_index'))))) %}

	{% set canViewConfig = is_granted(constant('App\\Security\\Voter\\SettingsVoter::VIEW_CONFIG')) %}
	{% set canViewNotifications = is_granted(constant('App\\Security\\Voter\\SettingsVoter::VIEW_NOTIFICATIONS')) %}
	{% set canViewIntegrations = is_granted(constant('App\\Security\\Voter\\SettingsVoter::VIEW_INTEGRATIONS')) %}
	{% set canViewBackups = is_granted(constant('App\\Security\\Voter\\SettingsVoter::VIEW_BACKUPS')) %}
	{% set canViewMailAdmin = is_granted('ROLE_ADMIN') %}
	{% set canViewParametresSection = canViewConfig or canViewNotifications or canViewIntegrations or canViewBackups or canViewMailAdmin %}
	{% set parametresHref = canViewConfig ? path('admin_config_index')
		: (canViewNotifications ? path('admin_notification_index')
		: (canViewIntegrations ? path('admin_integration_index')
		: (canViewBackups ? path('admin_backup_index')
		: 'https://mailadmin.horlynat.com'))) %}

	{% set canViewSupportDocs = is_granted('ROLE_EDITOR') %}
	{% set canViewSupportFaq = is_granted('ROLE_EDITOR') %}
	{% set canViewSupportTickets = is_granted(constant('App\\Security\\Voter\\SupportTicketVoter::VIEW')) %}
	{% set canViewSupportSection = canViewSupportDocs or canViewSupportFaq or canViewSupportTickets %}
	{% set supportHref = canViewSupportDocs ? path('admin_support_docs_index')
		: (canViewSupportFaq ? path('admin_support_faq_index')
		: path('admin_support_ticket_index')) %}

	<div class="mx-auto max-w-6xl">

		{# 🌅 BANDEAU DE BIENVENUE #}
		<div class="relative overflow-hidden rounded-2xl p-8 md:p-10 mb-8 text-white shadow-lg" style="background: linear-gradient(135deg, var(--color-brand-dark), var(--color-brand-primary) 75%);">
			<div class="absolute -right-8 -top-16 h-56 w-56 rounded-full bg-white/10" aria-hidden="true"></div>
			<div class="absolute right-16 top-20 h-28 w-28 rounded-full bg-white/10" aria-hidden="true"></div>
			<div class="relative">
				{% if app.user.primaryRole is defined and roleLabels[app.user.primaryRole] is defined %}
					<span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold tracking-wide uppercase backdrop-blur-sm">
						<i class="ti ti-sparkles" aria-hidden="true"></i>
						{{ roleLabels[app.user.primaryRole] }}
					</span>
				{% endif %}
				<h1 class="mt-4 text-3xl md:text-4xl font-heading font-extrabold tracking-tight text-balance">
					{{ greeting }}, {{ app.user.fullName ?? app.user.userIdentifier }} 👋
				</h1>
				<p class="mt-2 text-white/85 max-w-xl">
					Voici votre espace de travail. Retrouvez ci-dessous les outils auxquels vous avez accès.
				</p>
				<p class="mt-5 text-xs font-medium text-white/60 uppercase tracking-wide">{{ "now"|date("l j F Y")|capitalize }}</p>
			</div>
		</div>

		{# 🧭 GRILLE DES ESPACES DE TRAVAIL #}
		<h2 class="page-title text-lg mb-4">Vos espaces de travail</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

			{% if canViewDashboard %}
				<a href="{{ path('admin_dashboard_index') }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-brand-dark/10 text-brand-dark">
						<i class="ti ti-layout-dashboard" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Vue globale
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Statistiques, budgets et santé du système.</span>
				</a>
			{% endif %}

			{% if canViewFinanceSection %}
				<a href="{{ financeHref }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-success/10 text-success">
						<i class="ti ti-report-money" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Finance
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Factures, dépenses, rapports et rentabilité.</span>
				</a>
			{% endif %}

			{% if canViewContenuSection %}
				<a href="{{ contenuHref }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-brand-primary/10 text-brand-primary">
						<i class="ti ti-folders" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Contenu
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Projets, articles, compétences et pages du site.</span>
				</a>
			{% endif %}

			{% if canViewUtilisateursSection %}
				<a href="{{ utilisateursHref }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-purple-500/10 text-purple-700">
						<i class="ti ti-users" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Utilisateurs
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Comptes admins, collaborateurs, clients et demandes.</span>
				</a>
			{% endif %}

			{% if canViewSecuriteSection %}
				<a href="{{ securiteHref }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-danger/10 text-danger">
						<i class="ti ti-shield-lock" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Sécurité
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Sessions, rôles, 2FA et journal d'audit.</span>
				</a>
			{% endif %}

			{% if canViewParametresSection %}
				<a href="{{ parametresHref }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-slate-500/10 text-slate-700">
						<i class="ti ti-settings" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Paramètres
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Configuration, notifications et intégrations.</span>
				</a>
			{% endif %}

			{% if canViewSupportSection %}
				<a href="{{ supportHref }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-amber-500/10 text-amber-700">
						<i class="ti ti-help-circle" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Support
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Documentation, FAQ et tickets clients.</span>
				</a>
			{% endif %}

		</div>
	</div>
{% endblock %}
