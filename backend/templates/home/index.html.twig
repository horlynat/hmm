<!DOCTYPE html>
{% set settings = systemSettingRepository.getSettings() %}
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ settings.siteName }} — Portail de travail</title>

		{% if settings.logoPath %}
			<link rel="icon" href="{{ settings.logoPath }}">
		{% else %}
			<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% endif %}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

		{% include '_partials/_vite_fouc_guard.html.twig' %}

		{% block stylesheets %}
			{{ vite_entry_link_tags('home') }}
		{% endblock %}

		{% block javascripts %}
			{{ vite_entry_script_tags('home') }}
		{% endblock %}
	</head>
	<body class="bg-bg-default text-brand-dark">

		<div class="mx-auto max-w-6xl px-4 py-10 md:py-16">

			{# 🏢 EN-TÊTE #}
			<div class="flex items-center gap-3 mb-10">
				{% if settings.logoPath %}
					<img src="{{ settings.logoPath }}" alt="{{ settings.siteName }}" class="h-10 w-10 object-contain shrink-0">
				{% endif %}
				<span class="font-heading font-bold text-lg">{{ settings.siteName }}</span>
			</div>

			{# 🌅 BANDEAU DE BIENVENUE #}
			<div class="relative overflow-hidden rounded-2xl p-8 md:p-14 mb-10 text-white shadow-lg text-center md:text-left" style="background: linear-gradient(135deg, var(--color-brand-dark), var(--color-brand-primary) 75%);">
				<div class="absolute -right-8 -top-16 h-56 w-56 rounded-full bg-white/10" aria-hidden="true"></div>
				<div class="absolute right-24 top-24 h-28 w-28 rounded-full bg-white/10" aria-hidden="true"></div>
				<div class="relative">
					<span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold tracking-wide uppercase backdrop-blur-sm">
						<i class="ti ti-sparkles" aria-hidden="true"></i>
						Portail interne
					</span>
					<h1 class="mt-4 text-3xl md:text-4xl font-heading font-extrabold tracking-tight text-balance">
						Bienvenue sur votre portail de travail 👋
					</h1>
					<p class="mt-3 text-white/85 max-w-xl mx-auto md:mx-0">
						Un seul endroit pour accéder à tous les outils du back-office — quelle que soit votre équipe.
					</p>
					{# Pas .btn-primary ici : son dégradé (brand-dark -> brand-primary)
					   se fondrait dans le bandeau, déjà sur ce même dégradé — un bouton
					   blanc plein tranche davantage comme call-to-action principal. #}
					<a href="{{ path('login') }}" class="mt-6 inline-flex items-center gap-2 rounded-[var(--radius-sm)] bg-white px-5 py-2.5 text-sm font-heading font-semibold text-brand-dark shadow-md transition hover:opacity-90">
						<i class="ti ti-login" aria-hidden="true"></i>
						Se connecter
					</a>
				</div>
			</div>

			{# 🧭 GRILLE DES ESPACES DE TRAVAIL #}
			<h2 class="page-title text-lg mb-4">Ce que vous y trouverez</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">

				<a href="{{ path('admin_dashboard_index') }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-brand-dark/10 text-brand-dark">
						<i class="ti ti-layout-dashboard" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Vue globale
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Statistiques, budgets et santé du système.</span>
				</a>

				<a href="{{ path('admin_finance_index') }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-success/10 text-success">
						<i class="ti ti-report-money" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Finance
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Factures, dépenses, rapports et rentabilité.</span>
				</a>

				<a href="{{ path('admin_project_index') }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-brand-primary/10 text-brand-primary">
						<i class="ti ti-folders" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Contenu
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Projets, articles, compétences et pages du site.</span>
				</a>

				<a href="{{ path('admin_admins_index') }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-purple-500/10 text-purple-700">
						<i class="ti ti-users" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Utilisateurs
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Comptes admins, collaborateurs, clients et demandes.</span>
				</a>

				<a href="{{ path('admin_security_log_index') }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-danger/10 text-danger">
						<i class="ti ti-shield-lock" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Sécurité
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Sessions, rôles, 2FA et journal d'audit.</span>
				</a>

				<a href="{{ path('admin_config_index') }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-slate-500/10 text-slate-700">
						<i class="ti ti-settings" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Paramètres
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Configuration, notifications et intégrations.</span>
				</a>

				<a href="{{ path('admin_support_docs_index') }}" class="soft-card group p-5 flex flex-col gap-3">
					<span class="flex h-12 w-12 items-center justify-center rounded-xl text-2xl bg-amber-500/10 text-amber-700">
						<i class="ti ti-help-circle" aria-hidden="true"></i>
					</span>
					<span class="font-heading font-bold text-base flex items-center gap-1.5">
						Support
						<i class="ti ti-arrow-right text-sm opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
					</span>
					<span class="text-sm text-brand-dark/60 -mt-2">Documentation, FAQ et tickets clients.</span>
				</a>

			</div>

			{# 🔚 RAPPEL D'ACTION #}
			<div class="soft-card p-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
				<div>
					<h2 class="font-heading font-bold text-base">Prêt à commencer ?</h2>
					<p class="text-sm text-brand-dark/60">Connectez-vous avec vos identifiants pour accéder à votre espace.</p>
				</div>
				<a href="{{ path('login') }}" class="btn btn-primary shrink-0">
					<i class="ti ti-login mr-2" aria-hidden="true"></i>
					Se connecter
				</a>
			</div>

		</div>
	</body>
</html>
