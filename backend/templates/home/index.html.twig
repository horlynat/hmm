<!DOCTYPE html>
{% set settings = systemSettingRepository.getSettings() %}
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ settings.siteName }} — Accueil</title>

		{% if settings.logoPath %}
			<link rel="icon" href="{{ settings.logoPath }}">
		{% else %}
			<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% endif %}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

		{% include '_partials/_vite_fouc_guard.html.twig' %}

		{% block stylesheets %}
			{{ vite_entry_link_tags('home') }}
		{% endblock %}

		{% block javascripts %}
			{{ vite_entry_script_tags('home') }}
		{% endblock %}
	</head>
	<body class="min-h-screen flex flex-col relative overflow-hidden bg-linear-to-br from-brand-dark via-brand-primary to-brand-accent">

		{# 🌌 PROFONDEUR : halo pulsé + orbes flous, même technique que
		   _partials/_auth_illustration.html.twig (page de connexion) —
		   cohérence avec le seul autre écran "hors back-office" de l'app. #}
		<div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.15),transparent_70%)] animate-pulse" aria-hidden="true"></div>
		<div class="absolute -left-24 -top-24 h-96 w-96 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
		<div class="absolute -right-16 top-1/3 h-72 w-72 rounded-full bg-brand-accent/30 blur-3xl" aria-hidden="true"></div>
		<div class="absolute left-1/4 -bottom-24 h-80 w-80 rounded-full bg-brand-dark/40 blur-3xl" aria-hidden="true"></div>

		{% set hour = "now"|date("G") %}
		{% set greeting = hour < 12 ? 'Bonjour' : (hour < 18 ? 'Bon après-midi' : 'Bonsoir') %}
		{% set roleLabels = {
			'ROLE_USER': 'Client',
			'ROLE_EDITOR': 'Collaborateur',
			'ROLE_MODERATOR': 'Modérateur',
			'ROLE_MANAGER': 'Manager',
			'ROLE_ADMIN': 'Administrateur',
			'ROLE_SUPER_ADMIN': 'Super Administrateur',
		} %}
		{# Même garde exacte que la route ciblée (DashboardVoter::VIEW, ROLE_ADMIN) —
		   jamais une carte visible qui mènerait à un refus d'accès. L'espace projets,
		   lui, n'a aucune garde propre au-delà du plancher ROLE_USER déjà requis pour
		   atteindre cette page (cf. MemberProjectController::index()) : toujours visible. #}
		{% set canViewAdministration = is_granted(constant('App\\Security\\Voter\\DashboardVoter::VIEW')) %}

		<main class="relative flex-1 flex items-center justify-center px-4 py-16">
			<div class="w-full max-w-3xl animate-fade-in">

				<div class="text-center mb-12">
					{% if settings.logoPath %}
						<img src="{{ settings.logoPath }}" alt="{{ settings.siteName }}" class="h-12 w-12 object-contain mx-auto mb-6 drop-shadow-[0_4px_12px_rgba(0,0,0,0.25)]">
					{% endif %}
					{% if app.user.primaryRole is defined and roleLabels[app.user.primaryRole] is defined %}
						<span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 text-white px-3.5 py-1.5 text-xs font-semibold tracking-wide uppercase backdrop-blur-sm ring-1 ring-white/20">
							<i class="ti ti-sparkles" aria-hidden="true"></i>
							{{ roleLabels[app.user.primaryRole] }}
						</span>
					{% endif %}
					<h1 class="mt-5 text-4xl md:text-5xl font-heading font-extrabold tracking-tight text-balance text-white drop-shadow-sm">
						{{ greeting }}, {{ app.user.fullName ?? app.user.userIdentifier }} 👋
					</h1>
					<p class="mt-3 text-white/80 text-lg">Quel espace souhaitez-vous rejoindre ?</p>
				</div>

				<div class="grid grid-cols-1 {% if canViewAdministration %}sm:grid-cols-2{% endif %} gap-6">

					{% if canViewAdministration %}
						<a href="{{ path('admin_dashboard_index') }}" class="group relative flex flex-col items-center text-center gap-4 rounded-2xl bg-white p-9 shadow-[0_20px_50px_-15px_rgba(3,4,94,0.45)] ring-1 ring-black/5 transition-all duration-300 ease-out hover:-translate-y-2 hover:shadow-[0_30px_60px_-15px_rgba(3,4,94,0.55)]">
							<span class="absolute inset-x-0 top-0 h-1.5 rounded-t-2xl bg-linear-to-r from-brand-dark to-brand-primary"></span>
							<span class="flex h-20 w-20 items-center justify-center rounded-2xl text-4xl text-white shadow-lg shadow-brand-dark/30 bg-linear-to-br from-brand-dark to-brand-primary transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
								<i class="ti ti-building" aria-hidden="true"></i>
							</span>
							<span>
								<span class="flex items-center justify-center gap-1.5 font-heading font-bold text-xl">
									Administration
									<i class="ti ti-arrow-right text-base opacity-0 -translate-x-1 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 text-brand-primary" aria-hidden="true"></i>
								</span>
								<span class="block text-sm text-brand-dark/60 mt-2">Pilotez l'activité : finance, contenu, utilisateurs, sécurité.</span>
							</span>
						</a>
					{% endif %}

					<a href="{{ path('member_project_index') }}" class="group relative flex flex-col items-center text-center gap-4 rounded-2xl bg-white p-9 shadow-[0_20px_50px_-15px_rgba(3,4,94,0.45)] ring-1 ring-black/5 transition-all duration-300 ease-out hover:-translate-y-2 hover:shadow-[0_30px_60px_-15px_rgba(3,4,94,0.55)]">
						<span class="absolute inset-x-0 top-0 h-1.5 rounded-t-2xl bg-linear-to-r from-brand-primary to-brand-accent"></span>
						<span class="flex h-20 w-20 items-center justify-center rounded-2xl text-4xl text-white shadow-lg shadow-brand-primary/30 bg-linear-to-br from-brand-primary to-brand-accent transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3">
							<i class="ti ti-briefcase" aria-hidden="true"></i>
						</span>
						<span>
							<span class="flex items-center justify-center gap-1.5 font-heading font-bold text-xl">
								Espace Projets
								<i class="ti ti-arrow-right text-base opacity-0 -translate-x-1 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 text-brand-primary" aria-hidden="true"></i>
							</span>
							<span class="block text-sm text-brand-dark/60 mt-2">Suivez vos projets et échangez avec l'équipe.</span>
						</span>
					</a>

				</div>
			</div>
		</main>
	</body>
</html>
