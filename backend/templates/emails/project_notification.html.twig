{% extends 'emails/base_email.html.twig' %}

{% block title %}{{ heading }}{% endblock %}
{% block preheader %}{{ heading }} — {{ projectTitle }}{% endblock %}

{% block body %}
	<h1 style="margin:0 0 16px; font-size:19px; color:#03045e;">{{ heading }}</h1>

	<p style="margin:0 0 12px;">Bonjour <strong>{{ recipientName }}</strong>,</p>

	{% for line in lines %}
		<p style="margin:0 0 12px;">{{ line }}</p>
	{% endfor %}

	{% if actionUrl is defined and actionUrl %}
		<table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px 0 4px;">
			<tr>
				<td align="center" bgcolor="#0077b6" style="background-color:#0077b6; border-radius:6px;">
					<a href="{{ actionUrl }}" style="display:inline-block; padding:12px 24px; color:#ffffff; font-size:14px; font-weight:bold; text-decoration:none; font-family:Arial, Helvetica, sans-serif;">
						{{ actionLabel|default('Ouvrir le projet') }}
					</a>
				</td>
			</tr>
		</table>
	{% endif %}

	<p style="margin:20px 0 0; font-size:12px; color:#8b949e;">Projet : {{ projectTitle }}</p>
{% endblock %}
