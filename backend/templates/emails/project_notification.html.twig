{% extends 'emails/base_email.html.twig' %}

{% block body %}
	<div class="bg-white shadow-md rounded-lg p-6">
		<h1 class="text-2xl font-bold text-blue-900 mb-4">{{ heading }}</h1>

		<p class="text-gray-700 mb-2">Bonjour <span class="font-semibold">{{ recipientName }}</span>,</p>

		{% for line in lines %}
			<p class="text-gray-700 mb-2">{{ line }}</p>
		{% endfor %}

		{% if actionUrl is defined and actionUrl %}
			<p class="mt-6">
				<a href="{{ actionUrl }}" class="inline-block px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg">{{ actionLabel|default('Ouvrir le projet') }}</a>
			</p>
		{% endif %}

		<p class="mt-6 text-xs text-gray-400">Projet : {{ projectTitle }}</p>
	</div>
{% endblock %}
