{% extends 'emails/base_email.html.twig' %}

{% block title %}Erreur applicative — {{ statusCode }}{% endblock %}
{% block preheader %}Une erreur nécessitant votre attention vient de se produire.{% endblock %}

{% block body %}
	<h1 style="margin:0 0 16px; font-size:19px; color:#c22929;">🚨 Erreur applicative — {{ statusCode }}</h1>

	<p style="margin:0 0 16px;">Une erreur nécessitant votre attention vient de se produire sur la plateforme.</p>

	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f8fa; border:1px solid #d0d7de; border-radius:8px; margin:0 0 20px;">
		<tr>
			<td style="padding:14px 16px; font-size:13px;">
				<strong style="color:#c22929;">Classe :</strong> <code>{{ exceptionClass }}</code><br>
				<strong style="color:#c22929;">Message :</strong> {{ message }}<br>
				<strong style="color:#c22929;">Code HTTP :</strong> {{ statusCode }}<br>
				<strong style="color:#c22929;">Date :</strong> {{ date|date('d/m/Y H:i') }}
				{% if context is not empty %}
					<br><strong style="color:#c22929;">Contexte :</strong>
					<pre style="white-space:pre-wrap; font-size:12px; margin:4px 0 0;">{{ context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
				{% endif %}
			</td>
		</tr>
	</table>

	<p style="margin:0; font-size:13px; color:#57606a;">
		Cette alerte est limitée à un envoi par heure et par type d'erreur.
	</p>
{% endblock %}
