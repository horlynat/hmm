{% extends 'emails/base_email.html.twig' %}

{% block title %}Erreur applicative — {{ statusCode }}{% endblock %}
{% block preheader %}Une erreur nécessitant votre attention vient de se produire.{% endblock %}
{% block badge_label %}Alerte système{% endblock %}
{% block badge_color %}#fee2e2{% endblock %}
{% block badge_text_color %}#991b1b{% endblock %}

{% block body %}
	<h1 style="margin:0 0 16px; font-size:19px; color:#c22929;">🚨 Erreur applicative — {{ statusCode }}</h1>

	<p style="margin:0 0 16px;">Une erreur nécessitant votre attention vient de se produire sur la plateforme.</p>

	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f8fa; border:1px solid #d0d7de; border-radius:8px; margin:0 0 16px;">
		<tr>
			<td style="padding:14px 16px; font-size:13px;">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
					<tr>
						<td valign="top" width="110" style="padding:0 0 8px; color:#c22929; font-weight:bold; font-family:Arial, Helvetica, sans-serif;">Classe</td>
						<td valign="top" style="padding:0 0 8px; font-family:'Courier New', monospace;">{{ exceptionClass }}</td>
					</tr>
					<tr>
						<td valign="top" width="110" style="padding:0 0 8px; color:#c22929; font-weight:bold; font-family:Arial, Helvetica, sans-serif;">Message</td>
						<td valign="top" style="padding:0 0 8px;">{{ message }}</td>
					</tr>
					<tr>
						<td valign="top" width="110" style="padding:0 0 8px; color:#c22929; font-weight:bold; font-family:Arial, Helvetica, sans-serif;">Code HTTP</td>
						<td valign="top" style="padding:0 0 8px;">{{ statusCode }}</td>
					</tr>
					<tr>
						<td valign="top" width="110" style="padding:0; color:#c22929; font-weight:bold; font-family:Arial, Helvetica, sans-serif;">Date</td>
						<td valign="top" style="padding:0;">{{ date|date('d/m/Y H:i') }}</td>
					</tr>
				</table>
				{% if context is not empty %}
					<p style="margin:12px 0 4px; color:#c22929; font-weight:bold; font-family:Arial, Helvetica, sans-serif;">Contexte</p>
					<pre style="white-space:pre-wrap; word-break:break-word; font-size:12px; font-family:'Courier New', monospace; background-color:#ffffff; border:1px solid #d0d7de; border-radius:6px; padding:10px; margin:0;">{{ context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
				{% endif %}
			</td>
		</tr>
	</table>

	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fffbeb; border:1px solid #fde68a; border-radius:8px; margin:0 0 20px;">
		<tr>
			<td style="padding:12px 16px; font-size:13px; color:#92400e;">
				<strong>À vérifier en priorité :</strong> l'état de la base de données et des services externes (mail, stockage, fournisseur de taux de change), puis les logs applicatifs pour la trace complète de l'exception.
			</td>
		</tr>
	</table>

	<p style="margin:0; font-size:13px; color:#57606a;">
		Cette alerte est limitée à un envoi par heure et par type d'erreur — d'autres occurrences ont pu se produire entre-temps sans nouvel email.
	</p>
{% endblock %}
