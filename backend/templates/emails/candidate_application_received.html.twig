{% extends 'emails/base_email.html.twig' %}

{% block title %}Votre candidature a bien été reçue{% endblock %}
{% block preheader %}Nous avons bien reçu votre candidature freelance et l'examinons.{% endblock %}
{% block badge_label %}Candidature{% endblock %}
{% block badge_color %}#dcfce7{% endblock %}
{% block badge_text_color %}#166534{% endblock %}

{% block body %}
	<h1 style="margin:0 0 16px; font-size:20px; color:#03045e;">Candidature bien reçue</h1>

	<p style="margin:0 0 16px;">Bonjour <strong>{{ fullName }}</strong>,</p>
	<p style="margin:0 0 20px;">
		Nous avons bien reçu votre candidature freelance sur Horlynat | Portail Digital.
		Elle est actuellement <strong>en cours d'examen</strong> par notre équipe.
	</p>

	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f8fa; border:1px solid #d0d7de; border-radius:8px; margin:0 0 24px;">
		<tr>
			<td style="padding:14px 16px;">
				<p style="margin:0; font-size:14px; line-height:1.6;">
					Aucune action n'est requise de votre part pour l'instant. Nous reviendrons vers vous par email
					dès que votre candidature aura été étudiée — pensez à vérifier votre adresse email si ce n'est
					pas déjà fait, c'est ce qui nous permettra de vous recontacter.
				</p>
			</td>
		</tr>
	</table>

	<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 8px;">
		<tr>
			<td align="center" bgcolor="#0077b6" style="background-color:#0077b6; border-radius:6px;">
				<a href="{{ accountUrl }}" style="display:inline-block; padding:14px 28px; color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none; font-family:Arial, Helvetica, sans-serif;">
					Accéder à mon espace
				</a>
			</td>
		</tr>
	</table>
{% endblock %}
