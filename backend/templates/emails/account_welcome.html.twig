{% extends 'emails/base_email.html.twig' %}

{% block title %}Votre compte a été créé{% endblock %}
{% block preheader %}Un compte {{ roleLabel }} vient d'être créé pour vous sur Horlynat | Portail Digital.{% endblock %}
{% block badge_label %}Compte{% endblock %}
{% block badge_color %}#dbeafe{% endblock %}
{% block badge_text_color %}#1e40af{% endblock %}

{% block body %}
	<h1 style="margin:0 0 16px; font-size:20px; color:#03045e;">Bienvenue, {{ fullName }}</h1>

	<p style="margin:0 0 20px;">
		Un compte <strong>{{ roleLabel }}</strong> vient d'être créé pour vous sur Horlynat | Portail Digital, associé à cette adresse email. Vous pouvez dès maintenant accéder à votre espace.
	</p>

	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f8fa; border:1px solid #d0d7de; border-radius:8px; margin:0 0 24px;">
		<tr>
			<td style="padding:16px 18px;">
				<p style="margin:0 0 10px; font-size:12px; font-weight:bold; text-transform:uppercase; letter-spacing:0.04em; color:#57606a;">Pour démarrer</p>
				<table role="presentation" cellpadding="0" cellspacing="0">
					<tr>
						<td valign="top" style="padding:0 8px 8px 0; color:#0077b6; font-weight:bold; font-size:14px;">1.</td>
						<td valign="top" style="padding:0 0 8px; font-size:14px;">Connectez-vous avec le bouton ci-dessous.</td>
					</tr>
					<tr>
						<td valign="top" style="padding:0 8px 8px 0; color:#0077b6; font-weight:bold; font-size:14px;">2.</td>
						<td valign="top" style="padding:0 0 8px; font-size:14px;">Première connexion : utilisez « Mot de passe oublié ? » sur la page de connexion pour définir votre mot de passe.</td>
					</tr>
					<tr>
						<td valign="top" style="padding:0 8px 0 0; color:#0077b6; font-weight:bold; font-size:14px;">3.</td>
						<td valign="top" style="padding:0; font-size:14px;">Complétez votre profil depuis votre espace.</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>

	<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 8px;">
		<tr>
			<td align="center" bgcolor="#0077b6" style="background-color:#0077b6; border-radius:6px;">
				<a href="{{ loginUrl }}" style="display:inline-block; padding:14px 28px; color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none; font-family:Arial, Helvetica, sans-serif;">
					Se connecter
				</a>
			</td>
		</tr>
	</table>
{% endblock %}
