{% extends 'emails/base_email.html.twig' %}

{% block title %}Votre compte a été créé{% endblock %}
{% block preheader %}Un compte vient d'être créé pour vous.{% endblock %}

{% block body %}
	<p style="margin:0 0 16px;">Bonjour <strong>{{ fullName }}</strong>,</p>
	<p style="margin:0 0 24px;">
		Un compte {{ roleLabel }} vient d'être créé pour vous sur Horlynat | Portail Digital, associé à cette adresse email.
	</p>

	<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 24px;">
		<tr>
			<td align="center" bgcolor="#0077b6" style="background-color:#0077b6; border-radius:6px;">
				<a href="{{ loginUrl }}" style="display:inline-block; padding:14px 28px; color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none; font-family:Arial, Helvetica, sans-serif;">
					Se connecter
				</a>
			</td>
		</tr>
	</table>

	<p style="margin:0; font-size:13px; color:#57606a;">
		Si vous ne connaissez pas votre mot de passe, utilisez « Mot de passe oublié ? » sur la page de connexion pour en choisir un.
	</p>
{% endblock %}
