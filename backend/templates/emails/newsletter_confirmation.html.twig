{% extends 'emails/base_email.html.twig' %}

{% set isEn = 'en' == locale %}

{% block title %}{{ isEn ? 'Confirm your newsletter subscription' : 'Confirmez votre inscription à la newsletter' }}{% endblock %}
{% block preheader %}{{ isEn ? 'One last click to receive upcoming articles and projects.' : 'Un dernier clic pour recevoir les prochains articles et projets.' }}{% endblock %}
{% block badge_label %}Newsletter{% endblock %}
{% block badge_color %}#e0e7ff{% endblock %}
{% block badge_text_color %}#3730a3{% endblock %}

{% block body %}
	<h1 style="margin:0 0 16px; font-size:20px; color:#03045e;">{{ isEn ? 'Confirm your subscription' : 'Confirmez votre inscription' }}</h1>

	<p style="margin:0 0 16px;">{{ isEn ? 'Hello,' : 'Bonjour,' }}</p>
	<p style="margin:0 0 24px;">
		{% if isEn %}
			You just subscribed to Horlynat's blog newsletter. One step remains before receiving upcoming articles and projects: confirming that this address really belongs to you.
		{% else %}
			Vous venez de vous inscrire à la newsletter du blog d'Horlynat. Il ne reste qu'une étape avant de recevoir les prochains articles et projets : confirmer que cette adresse vous appartient bien.
		{% endif %}
	</p>

	<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 24px;">
		<tr>
			<td align="center" bgcolor="#0077b6" style="background-color:#0077b6; border-radius:6px;">
				<a href="{{ confirmUrl }}" style="display:inline-block; padding:14px 28px; color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none; font-family:Arial, Helvetica, sans-serif;">
					{{ isEn ? 'Confirm my subscription' : 'Confirmer mon inscription' }}
				</a>
			</td>
		</tr>
	</table>

	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f8fa; border:1px solid #d0d7de; border-radius:8px; margin:0 0 20px;">
		<tr>
			<td style="padding:14px 16px; font-size:13px; color:#57606a; line-height:1.6;">
				<strong style="color:#03045e;">⏳ {{ isEn ? 'This link expires in 7 days' : 'Ce lien expire dans 7 jours' }}</strong><br>
				{{ isEn ? "If you didn't request this subscription, simply ignore this email — without confirmation, nothing will be sent to this address." : "Si vous n'êtes pas à l'origine de cette inscription, ignorez simplement cet email — sans confirmation, aucun envoi ne sera fait à cette adresse." }}
			</td>
		</tr>
	</table>

	<p style="margin:0; font-size:12px; color:#8b949e;">
		{{ isEn ? "Don't want any emails at all, even this one? " : 'Vous ne souhaitez plus recevoir d\'e-mails, même celui-ci ? ' }}
		<a href="{{ unsubscribeUrl }}" style="color:#57606a;">{{ isEn ? "Don't contact me" : 'Ne plus me contacter' }}</a>.
	</p>
{% endblock %}
