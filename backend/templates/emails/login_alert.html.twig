{% extends 'emails/base_email.html.twig' %}

{% block title %}Nouvelle connexion détectée{% endblock %}
{% block preheader %}Une connexion a été effectuée depuis une nouvelle source.{% endblock %}

{% block body %}
	<h1 style="margin:0 0 16px; font-size:19px; color:#03045e;">⚠️ Alerte de sécurité</h1>

	<p style="margin:0 0 8px;">Bonjour <strong>{{ fullName }}</strong>,</p>
	<p style="margin:0 0 16px;">Une connexion a été effectuée depuis une nouvelle source :</p>

	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f8fa; border:1px solid #d0d7de; border-radius:8px; margin:0 0 20px;">
		<tr>
			<td style="padding:14px 16px; font-size:14px; line-height:1.7;">
				<strong style="color:#03045e;">Adresse IP :</strong> {{ ip }}<br>

				<strong style="color:#03045e;">Appareil :</strong>
				{{ device.type }}{% if device.brand %} — {{ device.brand }}{% endif %}
				{% if device.browser or device.os %}
					<span style="color:#57606a;">({{ device.browser }}{% if device.browser and device.os %}, {% endif %}{{ device.os }})</span>
				{% endif %}<br>

				<strong style="color:#03045e;">Localisation :</strong>
				{{ location.city ?? 'Ville inconnue' }}, {{ location.country_name ?? 'Pays inconnu' }}
				{% if location.latitude and location.longitude %}
					<br><strong style="color:#03045e;">Coordonnées :</strong>
					<a href="https://www.google.com/maps?q={{ location.latitude }},{{ location.longitude }}" style="color:#0353a4;" target="_blank" rel="noopener noreferrer">{{ location.latitude }}, {{ location.longitude }}</a>
				{% endif %}<br>

				<strong style="color:#03045e;">Date :</strong> {{ date|date('d/m/Y à H:i') }}
			</td>
		</tr>
	</table>

	<p style="margin:0;">
		Si ce n'est pas vous, <strong style="color:#c22929;">changez immédiatement votre mot de passe</strong>.
	</p>
{% endblock %}
