{% extends 'emails/base_email.html.twig' %}

{% block title %}Réinitialisation de votre mot de passe{% endblock %}
{% block preheader %}Choisissez un nouveau mot de passe pour votre compte.{% endblock %}
{% block badge_label %}Sécurité{% endblock %}
{% block badge_color %}#fef3c7{% endblock %}
{% block badge_text_color %}#92400e{% endblock %}

{% block body %}
	<h1 style="margin:0 0 16px; font-size:20px; color:#03045e;">Réinitialisation du mot de passe</h1>

	<p style="margin:0 0 16px;">Bonjour <strong>{{ fullName }}</strong>,</p>
	<p style="margin:0 0 24px;">
		Vous avez demandé la réinitialisation du mot de passe de votre compte. Cliquez sur le bouton ci-dessous pour en choisir un nouveau :
	</p>

	<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 24px;">
		<tr>
			<td align="center" bgcolor="#0077b6" style="background-color:#0077b6; border-radius:6px;">
				<a href="{{ resetUrl }}" style="display:inline-block; padding:14px 28px; color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none; font-family:Arial, Helvetica, sans-serif;">
					Choisir un nouveau mot de passe
				</a>
			</td>
		</tr>
	</table>

	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f8fa; border:1px solid #d0d7de; border-radius:8px;">
		<tr>
			<td style="padding:14px 16px; font-size:13px; color:#57606a; line-height:1.6;">
				<strong style="color:#03045e;">⏳ Ce lien expire dans 1 heure</strong>, ou dès qu'il aura été utilisé une fois. Il est personnel : ne le partagez avec personne.<br><br>
				Vous n'êtes pas à l'origine de cette demande ? Ignorez simplement cet email : votre mot de passe actuel reste inchangé et aucune action supplémentaire n'est nécessaire de votre part.
			</td>
		</tr>
	</table>
{% endblock %}
