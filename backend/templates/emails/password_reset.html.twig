{% extends 'emails/base_email.html.twig' %}

{% block title %}Réinitialisation de votre mot de passe{% endblock %}
{% block preheader %}Choisissez un nouveau mot de passe pour votre compte.{% endblock %}

{% block body %}
	<p style="margin:0 0 16px;">Bonjour <strong>{{ fullName }}</strong>,</p>
	<p style="margin:0 0 24px;">
		Vous avez demandé la réinitialisation du mot de passe de votre compte. Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe :
	</p>

	<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 24px;">
		<tr>
			<td align="center" bgcolor="#0077b6" style="background-color:#0077b6; border-radius:6px;">
				<a href="{{ resetUrl }}" style="display:inline-block; padding:14px 28px; color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none; font-family:Arial, Helvetica, sans-serif;">
					Choisir un nouveau mot de passe
				</a>
			</td>
		</tr>
	</table>

	<p style="margin:0 0 8px; font-size:13px; color:#57606a;">
		Ce lien est personnel et expire dans 1 heure, ou dès qu'il aura été utilisé une fois. Ne le partagez avec personne.
	</p>
	<p style="margin:0; font-size:13px; color:#57606a;">
		Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet email : votre mot de passe actuel reste inchangé.
	</p>
{% endblock %}
