<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<title>{% block title %}Horlynat | Portail Digital{% endblock %}</title>
	</head>
	<body style="margin:0; padding:0; background-color:#f4f6fa; font-family:Arial, Helvetica, sans-serif;">
		{# Texte d'aperçu (pré-header) : visible dans la liste des emails, invisible une fois ouvert. #}
		<div style="display:none; max-height:0; overflow:hidden; opacity:0;">
			{% block preheader %}{% endblock %}
		</div>

		{# Déclaration "silencieuse" des 3 blocs de catégorie, dans un conteneur
		   masqué comme le pré-header ci-dessus : une balise {% block %} affiche
		   TOUJOURS son contenu résolu à sa propre position, y compris quand un
		   template enfant le redéfinit — la déclarer en dehors de tout conteneur
		   masqué ferait fuiter "Sécurité" / "#fef3c7" en texte visible en haut de
		   l'email dès qu'un enfant définit une vraie valeur. Les usages réels plus
		   bas passent uniquement par la fonction block(), qui lit la valeur sans
		   la re-afficher ici. #}
		<div style="display:none; max-height:0; overflow:hidden; opacity:0;">
			{% block badge_label %}{% endblock %}
			{% block badge_color %}{% endblock %}
			{% block badge_text_color %}{% endblock %}
		</div>

		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6fa;">
			<tr>
				<td align="center" style="padding:32px 16px;">
					<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #d0d7de;">

						<!-- Header -->
						<tr>
							<td align="center" bgcolor="#03045e" style="background-color:#03045e; background-image:linear-gradient(135deg, #03045e, #0077b6); padding:28px 24px;">
								<table role="presentation" cellpadding="0" cellspacing="0">
									<tr>
										<td valign="middle" style="padding-right:10px;">
											{# Monogramme "H" réel de la marque (identique au favicon du portfolio,
											   frontend/src/app/icon.svg) — encodé en data URI pour ne dépendre
											   d'aucun domaine ni d'un chargement d'image externe. #}
											<img src="data:image/svg+xml;base64,"
												width="36" height="36" alt="H" style="display:block; border-radius:6px;">
										</td>
										<td valign="middle">
											<span style="color:#ffffff; font-size:16px; font-weight:bold; font-family:Arial, Helvetica, sans-serif;">Horlynat</span>
											<span style="color:#caf0f8; font-size:16px; font-family:Arial, Helvetica, sans-serif;"> | Portail Digital</span>
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<!-- Bandeau de catégorie : distingue le type d'email au premier coup d'œil (sécurité, facturation, projet...), rempli par chaque template enfant via les blocs badge_*. -->
						{% set badgeLabel = block('badge_label')|trim %}
						{% if badgeLabel is not empty %}
							<tr>
								<td style="padding:18px 28px 0; background-color:#ffffff;">
									<span style="display:inline-block; padding:5px 12px; background-color:{{ block('badge_color')|default('#e7f0fe', true) }}; border-radius:20px; font-family:Arial, Helvetica, sans-serif; font-size:11px; font-weight:bold; letter-spacing:0.05em; text-transform:uppercase; color:{{ block('badge_text_color')|default('#0353a4', true) }};">{{ badgeLabel }}</span>
								</td>
							</tr>
						{% endif %}

						<!-- Content -->
						<tr>
							<td style="padding:24px 28px 32px; color:#0b0e14; font-size:15px; line-height:1.6; font-family:Arial, Helvetica, sans-serif;">
								{% block body %}{% endblock %}
							</td>
						</tr>

						<!-- Footer -->
						<tr>
							<td align="center" style="padding:20px 24px; background-color:#f6f8fa; border-top:1px solid #d0d7de;">
								<p style="margin:0 0 4px; color:#57606a; font-size:12px; font-family:Arial, Helvetica, sans-serif;">
									Cet email a été envoyé par
									<a href="https://horlynat.com" style="color:#0077b6; text-decoration:none;">Horlynat | Portail Digital</a>.
								</p>
								<p style="margin:0; color:#8b949e; font-size:12px; font-family:Arial, Helvetica, sans-serif;">
									Brazzaville, République du Congo · Cet email ne provient pas d'une boîte surveillée, merci de ne pas y répondre directement.
								</p>
							</td>
						</tr>

					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
